<Project>
  <!--
    Repo-wide MSBuild defaults. Applied to every csproj automatically.

    ▸ EnableDefaultEmbeddedResourceItems=false
      Disables the SDK's implicit `<EmbeddedResource Include="**/*.resx" />`.
      The implicit glob has a regression in .NET SDK 10.0.2xx (feature band 2)
      where it emits the literal `**/*.resx` as a filename, causing MSB3552.
      None of our projects use .resx files; if one ever does, add an explicit
      <EmbeddedResource> item to that project's csproj.
  -->
  <PropertyGroup>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
</Project>

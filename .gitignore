# .NET build output
**/bin/
**/obj/
# Literal-backslash directories created by Windows tooling on case-insensitive
# filesystems (e.g. bin\Debug as a single-component name). These DO get
# created occasionally and must never be committed — they break the SDK's
# default item globs on Linux CI.
**/bin\\*/
**/obj\\*/
*.user
*.suo

# Data files
CRV.Web/Data/

# Runtime data / secrets
appsettings.Development.json
schwab_tokens.json
tradestation_tokens.json
tradovate_tokens.json
live_settings.json
*.db
*.db-shm
*.db-wal
*.sqlite
orb_cache.json
sessions.json

# Rider / VS
.idea/
.vs/
*.DotSettings.user

# macOS
.DS_Store
.worktrees/

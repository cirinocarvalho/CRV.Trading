@page "/options/explorer"
@model CRV.Web.Pages.Options.ExplorerModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Options";
    ViewData["Page"] = "options-explorer";
    ViewData["Section"] = "options";
    ViewData["LightReady"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="c-head">
    <h1>Options</h1>
    <span class="c-sub">Pick a contract, build a structure, then order it</span>
    <div class="c-acts">
        <span id="underlying-badge" class="c-badge info d-none"></span>
        @if (Model.LiveOrdersEnabled)
        {
            <span class="c-badge bad"><i class="bi bi-broadcast"></i>LIVE@(Model.MaxTradeRisk > 0m ? $" · up to {Model.MaxTradeRisk:C0} a trade" : "")</span>
        }
        else
        {
            <span class="c-badge"><i class="bi bi-eye"></i>Preview only</span>
        }
    </div>
</div>

@if (Model.LiveOrdersEnabled)
{
    <div class="c-note bad mb-3"><i class="bi bi-broadcast"></i>
        <span><strong>Live.</strong> An order you hold to place in the confirmation is sent to Schwab for execution.</span></div>
}
else
{
    <div class="c-note mb-3"><i class="bi bi-eye"></i>
        <span><strong>Preview only.</strong> Structures can be priced and previewed. Placing orders is switched off (<code>Options:AllowLiveOrders</code>).</span></div>
}
@if (!Model.SchwabAuthenticated)
{
    <div class="c-note warn mb-3"><i class="bi bi-exclamation-triangle"></i>
        <span>Schwab isn't connected, so there is no chain to load. <a href="/setup/brokers">Connect it on Brokers</a>.</span></div>
}

<div id="err" class="c-note bad mb-3 d-none" role="alert"></div>

@* Phone: one step at a time. Desktop shows them side by side. *@
<nav class="ox-tabs" role="tablist" aria-label="Steps">
    <button type="button" role="tab" data-step="pick" aria-selected="true"><b>1</b> Pick</button>
    <button type="button" role="tab" data-step="build" aria-selected="false"><b>2</b> Build <span class="c-badge info d-none" id="ox-legcount"></span></button>
    <button type="button" role="tab" data-step="order" aria-selected="false"><b>3</b> Order</button>
</nav>

<div class="ox-grid">
<div class="ox-main">

<section class="c-panel ox-step" data-step="pick">
    <div class="c-panel-h"><h2><span class="ox-n">1</span>Pick</h2><span id="status" class="c-right"></span></div>
    <div class="c-panel-b d-grid gap-3">
        <div class="ox-row">
            <div class="ox-field">
                <label class="form-label" for="f-symbol">Underlying</label>
                <div class="d-flex gap-2">
                    <input id="f-symbol" class="form-control text-uppercase" style="width:9rem" value="SPY" autocomplete="off" list="symbol-suggestions"/>
                    <datalist id="symbol-suggestions">
                        <option value="SPY"></option>
                        <option value="QQQ"></option>
                        <option value="IWM"></option>
                        <option value="$SPX" label="S&amp;P 500 index — European, cash settled"></option>
                        <option value="$NDX" label="Nasdaq 100 index — European, cash settled"></option>
                        <option value="$RUT" label="Russell 2000 index — European, cash settled"></option>
                    </datalist>
                    <button id="btn-load" class="btn btn-warning" onclick="loadExpirations()"><i class="bi bi-search me-1"></i>Load</button>
                </div>
            </div>
            <div class="ox-field">
                <label class="form-label" for="f-expiry">Expiry</label>
                <select id="f-expiry" class="form-select" style="min-width:12rem" onchange="loadChain()" disabled></select>
            </div>
            <div class="ox-field">
                <label class="form-label" for="f-strikes">Strikes</label>
                <select id="f-strikes" class="form-select" onchange="loadChain()">
                    <option value="20">20</option>
                    <option value="40" selected>40</option>
                    <option value="80">80</option>
                    <option value="200">200</option>
                </select>
            </div>
        </div>
        <div class="ox-facts">
            <div id="expected-move" class="small"></div>
            <div id="iv-standing" class="small"></div>
        </div>

        <div>
            <div class="ox-row">
                <div class="ox-field">
                    <label class="form-label" for="f-target">I expect the price to reach</label>
                    <input id="f-target" type="number" step="0.01" min="0" class="form-control num" style="width:9rem"
                           placeholder="price" onkeydown="if(event.key==='Enter')suggest()">
                    <div id="t-target-hint" class="form-text"></div>
                </div>
                <div class="ox-field ox-btns">
                    <button id="btn-suggest" class="btn btn-outline-secondary" onclick="suggest()"><i class="bi bi-list-stars me-1"></i>Find structures</button>
                    <button class="btn btn-link c-mut" onclick="clearSuggestions()">Clear</button>
                </div>
            </div>
    <div id="suggest-wrap" class="table-responsive c-table-wrap mt-2 d-none">
        <table class="table table-sm table-hover align-middle mb-1">
            <thead>
            <tr class="small text-secondary">
                <th>Structure</th>
                <th class="text-end">Cost</th>
                <th class="text-end">Max loss</th>
                <th class="text-end" id="th-lo"></th>
                <th class="text-end" id="th-mid"></th>
                <th class="text-end" id="th-hi"></th>
                <th class="text-end">R/R</th>
                <th class="text-end">Worst spread</th>
                <th></th>
            </tr>
            </thead>
            <tbody id="suggest-body"></tbody>
        </table>
        <div class="small text-secondary">
            <div>
                <i class="bi bi-info-circle me-1"></i>
                Ranked by profit at your target &mdash; which always flatters structures that only
                pay at a precise price. The columns either side show whether a candidate wins
                narrowly or across a range. Nothing here is a recommendation.
            </div>
            @* Without this the price columns read as "if it gets there", which is the wrong
               question for anything held less than to settlement. *@
            <div class="mt-1">
                <i class="bi bi-exclamation-triangle me-1 text-warning"></i>
                The three price columns are values <span class="lbl-exp">at expiry</span> &mdash;
                what each structure is worth if the underlying <em>settles</em> there. If it
                reaches your target earlier the result differs, often a lot, because time value
                remains. <strong>Cost</strong> and <strong>Max loss</strong> are what you commit today.
            </div>
        </div>
    </div>
        </div>
    </div>
</section>

<section class="c-panel ox-step" data-step="pick">
    <div class="c-panel-h"><h2>Chain</h2><span class="c-right">Tap + to add a leg</span></div>
    <div class="c-panel-b">
        <details class="rk-more mb-2">
            <summary>Filters and commission</summary>
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label for="f-right" class="form-label small">Right</label>
            <select id="f-right" class="form-select form-select-sm" onchange="render()">
                <option value="">Both</option>
                <option value="Call">Calls</option>
                <option value="Put">Puts</option>
            </select>
        </div>
        <div class="col-auto">
            <label for="f-askmin" class="form-label small">Ask min</label>
            <input id="f-askmin" type="number" step="0.01" min="0" class="form-control form-control-sm"
                   style="width:100px" oninput="render()"/>
        </div>
        <div class="col-auto">
            <label for="f-askmax" class="form-label small">Ask max</label>
            <input id="f-askmax" type="number" step="0.01" min="0" class="form-control form-control-sm"
                   style="width:100px" oninput="render()"/>
        </div>
        <div class="col-auto">
            <label for="f-deltamin" class="form-label small">|Delta| min</label>
            <input id="f-deltamin" type="number" step="0.01" min="0" max="1" class="form-control form-control-sm"
                   style="width:100px" oninput="render()"/>
        </div>
        <div class="col-auto">
            <label for="f-spread" class="form-label small">Max spread %</label>
            <input id="f-spread" type="number" step="0.5" min="0" value="10" class="form-control form-control-sm"
                   style="width:110px" oninput="render()"/>
        </div>
        <div class="col-auto">
            <label for="f-oi" class="form-label small">Min OI</label>
            <input id="f-oi" type="number" step="1" min="0" value="0" class="form-control form-control-sm"
                   style="width:100px" oninput="render()"/>
        </div>
        <div class="col-auto">
            <label for="f-comm" class="form-label small">Commission /ct</label>
            <input id="f-comm" type="number" step="0.01" min="0" value="0.65" class="form-control form-control-sm"
                   style="width:120px" oninput="onCommissionChanged()"/>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input id="f-tradeable" class="form-check-input" type="checkbox" checked onchange="render()">
                <label class="form-check-label small" for="f-tradeable">Tradeable only</label>
            </div>
        </div>
        <div class="col-auto">
            <button class="btn btn-sm btn-outline-secondary" onclick="resetFilters()">Reset</button>
        </div>
    </div>
    <div class="small text-secondary mt-2">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Tradeable</strong> = has a bid and spread within the limit. Open interest is
        shown but is a weak filter on its own &mdash; contracts quoted at $0.01 routinely carry
        OI in the thousands with no bid at all.
    </div>
        </details>
<div class="table-responsive c-table-wrap ox-chain">
    <table class="table table-sm table-hover align-middle">
        <thead>
        <tr class="small text-secondary">
            <th>Right</th>
            <th class="text-end">Strike</th>
            <th class="text-end">Bid</th>
            <th class="text-end">Ask</th>
            <th class="text-end">Mid</th>
            <th class="text-end">Spread %</th>
            <th class="text-end">Delta</th>
            <th class="text-end">Theta</th>
            <th class="text-end">IV</th>
            <th class="text-end">Vol</th>
            <th class="text-end">OI</th>
            <th class="text-end">Extrinsic</th>
            <th class="text-end">Comm %</th>
            <th></th>
            <th class="text-center">Add</th>
        </tr>
        </thead>
        <tbody id="chain-body">
        <tr>
            <td colspan="15" class="text-center text-secondary py-4">
                Enter an underlying and press Load.
            </td>
        </tr>
        </tbody>
    </table>
</div>
    </div>
</section>

</div>
<aside class="ox-side">

<div id="ox-empty" class="c-panel ox-step" data-step="build">
    <div class="c-empty"><i class="bi bi-layers"></i><b>No structure yet</b><span>Add legs from the chain, or use a structure from "Find structures".</span></div>
</div>

<div id="panel-b" class="d-none d-grid gap-3">
<section class="c-panel ox-step" data-step="build">
    <div class="c-panel-h">
        <h2><span class="ox-n">2</span>Build <span id="struct-name" class="c-badge ms-1"></span></h2>
        <div class="d-flex gap-1">
            <button class="btn btn-sm btn-outline-secondary" onclick="reQuoteAndAnalyse()" title="Re-quote every leg through the broker" aria-label="Re-quote"><i class="bi bi-arrow-clockwise"></i></button>
            <button class="btn btn-sm btn-outline-secondary" onclick="clearLegs()">Clear</button>
        </div>
    </div>
    <div class="c-panel-b">
            <table class="table table-sm mb-2">
                <thead>
                <tr class="small text-secondary">
                    <th></th>
                    <th>Leg</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Price</th>
                    <th></th>
                </tr>
                </thead>
                <tbody id="legs-body"></tbody>
            </table>

            <div class="row g-2" id="analytics">
                <div class="col-6 col-xl-3">
                    <div class="small text-secondary">Net <span class="lbl-now">now</span></div>
                    <div id="a-net" class="fs-6 fw-bold">—</div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="small text-secondary">Max loss <span class="lbl-exp">at expiry</span></div>
                    <div id="a-loss" class="fs-6 fw-bold text-danger">—</div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="small text-secondary">Max profit <span class="lbl-exp">at expiry</span></div>
                    <div id="a-profit" class="fs-6 fw-bold text-success">—</div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="small text-secondary">Breakeven <span class="lbl-exp">at expiry</span></div>
                    <div id="a-be" class="fs-6 fw-bold">—</div>
                </div>
            </div>

            <hr class="my-3">
            <div class="row g-2 align-items-start ticket-row">
                <div class="col-auto">
                    <div class="tk-label">If price reaches</div>
                    <input id="wi-price" type="number" step="0.01" class="form-control form-control-sm"
                           style="width:110px" oninput="whatIf()">
                    <div class="tk-hint"></div>
                </div>
                <div class="col-auto">
                    <div class="tk-label">On</div>
                    <input id="wi-date" type="date" class="form-control form-control-sm"
                           style="width:150px" oninput="whatIf()">
                    <div class="tk-hint" id="wi-dte"></div>
                </div>
                <div class="col-auto">
                    <div class="tk-label">IV shift</div>
                    <input id="wi-iv" type="number" step="1" value="0" class="form-control form-control-sm"
                           style="width:90px" oninput="whatIf()">
                    <div class="tk-hint">vol points</div>
                </div>
                <div class="col-auto">
                    <div class="tk-label">P&amp;L <span class="lbl-now">then</span></div>
                    <div id="wi-value" class="tk-value fs-5 fw-bold">&mdash;</div>
                    <div class="tk-hint" id="wi-range"></div>
                </div>
                <div class="col-auto">
                    <div class="tk-label">Same price <span class="lbl-exp">at expiry</span></div>
                    <div id="wi-expiry" class="tk-value fw-bold text-secondary">&mdash;</div>
                    <div class="tk-hint"></div>
                </div>
            </div>

            @* The figures above are settlement values. Saying so once, plainly, is the
               difference between a number that informs a decision and one that misleads it. *@
            <div class="small text-secondary mt-2">
                <i class="bi bi-info-circle me-1"></i>
                Marked <span class="lbl-exp">at expiry</span> means the value if the underlying
                <em>settles</em> there on <span id="exp-note" class="text-info">the expiry date</span>.
                Reaching that price sooner pays differently &mdash; the contract still holds time
                value. Only <strong>Net</strong> is a price you can transact at right now.
            </div>
        <div class="small c-mut mt-3 mb-1">Payoff <span class="lbl-exp">at expiry</span></div>
        <svg id="payoff" viewBox="0 0 520 240" style="width:100%; height:240px;"></svg>
    </div>
</section>

<section class="c-panel ox-step" data-step="order">
    <div class="c-panel-h"><h2><span class="ox-n">3</span>Order</h2></div>
    <div class="c-panel-b">
    <div class="row g-2 align-items-start ticket-row">
        <div class="col-auto">
            <div class="tk-label">Spreads</div>
            <input id="f-spreads" type="number" min="1" step="1" value="1"
                   class="form-control form-control-sm" style="width:90px" oninput="onSpreadsChanged()">
            <div class="tk-hint"></div>
        </div>
        <div class="col-auto">
            <div class="tk-label">Duration</div>
            <select id="f-duration" class="form-select form-select-sm" style="width:150px">
                <option value="Day" selected>Day</option>
                <option value="GoodTillCancel">GTC</option>
                <option value="FillOrKill">Fill or kill</option>
            </select>
            <div class="tk-hint"></div>
        </div>
        <div class="col-auto">
            <div class="tk-label">Limit <span class="text-secondary">(net/unit)</span></div>
            <input id="f-limit" type="number" step="0.01" class="form-control form-control-sm"
                   style="width:120px" placeholder="market" oninput="onLimitChanged()">
            <div id="t-limit-hint" class="tk-hint"></div>
        </div>
        <div class="col-auto">
            <div class="tk-label">Exit at <span class="text-secondary">(net/unit)</span></div>
            <input id="f-exit" type="number" step="0.01" min="0" class="form-control form-control-sm"
                   style="width:120px" placeholder="none" oninput="renderTicket()">
            <div class="tk-hint">sent when the entry fills</div>
        </div>
        <div class="col-auto">
            <div class="tk-label">Stop at <span class="text-secondary">(contract)</span></div>
            <input id="f-stop" type="number" step="0.01" min="0" class="form-control form-control-sm"
                   style="width:120px" placeholder="none" oninput="renderTicket()">
            <div class="tk-hint" id="t-stop-hint">single leg only</div>
        </div>
        <div class="col-auto">
            <div class="tk-label">Order type</div>
            <div class="tk-value fw-bold" id="t-ordertype">&mdash;</div>
            <div class="tk-hint">never market</div>
        </div>
        <div class="col-auto">
            <div class="tk-label">Contracts</div>
            <div class="tk-value fw-bold" id="t-contracts">&mdash;</div>
            <div class="tk-hint"></div>
        </div>
        <div class="col-auto ms-auto text-end">
            <div class="tk-label">If the exit fills</div>
            <div class="tk-value fs-5 fw-bold text-success" id="t-target">&mdash;</div>
            <div class="tk-hint"></div>
        </div>
        <div class="col-auto text-end">
            <div class="tk-label">TOTAL max loss</div>
            <div class="tk-value fs-4 fw-bold text-danger" id="t-maxloss">&mdash;</div>
            <div class="tk-hint"></div>
        </div>
        <div class="col-auto">
            <div class="tk-label"></div>
            <button id="btn-preview" class="btn btn-warning" onclick="previewOrder()">
                <i class="bi bi-eye me-1"></i>Preview
            </button>
            <div class="tk-hint"></div>
        </div>
    </div>
    <div class="small text-secondary mt-2">
        Preview asks Schwab to validate and cost the order. Nothing is submitted until you
        confirm in the dialog that follows.
    </div>
    </div>
</section>
</div>

</aside>
</div>

@* Phone, Pick step: what's in the structure so far, and the way to it. *@
<div id="ox-legbar" class="ox-legbar" role="status" aria-live="polite">
    <span id="ox-legbar-text"></span>
    <button type="button" class="btn btn-sm btn-warning" onclick="showStep('build'); window.scrollTo({top: 0});">Review <i class="bi bi-chevron-right"></i></button>
</div>



<!-- ── Commit dialog ─────────────────────────────────────────── -->
<div class="modal fade" id="confirm-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-shield-check me-2"></i>Confirm order</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="m-mode" class="alert py-2 mb-3"></div>
                <table class="table table-sm">
                    <thead>
                    <tr class="small text-secondary">
                        <th>Instruction</th>
                        <th>Contract</th>
                        <th class="text-end">Qty</th>
                    </tr>
                    </thead>
                    <tbody id="m-legs"></tbody>
                </table>
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="small text-secondary">Net</div>
                        <div id="m-net" class="fw-bold"></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-secondary">Max loss <span class="lbl-exp">at expiry</span></div>
                        <div id="m-loss" class="fw-bold text-danger"></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-secondary">Max profit <span class="lbl-exp">at expiry</span></div>
                        <div id="m-profit" class="fw-bold text-success"></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-secondary">Breakeven <span class="lbl-exp">at expiry</span></div>
                        <div id="m-be" class="fw-bold"></div>
                    </div>
                </div>
                <div id="m-broker" class="small"></div>
                <div id="m-stale" class="alert alert-warning py-2 mt-3 d-none">
                    Quote is stale &mdash; close this and preview again.
                </div>
            </div>
            <div class="modal-footer">
                <span id="m-age" class="small text-secondary me-auto"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btn-place" class="c-hold"><i></i><span id="btn-place-label">Hold to place</span></button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const TOKEN = '@Html.Raw(Antiforgery.GetAndStoreTokens(HttpContext).RequestToken)';
        let ROWS = [], LEGS = [], UNDERLYING = 0;
        // Monotonic id for analyse requests. Adding legs quickly fires several POSTs and the
        // responses can land out of order — without this guard a stale reply overwrites the
        // current structure's numbers, which is exactly the kind of wrong max-loss a trader
        // would act on.
        let ANALYSIS_SEQ = 0;
        let LAST_ANALYSIS = null;      // per-spread figures from the most recent analyse
        let PREVIEW = null;            // server response backing the open dialog
        let PREVIEW_AT = 0;            // when that preview was taken
        let AGE_TIMER = null;
        const STALE_AFTER_MS = 30000;  // a quote older than this may no longer be the market
        const DRAFT_KEY = 'crv.options.draft';
        const LIVE_ENABLED = @(Model.LiveOrdersEnabled ? "true" : "false");

        const $ = id => document.getElementById(id);

        // ── The confirm dialog's send button: press-and-hold, so a stray tap can't send a live
        // order. One button serves both the opening order and a close; CONFIRM_ACTION says which.
        let CONFIRM_ACTION = null;
        const STALE_HTML = $('m-stale').innerHTML;
        CRV.hold($('btn-place'), () => { if (CONFIRM_ACTION) CONFIRM_ACTION(); });
        // Reset before a dialog fills in, so a "blocked" state set while filling it stays set.
        function resetConfirm(label, action) {
            $('btn-place').disabled = !LIVE_ENABLED;
            $('btn-place-label').textContent = label;
            $('m-stale').innerHTML = STALE_HTML;
            $('m-stale').classList.add('d-none');
            CONFIRM_ACTION = action;
        }
        const DURATION_TEXT = { Day: 'It works until the close today.', GoodTillCancel: 'It works until you cancel it.', FillOrKill: 'It fills in full at once, or is cancelled.' };
        const num = (id, dflt) => {
            const v = parseFloat($(id).value);
            return isNaN(v) ? dflt : v;
        };
        const fmt = (v, d = 2) => (v === null || v === undefined) ? '—' : Number(v).toFixed(d);
        const money = v => (v < 0 ? '-' : '') + '$' + Math.abs(v).toLocaleString(undefined,
            {minimumFractionDigits: 2, maximumFractionDigits: 2});

        function showErr(msg, reauth) {
            const e = $('err');
            e.className = 'c-note bad mb-3';
            e.innerHTML = '<i class="bi bi-exclamation-octagon"></i><span>' + msg + (reauth
                ? ' <a href="/setup/brokers">Reconnect Schwab</a>' : '') + '</span>';
            e.scrollIntoView({block: 'nearest'});
        }

        function clearErr() {
            $('err').classList.add('d-none');
            $('err').textContent = '';
        }

        async function getJson(url) {
            const r = await fetch(url, {headers: {'Accept': 'application/json'}});
            const j = await r.json().catch(() => ({error: 'Malformed response from server.'}));
            if (j.error) {
                showErr(j.error, j.reauth);
                return null;
            }
            return j;
        }

        // ── Panel A ────────────────────────────────────────────────────

        async function loadExpirations() {
            clearErr();
            const sym = $('f-symbol').value.trim().toUpperCase();
            if (!sym) return;
            $('status').textContent = 'loading expirations…';
            $('btn-load').disabled = true;

            const j = await getJson(`?handler=Expirations&symbol=${encodeURIComponent(sym)}`);
            $('btn-load').disabled = false;
            if (!j) {
                $('status').textContent = '';
                return;
            }

            UNDERLYING = j.underlyingPrice;
            const badge = $('underlying-badge');
            badge.classList.remove('d-none');
            badge.textContent = `${j.symbol} ${Number(j.underlyingPrice).toFixed(2)}`;

            $('f-expiry').innerHTML = j.expirations
                .map(e => `<option value="${e.date}">${e.date} &nbsp;(${e.dte}d)</option>`).join('');
            $('f-expiry').disabled = false;
            $('status').textContent = `${j.expirations.length} expirations`;
            await loadChain();
        }

        async function loadChain() {
            clearErr();
            const sym = $('f-symbol').value.trim().toUpperCase();
            const exp = $('f-expiry').value;
            if (!sym || !exp) return;
            $('status').textContent = 'loading chain…';

            const j = await getJson(
                `?handler=Chain&symbol=${encodeURIComponent(sym)}&expiry=${exp}&strikeCount=${$('f-strikes').value}`);
            if (!j) {
                $('status').textContent = '';
                return;
            }

            ROWS = j.rows;
            UNDERLYING = j.underlyingPrice;

            // Shown beside the chain because a target inside the expected move is already
            // priced in; one well outside it needs the market to be wrong.
            LAST_EXPECTED_MOVE = j.expectedMove;
            LAST_RATE = j.interestRate || 0;
            loadIvStanding();
            $('expected-move').innerHTML = j.expectedMove == null
                ? '<span class="text-secondary">expected move unavailable</span>'
                : `expected move <span class="text-info">±${fmt(j.expectedMove)}</span>`
                + `<span class="text-secondary"> (±${fmt(j.expectedMovePct, 1)}%) by expiry</span>`;
            $('underlying-badge').textContent = `${j.symbol} ${Number(j.underlyingPrice).toFixed(2)}`;
            render();

            // Legs already selected keep their own prices unless this chain contains them.
            // Without this a reload leaves the structure priced off a market that has moved.
            repriceLegsFromChain();
            if (LEGS.length) renderLegs(false);   // also refreshes the "different expiry" badges

            // Suggestions belong to the chain they were built from. Leaving them on screen after
            // an expiry change offers structures from the wrong date, and "Use" would load them.
            if (SUGGESTIONS.length && SUGGEST_EXPIRY !== exp) {
                clearSuggestions();
                if ($('f-target').value !== '') await suggest();   // the view still stands; re-run it here
            }


        }

        /// Refresh any leg present in the current chain view. Returns true if anything changed.
        function repriceLegsFromChain() {
            let changed = false;
            for (const leg of LEGS) {
                const r = ROWS.find(x => x.symbol === leg.symbol);
                if (!r) continue;                        // different expiry — left for the server re-quote
                const fresh = leg.action === 'Buy' ? r.ask : r.bid;
                if (fresh !== leg.premium) changed = true;
                leg.premium = fresh;
                leg.quotedAt = Date.now();
            }
            return changed;
        }

        /// Re-quote every leg through the broker, whatever expiry it belongs to.
        async function refreshLegPrices() {
            if (!LEGS.length) return true;
            const res = await fetch('?handler=QuoteLegs', {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN},
                body: JSON.stringify({symbols: LEGS.map(l => l.symbol)}),
            });
            const j = await res.json().catch(() => ({error: 'Malformed response.'}));
            if (j.error) {
                showErr(j.error, j.reauth);
                return false;
            }

            if (j.missing && j.missing.length) {
                showErr('No live quote for: ' + j.missing.join(', '));
                return false;
            }
            for (const leg of LEGS) {
                const q = j.quotes[leg.symbol];
                if (!q) continue;
                leg.premium = leg.action === 'Buy' ? q.ask : q.bid;
                leg.quotedAt = Date.now();
            }
            return true;
        }

        function passes(r) {
            if ($('f-right').value && r.right !== $('f-right').value) return false;

            const askMin = $('f-askmin').value === '' ? null : num('f-askmin', 0);
            const askMax = $('f-askmax').value === '' ? null : num('f-askmax', 0);
            if (askMin !== null && r.ask < askMin) return false;
            if (askMax !== null && r.ask > askMax) return false;

            const dMin = $('f-deltamin').value === '' ? null : num('f-deltamin', 0);
            if (dMin !== null && Math.abs(r.delta) < dMin) return false;
            if (r.openInterest < num('f-oi', 0)) return false;

            if ($('f-tradeable').checked) {
                if (!r.hasBid) return false;
                if (r.spreadPct === null || r.spreadPct > num('f-spread', 1e9)) return false;
            }
            return true;
        }

        function render() {
            const commPerCt = num('f-comm', 0);
            const maxSpread = num('f-spread', 1e9);
            const body = $('chain-body');

            if (!ROWS.length) {
                body.innerHTML = `<tr><td colspan="15" class="text-center text-secondary py-4">
            Enter an underlying and press Load.</td></tr>`;
                return;
            }
            const shown = ROWS.filter(passes);
            if (!shown.length) {
                body.innerHTML = `<tr><td colspan="15" class="text-center text-secondary py-4">
            No contracts match these filters.</td></tr>`;
                $('status').textContent = `0 of ${ROWS.length} contracts`;
                return;
            }

            body.innerHTML = shown.map(r => {
                const premium = r.ask * r.multiplier;
                const commPct = premium > 0 ? (commPerCt / premium * 100) : null;
                const tradeable = r.hasBid && r.spreadPct !== null && r.spreadPct <= maxSpread;
                const spreadCls = (r.spreadPct === null || r.spreadPct > maxSpread) ? 'text-danger'
                    : r.spreadPct > maxSpread / 2 ? 'text-warning' : 'text-success';
                const commCls = commPct === null ? 'text-danger'
                    : commPct > 10 ? 'text-danger' : commPct > 2 ? 'text-warning' : 'text-secondary';

                return `<tr class="${r.itm ? 'table-active' : ''}">
            <td><span class="badge ${r.right === 'Call' ? 'bg-success' : 'bg-danger'}">${r.right}</span>
                ${r.nonStandard ? '<span class="badge bg-warning text-dark ms-1" title="Non-standard deliverable">NS</span>' : ''}</td>
            <td class="text-end">${fmt(r.strike)}</td>
            <td class="text-end ${r.hasBid ? '' : 'text-danger fw-bold'}">${fmt(r.bid)}</td>
            <td class="text-end">${fmt(r.ask)}</td>
            <td class="text-end">${fmt(r.mid)}</td>
            <td class="text-end ${spreadCls}">${r.spreadPct === null ? 'no mkt' : fmt(r.spreadPct, 1)}</td>
            <td class="text-end">${fmt(r.delta, 3)}</td>
            <td class="text-end">${fmt(r.theta, 3)}</td>
            <td class="text-end">${fmt(r.iv, 1)}</td>
            <td class="text-end">${r.volume.toLocaleString()}</td>
            <td class="text-end">${r.openInterest.toLocaleString()}</td>
            <td class="text-end">${fmt(r.extrinsic)}</td>
            <td class="text-end ${commCls}">${commPct === null ? '—' : fmt(commPct, 1)}</td>
            <td>${tradeable
                    ? '<span class="badge bg-success-subtle text-success">ok</span>'
                    : `<span class="badge bg-danger-subtle text-danger" title="${!r.hasBid ? 'No bid — cannot be sold' : 'Spread too wide'}">${!r.hasBid ? 'no bid' : 'wide'}</span>`}</td>
            <td class="text-center text-nowrap">
                <button class="btn btn-xs btn-outline-success py-0 px-1" title="Buy this contract"
                        onclick="addLeg('${r.symbol}','Buy')">B</button>
                <button class="btn btn-xs btn-outline-danger py-0 px-1" title="Sell this contract"
                        onclick="addLeg('${r.symbol}','Sell')">S</button>
            </td>
        </tr>`;
            }).join('');

            const rejected = ROWS.length - shown.length;
            $('status').textContent =
                `${shown.length} of ${ROWS.length} contracts` + (rejected ? ` · ${rejected} filtered out` : '');
        }

        function resetFilters() {
            ['f-askmin', 'f-askmax', 'f-deltamin'].forEach(id => $(id).value = '');
            $('f-right').value = '';
            $('f-spread').value = 10;
            $('f-oi').value = 0;
            $('f-comm').value = 0.65;
            $('f-tradeable').checked = true;
            render();
        }

        function onCommissionChanged() {
            render();
            analyze();
        }

        // ── Panel B ────────────────────────────────────────────────────

        function addLeg(symbol, action) {
            const r = ROWS.find(x => x.symbol === symbol);
            if (!r) return;
            const existing = LEGS.find(l => l.symbol === symbol && l.action === action);
            if (existing) existing.quantity++;
            else LEGS.push({
                // Buying lifts the ask, selling hits the bid — quoting a structure at mid
                // would flatter every number downstream.
                symbol, action, right: r.right, strike: r.strike,
                premium: action === 'Buy' ? r.ask : r.bid,
                quantity: 1, multiplier: r.multiplier,
                american: r.american,
                impliedVolatility: r.iv,
                expiration: $('f-expiry').value,
                expiry: $('f-expiry').value,
                quotedAt: Date.now(),
            });
            renderLegs();
            legAdded(symbol, action);
        }

        // Each tap in the chain says what it did. On a phone the structure is on another step, so
        // without this a tap looked like nothing happened and repeated taps stacked up legs.
        let LEGBAR_FLASH = null;
        function legAdded(symbol, action) {
            const leg = LEGS.find(l => l.symbol === symbol && l.action === action);
            if (!leg) return;
            const text = $('ox-legbar-text');
            text.textContent = `Added: ${action} ${leg.right} ${fmt(leg.strike)}${leg.quantity > 1 ? ' ×' + leg.quantity : ''}`;
            const bar = $('ox-legbar');
            bar.classList.remove('flash'); void bar.offsetWidth; bar.classList.add('flash');
            clearTimeout(LEGBAR_FLASH);
            LEGBAR_FLASH = setTimeout(syncSteps, 1600);
        }

        function saveDraft() {
            // Only the structure is kept. Size is deliberately excluded — a remembered quantity
            // surviving a reload is the same accident as a sticky one.
            try {
                if (LEGS.length) localStorage.setItem(DRAFT_KEY, JSON.stringify({
                    symbol: $('f-symbol').value.trim().toUpperCase(),
                    legs: LEGS,
                }));
                else localStorage.removeItem(DRAFT_KEY);
            } catch { /* private browsing or storage disabled — drafts are a convenience */
            }


        }

        function restoreDraft() {
            let draft = null;
            try {
                draft = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null');
            } catch {
            }
            if (!draft?.legs?.length) return;

            if (draft.symbol) $('f-symbol').value = draft.symbol;
            LEGS = draft.legs;
            renderLegs();          // structure restored, size back to 1

            // Restored premiums are as old as the reload. Mark them so, and re-quote.
            LEGS.forEach(l => {
                l.quotedAt = 0;
            });
            refreshLegPrices().then(ok => {
                if (ok) {
                    clearErr();
                    renderLegs(false);
                }
            });
        }

        function removeLeg(i) {
            LEGS.splice(i, 1);
            renderLegs();
        }

        function setQty(i, q) {
            LEGS[i].quantity = Math.max(1, parseInt(q) || 1);
            renderLegs();
        }

        function clearLegs() {
            LEGS = [];
            ANALYSIS_SEQ++;
            LAST_ANALYSIS = null;
            renderLegs();
        }

        function structureName() {
            if (!LEGS.length) return '';
            const n = LEGS.reduce((s, l) => s + l.quantity, 0);
            const rights = new Set(LEGS.map(l => l.right));
            const strikes = new Set(LEGS.map(l => l.strike));
            if (LEGS.length === 1) return `${LEGS[0].action} ${LEGS[0].right}`;
            if (LEGS.length === 2 && rights.size === 1) return 'Vertical';
            if (LEGS.length === 2 && rights.size === 2 && strikes.size === 1) return 'Straddle';
            if (LEGS.length === 2 && rights.size === 2) return 'Strangle';
            if (LEGS.length === 3 && rights.size === 1) return 'Butterfly';
            if (LEGS.length === 4 && rights.size === 2) return 'Iron condor';
            return `${LEGS.length} legs / ${n} contracts`;
        }

        /// resetSize: true when the STRUCTURE changed (legs added/removed/re-rationed), false when
        /// only prices were refreshed. Re-quoting must not silently reset the trader's size.
        function renderLegs(resetSize = true) {
            const panel = $('panel-b');
            if (!LEGS.length) {
                panel.classList.add('d-none');
                LEGS = [];
                saveDraft();
                return;
            }
            panel.classList.remove('d-none');
            $('struct-name').textContent = structureName();
            // Size never carries over from the last structure. A remembered quantity is how a
            // 1-lot habit turns into a 50-lot accident.
            if (resetSize) {
                $('f-spreads').value = 1;
                $('f-limit').value = '';   // a price meant for the previous structure is meaningless here
                $('f-exit').value = '';
                $('f-stop').value = '';
            }

            saveDraft();
            $('legs-body').innerHTML = LEGS.map((l, i) => `
        <tr>
            <td><span class="badge ${l.action === 'Buy' ? 'bg-success' : 'bg-danger'}">${l.action === 'Buy' ? '+' : '−'}</span></td>
            <td class="small"><code>${l.symbol}</code><br>
                <span class="text-secondary">${l.right} ${fmt(l.strike)}</span>
                ${l.expiry && l.expiry !== $('f-expiry').value
                ? `<span class="badge bg-secondary ms-1" title="Different expiry from the chain on screen">${l.expiry}</span>` : ''}</td>
            <td class="text-end">
                <input type="number" min="1" value="${l.quantity}" style="width:64px"
                       class="form-control form-control-sm text-end"
                       onchange="setQty(${i}, this.value)">
            </td>
            <td class="text-end">${fmt(l.premium)}
                <div class="small leg-age" data-i="${i}">${l.action === 'Buy' ? 'ask' : 'bid'} · ${legAge(l)}</div></td>
            <td class="text-end">
                <button class="btn btn-xs btn-outline-secondary py-0 px-1"
                        onclick="removeLeg(${i})" title="Remove">&times;</button></td>
        </tr>`).join('');

            analyze();
        }

        async function analyze() {
            if (!LEGS.length) return;
            const seq = ++ANALYSIS_SEQ;

            const res = await fetch('?handler=Analyze', {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN},
                body: JSON.stringify({
                    legs: LEGS, commissionPerContract: num('f-comm', 0), underlyingPrice: UNDERLYING,
                    limitPrice: limitPrice(),
                }),
            });
            const j = await res.json().catch(() => ({error: 'Malformed response.'}));

            if (seq !== ANALYSIS_SEQ) return;          // a newer structure has been requested
            if (j.error) {
                showErr(j.error);
                return;
            }
            clearErr();

            $('a-net').innerHTML = j.netDebit >= 0
                ? `<span class="text-warning">${money(j.netDebit)}</span> <span class="small text-secondary">debit</span>`
                : `<span class="text-success">${money(-j.netDebit)}</span> <span class="small text-secondary">credit</span>`;
            // A bare best/worst case invites the wrong comparison: a long put's max profit is its
            // value at an underlying of zero, which dwarfs any realistic target. Say where it lives.
            const at = v => v == null ? '' : `<div class="small text-secondary">at ${Number(v).toFixed(2)}</div>`;

            $('a-loss').innerHTML = j.lossUnbounded
                ? 'UNLIMITED' : money(j.maxLoss) + at(j.maxLossAt);
            $('a-profit').innerHTML = j.profitUnbounded
                ? 'Unlimited' : money(j.maxProfit) + at(j.maxProfitAt);
            $('a-be').textContent = j.breakevens.length
                ? j.breakevens.map(b => Number(b).toFixed(2)).join(' / ') : '—';

            LAST_ANALYSIS = j;

            // Seed the what-if with something meaningful: spot today, halfway to expiry.
            if ($('wi-price').value === '' && UNDERLYING) $('wi-price').value = UNDERLYING.toFixed(2);
            if ($('wi-date').value === '' && LEGS.length && LEGS[0].expiration) {
                const e = new Date(LEGS[0].expiration + 'T00:00:00');
                const mid = new Date((Date.now() + e.getTime()) / 2);
                $('wi-date').value = mid.toISOString().slice(0, 10);
            }
            whatIf();

            const exp = LEGS.length ? LEGS[0].expiry : $('f-expiry').value;
            const en = $('exp-note');
            if (en) en.textContent = exp || 'the expiry date';
            renderTicket();
            drawChart(j.curve, j.breakevens);
        }

        // ── Payoff chart ───────────────────────────────────────────────

        function drawChart(curve, breakevens) {
            const W = 520, H = 240, L = 52, R = 10, T = 12, B = 26;
            const xs = curve.map(p => p.x), ys = curve.map(p => p.y);
            const xMin = Math.min(...xs), xMax = Math.max(...xs);
            let yMin = Math.min(...ys), yMax = Math.max(...ys);
            const padY = Math.max((yMax - yMin) * 0.12, 1);
            yMin -= padY;
            yMax += padY;

            const px = x => L + (x - xMin) / (xMax - xMin || 1) * (W - L - R);
            const py = y => T + (yMax - y) / (yMax - yMin || 1) * (H - T - B);

            let svg = '';
            // zero line
            const y0 = py(0);
            svg += `<line x1="${L}" y1="${y0}" x2="${W - R}" y2="${y0}" style="stroke:var(--c-muted)" stroke-dasharray="3 3" stroke-width="1"/>`;
            // axes
            svg += `<line x1="${L}" y1="${T}" x2="${L}" y2="${H - B}" style="stroke:var(--c-line)" stroke-width="1"/>`;

            // payoff, coloured per segment by sign
            for (let i = 0; i < curve.length - 1; i++) {
                const a = curve[i], b = curve[i + 1];
                const colour = (a.y >= 0 && b.y >= 0) ? 'var(--c-up)' : (a.y < 0 && b.y < 0) ? 'var(--c-down)' : 'var(--c-accent)';
                svg += `<line x1="${px(a.x)}" y1="${py(a.y)}" x2="${px(b.x)}" y2="${py(b.y)}" stroke="${colour}" stroke-width="2"/>`;
            }

            // breakevens
            for (const be of breakevens) {
                if (be < xMin || be > xMax) continue;
                svg += `<line x1="${px(be)}" y1="${T}" x2="${px(be)}" y2="${H - B}" style="stroke:var(--c-accent)" stroke-dasharray="2 3" stroke-width="1"/>`;
                svg += `<text x="${px(be)}" y="${H - B + 14}" style="fill:var(--c-accent)" font-size="10" text-anchor="middle">${Number(be).toFixed(2)}</text>`;
            }

            // current underlying
            if (UNDERLYING >= xMin && UNDERLYING <= xMax) {
                svg += `<line x1="${px(UNDERLYING)}" y1="${T}" x2="${px(UNDERLYING)}" y2="${H - B}" style="stroke:var(--c-paper)" stroke-width="1"/>`;
                svg += `<text x="${px(UNDERLYING)}" y="${T + 10}" style="fill:var(--c-paper)" font-size="10" text-anchor="middle">spot</text>`;
            }

            // y labels
            for (const v of [yMax, 0, yMin]) {
                svg += `<text x="${L - 6}" y="${py(v) + 3}" style="fill:var(--c-muted)" font-size="10" text-anchor="end">${Math.round(v).toLocaleString()}</text>`;
            }
            // x labels
            svg += `<text x="${L}" y="${H - 6}" style="fill:var(--c-muted)" font-size="10">${xMin.toFixed(0)}</text>`;
            svg += `<text x="${W - R}" y="${H - 6}" style="fill:var(--c-muted)" font-size="10" text-anchor="end">${xMax.toFixed(0)}</text>`;

            $('payoff').innerHTML = svg;
        }

        /// IV against its own history, as a constant-maturity series — one reading per
        /// session. Silent about rank until enough sessions exist: a rank computed from a
        /// few days is not a rank, and showing one invites the confidence it has not earned.
        async function loadIvStanding() {
            const el = $('iv-standing');
            const sym = $('f-symbol').value.trim().toUpperCase();
            if (!sym) {
                el.innerHTML = '';
                return;
            }

            const j = await getJson(`?handler=IvStanding&symbol=${encodeURIComponent(sym)}&lookbackDays=365&targetDte=30`);
            if (!j) {
                el.innerHTML = '';
                return;
            }

            if (j.rank == null) {
                const have = j.sessions || 0;
                el.innerHTML = `<span class="text-secondary" `
                    + `title="IV history cannot be backfilled — it accumulates from the day capture starts">`
                    + (j.currentIv != null ? `IV ${j.currentIv} · ` : '')
                    + `rank needs ${j.needed || 20} sessions, have ${have}</span>`;
                return;
            }
            const tone = j.rank >= 70 ? 'text-danger' : j.rank <= 30 ? 'text-success' : 'text-warning';
            el.innerHTML = `IV <span class="${tone}">${j.currentIv}</span>`
                + `<span class="text-secondary"> · rank ${j.rank} · pctile ${j.percentile} `
                + `(${j.low}–${j.high} over ${j.sessions} sessions)</span>`;
        }

        /// What the structure is worth at a price on a date, rather than at settlement.
        /// Three volatility scenarios, because a single figure would be the same false
        /// precision the expiration number already invites.
        let WHATIF_SEQ = 0;

        async function whatIf() {
            const out = $('wi-value'), range = $('wi-range'), exp = $('wi-expiry');
            const price = $('wi-price').value, date = $('wi-date').value;

            if (!LEGS.length || price === '' || !date) {
                out.textContent = '—';
                range.textContent = '';
                exp.textContent = '—';
                return;
            }

            const seq = ++WHATIF_SEQ;
            const res = await fetch('?handler=WhatIf', {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN},
                body: JSON.stringify({
                    legs: LEGS, underlying: parseFloat(price), asOf: date,
                    rate: LAST_RATE, commissionPerContract: num('f-comm', 0),
                    ivShiftPoints: num('wi-iv', 0),
                }),
            });
            const j = await res.json().catch(() => ({error: 'Malformed response.'}));
            if (seq !== WHATIF_SEQ) return;

            if (j.error) {
                out.textContent = '—';
                range.innerHTML = `<span class="text-warning">${escapeHtml(j.error)}</span>`;
                return;
            }

            out.innerHTML = `<span class="${j.value >= 0 ? 'text-success' : 'text-danger'}">${money(j.value)}</span>`;
            range.innerHTML = j.ivDown == null ? ''
                : `IV ±5: <span class="text-secondary">${money(j.ivDown)} … ${money(j.ivUp)}</span>`;
            exp.textContent = money(j.atExpiry);
            $('wi-dte').textContent = `${j.daysToExpiry}d to expiry`;
        }

        // ── Panel C · ticket ───────────────────────────────────────────

        const LEG_STALE_MS = 60000;

        function legAgeMs(l) {
            return Date.now() - (l.quotedAt || 0);
        }

        function legAge(l) {
            const s = Math.round(legAgeMs(l) / 1000);
            return s < 1 ? 'now' : `${s}s ago`;
        }

        function legAgeClass(l) {
            return legAgeMs(l) > LEG_STALE_MS ? 'text-warning' : 'text-secondary';
        }

        // A frozen "5s ago" that never advances is worse than showing nothing, so the age is
        // repainted in place rather than baked into the row at render time.
        setInterval(() => {
            for (const el of document.querySelectorAll('.leg-age')) {
                const l = LEGS[parseInt(el.dataset.i)];
                if (!l) continue;
                el.textContent = `${l.action === 'Buy' ? 'ask' : 'bid'} · ${legAge(l)}`;
                el.className = `small leg-age ${legAgeClass(l)}`;
            }


        }, 1000);

        async function reQuoteAndAnalyse() {
            if (await refreshLegPrices()) {
                clearErr();
                renderLegs(false);
            }


        }

        function spreadCount() {
            return Math.max(1, parseInt($('f-spreads').value) || 1);
        }

        function limitPrice() {
            return $('f-limit').value === '' ? null : num('f-limit', 0);
        }

        function exitPrice() {
            return $('f-exit').value === '' ? null : num('f-exit', 0);
        }

        /// Contract price that arms the stop. Single-leg only — Schwab has no net-stop
        /// order type for a spread.
        function stopPrice() {
            return $('f-stop').value === '' ? null : num('f-stop', 0);
        }

        function onSpreadsChanged() {
            renderTicket();
        }

        function onLimitChanged() {
            renderTicket();
            analyze();
        }

        function renderTicket() {
            if (!LAST_ANALYSIS) return;
            const n = spreadCount();

            $('t-contracts').textContent = LEGS.reduce((s, l) => s + l.quantity, 0) * n;

            // Leg quantities carry a count as well as a ratio. Three identical puts is one put
            // traded three times, and the quoted price must stay per put.
            const gcd2 = (a, b) => b ? gcd2(b, a % b) : a;
            const factor = LEGS.reduce((g, l) => gcd2(g, Math.max(1, l.quantity)), 0) || 1;
            const marketNet = LEGS.reduce(
                (s, l) => s + (l.action === 'Buy' ? 1 : -1) * l.premium * (l.quantity / factor), 0);
            const lim = limitPrice();
            const net = lim !== null ? lim : marketNet;

            let type = LEGS.length === 1 ? 'LIMIT'
                : net > 0 ? 'NET_DEBIT' : net < 0 ? 'NET_CREDIT' : 'NET_ZERO';
            const hasStop = stopPrice() !== null && LEGS.length === 1;
            if (exitPrice() !== null && hasStop) type += ' + OCO exit/stop';
            else if (exitPrice() !== null) type += ' + exit';
            else if (hasStop) type += ' + stop';
            $('t-ordertype').textContent = type;

            // A spread has no net-stop order type at Schwab. Saying why beats an input that
            // silently does nothing — and its worst case is already bounded.
            const sh = $('t-stop-hint');
            const stopField = $('f-stop');
            if (LEGS.length > 1) {
                stopField.disabled = true;
                sh.innerHTML = '<span class="text-warning">not available on spreads</span>';
            } else {
                stopField.disabled = false;
                sh.textContent = stopPrice() === null
                    ? 'single leg only'
                    // Through the trigger in the direction the stop trades: a sold option is bought back.
                    : `stop-limit at ${fmt(stopPrice() * (LEGS[0]?.action === 'Sell' ? 1.1 : 0.9))}`;
            }

            // Say plainly whether this limit is asking the market to come to you.
            const hint = $('t-limit-hint');
            if (lim === null) {
                hint.textContent = `market ${marketNet.toFixed(2)}`;
                hint.className = 'tk-hint';
            } else if (Math.abs(lim - marketNet) < 0.005) {
                hint.textContent = 'at the market';
                hint.className = 'tk-hint';
            } else if (lim < marketNet) {
                hint.textContent = `${(marketNet - lim).toFixed(2)} better than market`;
                hint.className = 'tk-hint text-success';
            } else {
                hint.textContent = `${(lim - marketNet).toFixed(2)} worse than market`;
                hint.className = 'tk-hint text-warning';
            }

            // Total, not per-spread. The multiplied number is the one that matters.
            $('t-maxloss').textContent = LAST_ANALYSIS.lossUnbounded
                ? 'UNLIMITED' : money(LAST_ANALYSIS.maxLoss * n);

            // What the round trip makes if the attached exit fills. Commission is paid twice.
            const xp = exitPrice();
            const el = $('t-target');
            if (xp === null) {
                el.textContent = '—';
                el.className = 'fs-5 fw-bold text-secondary';
            } else {
                const mult = LEGS[0]?.multiplier || 100;
                const cts = LEGS.reduce((s, l) => s + l.quantity, 0) * n;
                const comm = cts * num('f-comm', 0);
                const units = n * factor;
                const profit = (xp * mult * units - comm) - (net * mult * units + comm);
                el.textContent = money(profit);
                el.className = 'fs-5 fw-bold ' + (profit >= 0 ? 'text-success' : 'text-danger');
            }


        }

        async function previewOrder() {
            if (!LEGS.length) return;
            $('btn-preview').disabled = true;
            try {
                // Always price the preview off a fresh quote. The figures in this dialog are the
                // ones the order is confirmed against, so they must never be a stale snapshot
                // from whenever the leg happened to be clicked.
                if (!await refreshLegPrices()) return;
                renderLegs(false);
                await new Promise(r => setTimeout(r, 250));   // let the re-analyse settle

                const res = await fetch('?handler=PreviewOrder', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN},
                    body: JSON.stringify({
                        legs: LEGS, spreads: spreadCount(),
                        commissionPerContract: num('f-comm', 0),
                        limitPrice: limitPrice(), exitPrice: exitPrice(), stopPrice: stopPrice(),
                        duration: $('f-duration').value,
                    }),
                });
                const j = await res.json().catch(() => ({error: 'Malformed response.'}));
                if (j.error) {
                    showErr(j.error);
                    return;
                }
                clearErr();
                PREVIEW = j;
                PREVIEW_AT = Date.now();
                showConfirm(j);
            } finally {
                $('btn-preview').disabled = false;
            }


        }

        function showConfirm(j) {
            resetConfirm('Hold to place order', placeOrder);
            $('m-mode').className = 'alert py-2 mb-3 ' + (LIVE_ENABLED ? 'alert-danger' : 'alert-secondary');
            $('m-mode').innerHTML = LIVE_ENABLED
                ? '<strong>LIVE.</strong> Placing this order sends it to Schwab for execution.'
                : '<strong>Preview mode.</strong> Live placement is disabled in configuration; this order cannot be submitted.';

            $('m-legs').innerHTML = j.payload.orderLegCollection.map(l => `
        <tr>
            <td><span class="badge ${l.instruction.startsWith('BUY') ? 'bg-success' : 'bg-danger'}">${l.instruction}</span></td>
            <td><code class="small">${l.instrument.symbol}</code></td>
            <td class="text-end">${l.quantity}</td>
        </tr>`).join('');

            $('m-net').innerHTML = j.totalNet >= 0
                ? `${money(j.totalNet)} <span class="small text-secondary">debit</span>`
                : `${money(-j.totalNet)} <span class="small text-secondary">credit</span>`;
            $('m-loss').textContent = j.lossUnbounded ? 'UNLIMITED' : money(j.totalMaxLoss);
            $('m-profit').textContent = j.profitUnbounded ? 'Unlimited' : money(j.totalMaxProfit);
            $('m-be').textContent = j.breakevens.length
                ? j.breakevens.map(b => Number(b).toFixed(2)).join(' / ') : '—';

            // Early assignment is a risk you accept at submission, so it belongs in the
            // dialog rather than buried in a chain column.
            const shortAmerican = LEGS.filter(l => l.action === 'Sell' && l.american !== false);
            if (shortAmerican.length) {
                $('m-legs').innerHTML += `<tr class="table-warning">
                    <td colspan="3" class="small"><i class="bi bi-exclamation-triangle me-1"></i>
                        <strong>${shortAmerican.length} short American leg(s)</strong> &mdash; these can
                        be assigned at any time before expiry, not only at expiration. Assignment
                        turns the leg into stock and the structure's defined risk with it.
                        Index options are European and cannot do this.</td></tr>`;
            }

            $('m-legs').innerHTML += `<tr>
                <td colspan="3" class="small"><i class="bi bi-clock me-1"></i>
                    <strong>${DURATION_TEXT[j.duration] || j.duration}</strong>
                    ${j.exitPrice != null || j.stopPrice != null ? 'Once it fills, the exit and stop stay until cancelled.' : ''}</td></tr>`;

            if (j.stopUnavailable) {
                $('m-legs').innerHTML += `<tr class="table-warning">
                    <td colspan="3" class="small"><i class="bi bi-exclamation-triangle me-1"></i>
                        <strong>No stop was attached.</strong> Schwab prices a spread as a net debit
                        or credit and neither is a stop order type, so a spread cannot carry one.
                        Its worst case is already bounded &mdash; that bound is the stop.</td></tr>`;
            }

            if (j.stopPrice != null) {
                $('m-legs').innerHTML += `<tr class="table-danger">
                    <td colspan="2" class="small"><i class="bi bi-shield-exclamation me-1"></i>
                        On fill, submit a stop-limit triggering at
                        <strong>${fmt(j.stopPrice)}</strong>, limit <strong>${fmt(j.stopLimit)}</strong>
                        ${j.exitPrice != null ? '(OCO with the exit above)' : ''}
                        <div class="text-secondary">A stop-limit can fail to fill in a fast move.
                        A plain stop would fill, at whatever the spread is the moment it triggers.</div>
                    </td><td></td></tr>`;
            }

            if (j.exitPrice != null) {
                $('m-legs').innerHTML += `<tr class="table-info">
            <td colspan="2" class="small"><i class="bi bi-arrow-return-right me-1"></i>
                On fill, submit closing order at net <strong>${Number(j.exitPrice).toFixed(2)}</strong>
                (good till cancelled)</td>
            <td></td></tr>`;

                $('m-profit').innerHTML = j.targetProfit == null ? $('m-profit').innerHTML
                    : `${money(j.targetProfit)}<div class="small text-secondary">if the exit fills`
                    + (j.returnOnRisk != null ? ` · ${Number(j.returnOnRisk).toFixed(0)}% of risk` : '')
                    + `</div>`;

                if (j.exitUnreachable) {
                    $('m-stale').classList.remove('d-none');
                    $('m-stale').innerHTML =
                        `<strong>This exit can never fill.</strong> The structure cannot be worth more than
                 <strong>${Number(j.maxStructureValue).toFixed(2)}</strong> at expiration, but the exit
                 asks for ${Number(j.exitPrice).toFixed(2)}. Lower the exit or widen the structure.`;
                    $('btn-place').disabled = true;
                }
            }

            $('m-broker').innerHTML = j.brokerBody
                ? `<div class="text-secondary">Schwab preview ${j.brokerOk ? '<span class="text-success">accepted</span>' : '<span class="text-danger">rejected</span>'}:</div>
           <pre class="small mb-0" style="max-height:140px; overflow:auto">${escapeHtml(j.brokerBody).slice(0, 2000)}</pre>`
                : '<span class="text-secondary">No Schwab account configured — broker validation skipped.</span>';

            new bootstrap.Modal($('confirm-modal')).show();
            clearInterval(AGE_TIMER);
            AGE_TIMER = setInterval(tickAge, 500);
            tickAge();
        }

        function tickAge() {
            const age = Date.now() - PREVIEW_AT;
            $('m-age').textContent = `quote age ${(age / 1000).toFixed(0)}s`;
            if (age > STALE_AFTER_MS) {
                // The order is always a limit, so a stale quote means "no fill" rather than a
                // bad fill — but confirming numbers you can no longer see is still wrong.
                $('m-stale').classList.remove('d-none');
                $('btn-place').disabled = true;
                clearInterval(AGE_TIMER);
            }


        }

        async function placeOrder() {
            if (!PREVIEW || Date.now() - PREVIEW_AT > STALE_AFTER_MS) return;
            $('btn-place').disabled = true;
            const res = await fetch('?handler=PlaceOrder', {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN},
                body: JSON.stringify({
                    legs: LEGS, spreads: PREVIEW.spreads,
                    commissionPerContract: num('f-comm', 0),
                    limitPrice: PREVIEW.limitPrice, exitPrice: PREVIEW.exitPrice,
                    stopPrice: PREVIEW.stopPrice,
                    duration: PREVIEW.duration,
                    underlying: $('f-symbol').value.trim().toUpperCase(),
                    structure: structureName(),
                }),
            });
            const j = await res.json().catch(() => ({error: 'Malformed response.'}));
            clearInterval(AGE_TIMER);
            bootstrap.Modal.getInstance($('confirm-modal'))?.hide();

            if (j.error) {
                showErr(j.error);
                return;
            }
            if (j.ok) {
                showOk(`Order placed${j.orderId ? ' — id ' + j.orderId : ''}.`);
                $('err').lastChild.insertAdjacentHTML('beforeend', ' <a href="/options/positions">See it in Positions</a>.');
                clearLegs();
            } else {
                showErr('Schwab rejected the order: ' + escapeHtml(j.body || '').slice(0, 400));
            }


        }

        function showOk(msg) {
            const e = $('err');
            e.className = 'c-note mb-3';
            e.innerHTML = '<i class="bi bi-check-circle"></i><span></span>';
            e.lastChild.textContent = msg;
            e.scrollIntoView({block: 'nearest'});
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, c =>
                ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
        }

        // ── Structures that fit a view ─────────────────────────────────

        let SUGGESTIONS = [];
        let LAST_EXPECTED_MOVE = null;
        let LAST_RATE = 0;
        // The expiry the visible suggestions were built from. They are only meaningful for that
        // chain, so anything that changes the chain must invalidate them.
        let SUGGEST_EXPIRY = null;

        function clearSuggestions() {
            SUGGESTIONS = [];
            SUGGEST_EXPIRY = null;
            $('suggest-wrap').classList.add('d-none');
            $('suggest-body').innerHTML = '';
            $('t-target-hint').textContent = '';
        }

        async function suggest() {
            const sym = $('f-symbol').value.trim().toUpperCase();
            const exp = $('f-expiry').value;
            const tgt = $('f-target').value;
            if (!sym || !exp) {
                showErr('Load a chain first.');
                return;
            }
            if (tgt === '') {
                showErr('Enter the price you expect the underlying to reach.');
                return;
            }

            $('btn-suggest').disabled = true;
            $('t-target-hint').textContent = 'searching…';
            try {
                const j = await getJson(`?handler=Suggest&symbol=${encodeURIComponent(sym)}&expiry=${exp}`
                    + `&target=${encodeURIComponent(tgt)}&commission=${num('f-comm', 0)}`
                    + `&strikeCount=${$('f-strikes').value}&maxSpreadPct=${num('f-spread', 10)}`);
                if (!j) {
                    $('t-target-hint').textContent = '';
                    return;
                }

                // The expiry can change while this request is in flight.
                if ($('f-expiry').value !== exp) return;

                SUGGESTIONS = j.candidates || [];
                SUGGEST_EXPIRY = exp;
                const move = ((j.target - j.underlyingPrice) / j.underlyingPrice * 100);

                // A target inside the expected move is already priced in; one well outside
                // it needs the market to be wrong. Saying which is more use than a percentage.
                const dist = Math.abs(j.target - j.underlyingPrice);
                const vsEm = LAST_EXPECTED_MOVE ? dist / LAST_EXPECTED_MOVE : null;

                $('t-target-hint').innerHTML =
                    `spot ${Number(j.underlyingPrice).toFixed(2)} · `
                    + `<span class="${move >= 0 ? 'text-success' : 'text-danger'}">${move >= 0 ? '+' : ''}${move.toFixed(1)}%</span>`
                    + (vsEm == null ? ''
                        : ` · <span class="${vsEm > 1 ? 'text-warning' : 'text-secondary'}" `
                        + `title="Inside the expected move is already priced in; beyond it needs the market to be wrong">`
                        + `${vsEm.toFixed(2)}× expected move</span>`);

                renderSuggestions(j);
            } finally {
                $('btn-suggest').disabled = false;
            }


        }

        function renderSuggestions(j) {
            const wrap = $('suggest-wrap');
            if (!SUGGESTIONS.length) {
                wrap.classList.add('d-none');
                showErr('No tradeable structures for that target — try a wider spread limit or more strikes.');
                return;
            }
            wrap.classList.remove('d-none');

            const s0 = SUGGESTIONS[0].sensitivity;
            const expTag = '<div class="lbl-exp">at expiry</div>';
            $('th-lo').innerHTML = '@@' + Number(s0[0].x).toFixed(0) + expTag;
            $('th-mid').innerHTML = '@@' + Number(s0[1].x).toFixed(0) + ' <span class="text-info">★</span>' + expTag;
            $('th-hi').innerHTML = '@@' + Number(s0[2].x).toFixed(0) + expTag;

            const cell = v => `<td class="text-end ${v >= 0 ? 'text-success' : 'text-danger'}">${money(v)}</td>`;

            $('suggest-body').innerHTML = SUGGESTIONS.map((c, i) => `
        <tr>
            <td>${escapeHtml(c.name)}
                <div class="small text-secondary">${c.legs.map(l =>
                `${l.action === 'Buy' ? '+' : '−'}${l.quantity > 1 ? l.quantity : ''}${l.right[0]}${fmt(l.strike, 0)}`).join(' ')}</div></td>
            <td class="text-end">${c.netDebit >= 0 ? money(c.netDebit) : money(-c.netDebit) + ' cr'}</td>
            <td class="text-end text-danger">${c.maxLoss == null ? 'UNLIMITED' : money(c.maxLoss)}</td>
            ${cell(c.sensitivity[0].y)}
            <td class="text-end fw-bold ${c.sensitivity[1].y >= 0 ? 'text-success' : 'text-danger'}">${money(c.sensitivity[1].y)}</td>
            ${cell(c.sensitivity[2].y)}
            <td class="text-end">${c.returnOnRisk == null ? '—' : Number(c.returnOnRisk).toFixed(0) + '%'}</td>
            <td class="text-end ${c.worstSpread > 5 ? 'text-warning' : 'text-secondary'}">${fmt(c.worstSpread, 1)}%</td>
            <td class="text-end">
                <button class="btn btn-xs btn-outline-primary py-0 px-2" onclick="useSuggestion(${i})">Use</button></td>
        </tr>`).join('');
        }

        /// Load a candidate into the builder so it can be priced, adjusted and previewed as normal.
        function useSuggestion(i) {
            const c = SUGGESTIONS[i];
            if (!c) return;
            LEGS = c.legs.map(l => ({
                symbol: l.symbol, action: l.action, right: l.right, strike: l.strike,
                premium: l.premium, quantity: l.quantity, multiplier: l.multiplier,
                expiry: $('f-expiry').value, quotedAt: Date.now(),
            }));
            renderLegs();
            showStep('build');
            $('panel-b').scrollIntoView({block: 'center'});
        }

        $('f-symbol').addEventListener('keydown', e => {
            if (e.key === 'Enter') loadExpirations();
        });
        // ── Steps. On a phone only the chosen step shows (CSS keys off data-ox-step);
        // on a wide screen all show and the tabs are hidden. ──
        function showStep(step) {
            document.body.dataset.oxStep = step;
            document.querySelectorAll('.ox-tabs [role=tab]').forEach(t =>
                t.setAttribute('aria-selected', t.dataset.step === step ? 'true' : 'false'));
        }
        document.querySelectorAll('.ox-tabs [role=tab]').forEach(t =>
            t.addEventListener('click', () => { showStep(t.dataset.step); window.scrollTo({top: 0}); }));
        showStep('pick');

        // Keep the empty state and the Build tab's leg count in step with the structure.
        function syncSteps() {
            $('ox-empty').classList.toggle('d-none', LEGS.length > 0);
            document.body.classList.toggle('ox-has-legs', LEGS.length > 0);
            const n = $('ox-legcount');
            n.textContent = LEGS.length;
            n.classList.toggle('d-none', LEGS.length === 0);
            if (LEGS.length) $('ox-legbar-text').textContent =
                `${LEGS.length} leg${LEGS.length === 1 ? '' : 's'} · ${structureName()}`;
        }
        const renderLegsBase = renderLegs;
        renderLegs = function (resetSize = true) { renderLegsBase(resetSize); syncSteps(); };

        restoreDraft();
        syncSteps();
    </script>
    <style>
        .btn-xs {
            font-size: .7rem;
            line-height: 1.2;
        }

        /* Ticket row: every column is label / control / hint on the same rhythm, so the inputs
           share a baseline. Aligning the bottoms instead pushes any column that carries a hint
           line upward relative to the ones that do not. */
        .ticket-row .tk-label,
        .ticket-row .tk-hint {
            font-size: .75rem;
            line-height: 1.1rem;
            min-height: 1.1rem;
            color: var(--bs-secondary-color);
        }

        .ticket-row .tk-label {
            margin-bottom: .25rem;
        }

        .ticket-row .tk-hint {
            margin-top: .25rem;
        }

        /* Read-out columns match the height of a form-control-sm so their values sit on the
           same line as the inputs beside them. */
        .ticket-row .tk-value {
            min-height: calc(1.5em + .5rem + 2px);
            display: flex;
            align-items: center;
        }

        .ticket-row .text-end .tk-value {
            justify-content: flex-end;
        }
    </style>
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <meta name="theme-color" content="#151a22"/>
    <title>CRV Trading — @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    @* asp-append-version emits a content hash, so a changed stylesheet actually reaches
       the browser instead of being served from cache indefinitely. *@
    <link rel="preload" href="~/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href="~/fonts/ibm-plex-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin/>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/crv.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true"/>
    @* Light mode is a per-browser preference, applied only on pages rebuilt for it
       (ViewData["LightReady"]); other pages stay dark until they're rebuilt. *@
    <script>
        (function () {
            if (@(ViewData["LightReady"] is true ? "true" : "false")) {
                try { if (localStorage.getItem('crv-theme') === 'light') document.documentElement.setAttribute('data-bs-theme', 'light'); } catch (e) { }
            }
        })();
    </script>
</head>
@{
    // Navigation is grouped by when in the trading day a page is used. A page is matched
    // by its ViewData["Page"] key, plus ViewData["Section"] where one key serves both
    // futures and options (Orders).
    var page = ViewData["Page"]?.ToString() ?? "";
    var section = ViewData["Section"]?.ToString() ?? "futures";

    var areas = new (string Key, string Label, string Icon, (string Page, string Section, string Href, string Icon, string Label)[] Items)[]
    {
        ("trade", "Trade", "bi-speedometer2", new[]
        {
            ("dashboard",    "", "/dashboard",           "bi-speedometer2",          "Cockpit"),
            ("positions",    "", "/trading/positions",   "bi-list-ul",               "Positions & orders"),
            ("orders",       "futures", "/trading/orders", "bi-clock-history",       "Order history"),
            ("prospectus",   "", "/dashboard/prospectus", "bi-calendar-check",       "Plan for today"),
        }),
        ("options", "Options", "bi-diagram-3", new[]
        {
            ("options-explorer", "", "/options/explorer", "bi-diagram-3", "Explorer"),
            ("orders", "options", "/trading/orders?section=options", "bi-list-ul", "Orders"),
        }),
        ("review", "Review", "bi-bar-chart-line", new[]
        {
            ("results",           "", "/review/results",    "bi-bar-chart-line", "Results"),
            ("sessions",          "", "/dashboard/sessions", "bi-calendar3",     "Sessions"),
            ("validation",        "", "/validation",        "bi-clipboard-data", "Validation"),
        }),
        ("setup", "Setup", "bi-sliders", new[]
        {
            ("strategies",     "", "/setup/strategies",  "bi-diagram-2",   "Strategies"),
            ("risk",           "", "/setup/risk",         "bi-shield-check", "Sessions & risk"),
            ("brokers",        "", "/setup/brokers",      "bi-plug",        "Brokers"),
            ("alerts",         "", "/setup/alerts",       "bi-bell",        "Alerts"),
        }),
    };

    bool IsActive((string Page, string Section, string Href, string Icon, string Label) n) =>
        n.Page == page && (n.Section == "" || n.Section == section);

    var currentArea = areas.FirstOrDefault(a => a.Items.Any(IsActive));

    // Phone tabs: the four areas, with futures Positions & orders given its own tab.
    var onPositions = page == "positions" || (page == "orders" && section != "options");
    var tabs = new (string Href, string Icon, string Label, bool Active)[]
    {
        ("/dashboard",        "bi-speedometer2",   "Trade",     currentArea.Key == "trade" && !onPositions),
        ("/trading/positions", "bi-list-ul",       "Positions", onPositions),
        ("/options/explorer", "bi-diagram-3",      "Options",   currentArea.Key == "options"),
        ("/review/results",   "bi-bar-chart-line", "Review",    currentArea.Key == "review"),
        ("/setup/strategies", "bi-sliders",        "Setup",     currentArea.Key == "setup"),
    };
}
<body class="crv-app" data-light-ready="@(ViewData["LightReady"] is true ? "true" : "false")">
<div class="crv-shell">
    <aside class="crv-side" aria-label="Main navigation">
        <a class="crv-brand" href="/"><i class="bi bi-activity"></i>CRV</a>
        @foreach (var a in areas)
        {
            <nav class="crv-navgrp" aria-label="@a.Label">
                <div class="crv-navgrp-h">@a.Label</div>
                @foreach (var n in a.Items)
                {
                    <a class="crv-navlink @(IsActive(n) ? "active" : "")" href="@n.Href" aria-current="@(IsActive(n) ? "page" : null)">
                        <i class="bi @n.Icon"></i>@n.Label
                    </a>
                }
            </nav>
        }
    </aside>

    <div class="crv-main">
        <partial name="_EngineBar" />

        @if (currentArea.Items != null)
        {
            <nav class="crv-subnav" aria-label="@currentArea.Label pages">
                @foreach (var n in currentArea.Items)
                {
                    <a class="crv-chip @(IsActive(n) ? "active" : "")" href="@n.Href" aria-current="@(IsActive(n) ? "page" : null)">@n.Label</a>
                }
            </nav>
        }

        <main class="crv-content">
            @RenderBody()
        </main>
        <footer class="crv-foot">&copy; @DateTime.Now.Year CRV Trading</footer>
    </div>
</div>

<nav class="crv-tabs" aria-label="Sections">
    @foreach (var t in tabs)
    {
        <a class="crv-tab @(t.Active ? "active" : "")" href="@t.Href" aria-current="@(t.Active ? "page" : null)"><i class="bi @t.Icon"></i>@t.Label</a>
    }
</nav>

@Html.AntiForgeryToken()

<partial name="_OrderTicket" />

<div class="modal fade c-sheet" id="flatten-sheet" tabindex="-1" aria-labelledby="flatten-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="flatten-title">Flatten everything?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="flatten-body" aria-live="polite"></div>
            <div class="modal-footer" id="flatten-foot">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep positions</button>
                <button type="button" class="c-hold" id="flatten-hold" disabled><i></i><span>Hold to flatten</span></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade crv-confirm" id="crv-confirm" tabindex="-1" aria-labelledby="crv-confirm-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="crv-confirm-title">Confirm</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="crv-confirm-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="crv-confirm-cancel">Cancel</button>
                <button type="button" class="btn btn-warning" id="crv-confirm-ok">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script src="~/js/crv-ui.js" asp-append-version="true"></script>
<script src="~/js/crv-instruments.js" asp-append-version="true"></script>
<script src="~/js/crv-ticket.js" asp-append-version="true"></script>
<script src="~/js/crv-hub.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

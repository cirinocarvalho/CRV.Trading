@page "/dashboard/sessions"
@model CRV.Web.Pages.Dashboard.SessionsModel
@using CRV.Web.Pages
@{
    ViewData["Title"] = "Sessions";
    ViewData["Page"]  = "sessions";
    ViewData["LightReady"] = true;

    string Href(DateOnly d, string? s = null) => $"?date={d:yyyy-MM-dd}" + (s != null ? $"&s={s}" : "");
}

<div class="c-head">
    <h1>Sessions</h1>
    <span class="c-sub">@Model.Day.ToString("ddd MMM d, yyyy")@(Model.IsToday ? " · today" : "") · live and paper</span>
    <div class="c-acts">
        <a class="btn btn-sm btn-outline-secondary" href="@Href(Model.Day.AddDays(-1))" aria-label="Previous trading day"><i class="bi bi-chevron-left"></i></a>
        <form method="get" class="d-inline-flex">
            <input type="date" name="date" value="@Model.Day.ToString("yyyy-MM-dd")" class="form-control form-control-sm c-select"
                   aria-label="Trading day" onchange="this.form.submit()" />
        </form>
        <a class="btn btn-sm btn-outline-secondary" href="@Href(Model.Day.AddDays(1))" aria-label="Next trading day"><i class="bi bi-chevron-right"></i></a>
        @if (!Model.IsToday)
        {
            <a class="btn btn-sm btn-link" href="?">Today</a>
        }
    </div>
</div>

<nav class="c-seg mb-3" aria-label="Session">
    @foreach (var s in CRV.Web.Pages.Dashboard.SessionsModel.SessionOrder)
    {
        <a href="@Href(Model.Day, s)" class="@(Model.Session == s ? "active" : "")" aria-current="@(Model.Session == s ? "page" : null)">
            @s <span class="c-mut num">@Model.Counts[s]</span>
        </a>
    }
</nav>

<partial name="_ResultsView" model="@(new ResultsViewModel(Model.Result, $"session-{Model.Day:yyyy-MM-dd}-{Model.Session}", ShowSource: true,
    EmptyTitle: $"No {Model.Session} trades", EmptyText: "Nothing traded in this session on this day."))" />

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/crv-results.js" asp-append-version="true"></script>
}

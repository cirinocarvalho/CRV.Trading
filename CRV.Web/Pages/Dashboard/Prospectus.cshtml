@page "/dashboard/prospectus"
@model CRV.Web.Pages.Dashboard.ProspectusModel
@{
    ViewData["Title"] = "Plan for today";
    ViewData["Page"]  = "prospectus";
    ViewData["Section"] = "futures";
    ViewData["LightReady"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";

    string Dol(decimal v) => v == 0 ? "—" : "$" + v.ToString("N0");
    string Orb(decimal v) => v == 0 ? "—" : v.ToString("F2");
    string Up(decimal v) => v > 0 ? "c-up" : "";
    string Down(decimal v) => v > 0 ? "c-down" : "";
    string Ratio(decimal p, decimal r) => r > 0 && p > 0 ? (p / r).ToString("F2") + "×" : "—";
    var month = DateTime.UtcNow.ToString("MMMM");
    var dayLabel = Model.IsLive ? "Today" : Model.SelectedDateLabel;
}

<div class="c-head">
    <h1>Plan for today</h1>
    <span class="c-sub">@(Model.IsLive ? "Today, live opening ranges" : Model.SelectedDateLabel) · vs @month average</span>
    <div class="c-acts">
        <form method="get" class="d-inline-flex">
            <input type="date" name="date" value="@Model.SelectedDate" class="form-control form-control-sm c-select" aria-label="Day" onchange="this.form.submit()" />
        </form>
        @if (!Model.IsLive)
        {
            <a href="/dashboard/prospectus" class="btn btn-sm btn-outline-secondary"><i class="bi bi-broadcast me-1"></i>Today</a>
        }
    </div>
</div>

<p class="c-mut c-plain mb-3">
    What each switched-on setup risks and could make if it fires once, sized from the opening range.
    @(Model.IsLive ? "Today's ranges come from the running engine and fill in as each session's range forms." : $"Ranges are the ones saved on {Model.SelectedDateLabel}.")
</p>

@if (Model.Sessions.Count == 0)
{
    <div class="c-panel c-empty">
        <i class="bi bi-calendar-check"></i>
        <b>No setups switched on</b>
        <span>Turn strategies on in <a href="/setup/strategies">Strategies</a> and they appear here.</span>
    </div>
}
else
{
    <section class="c-tiles mb-3" aria-label="Totals">
        <div class="c-tile"><small>@dayLabel · if targets hit</small><b class="@Up(Model.TotalProfitToday)">@Dol(Model.TotalProfitToday)</b></div>
        <div class="c-tile"><small>@dayLabel · if stops hit</small><b class="@Down(Model.TotalRiskToday)">@(Model.TotalRiskToday > 0 ? "−" : "")@Dol(Model.TotalRiskToday)</b></div>
        <div class="c-tile"><small>@month avg · targets</small><b>@Dol(Model.TotalProfitAvg)</b></div>
        <div class="c-tile"><small>@month avg · reward / risk</small><b>@Ratio(Model.TotalProfitAvg, Model.TotalRiskAvg)</b></div>
    </section>

    <div class="c-stack">
    @foreach (var session in Model.Sessions)
    {
        <section class="c-panel">
            <div class="c-panel-h">
                <h2>@session.SessionId · @session.Rows.Count setup@(session.Rows.Count == 1 ? "" : "s")</h2>
                <span class="c-right">@dayLabel <span class="@Up(session.TotalProfitToday)">@Dol(session.TotalProfitToday)</span> / <span class="@Down(session.TotalRiskToday)">@Dol(session.TotalRiskToday)</span></span>
            </div>

            <div class="c-trades-table c-table-wrap">
                <table class="c-table">
                    <thead>
                        <tr>
                            <th>Setup</th><th>Instrument</th><th class="r">Contracts</th><th class="r">Target / stop</th>
                            <th class="r">ORB @dayLabel.ToLowerInvariant()</th><th class="r">Profit</th><th class="r">Risk</th><th class="r">R:R</th>
                            <th class="r">ORB @month avg</th><th class="r">Profit avg</th><th class="r">Risk avg</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in session.Rows)
                    {
                        <tr>
                            <td class="t"><b>@r.SetupLabel</b> <span class="c-mut small">@r.StrategyType</span></td>
                            <td>@r.Ticker <span class="c-mut small">$@r.PointValue/pt</span></td>
                            <td class="r">@r.Contracts@(r.UsePartial ? $" ({r.PartialCts}+{r.RemainCts})" : "")</td>
                            <td class="r">@((r.TargetPct * 100).ToString("F0"))% / @((r.StopPct * 100).ToString("F0"))%</td>
                            <td class="r">@Orb(r.OrbRange)</td>
                            <td class="r @Up(r.ProfitUsd)" title="Target 1 @Dol(r.Tgt1Usd) + target 2 @Dol(r.Tgt2Usd)"><b>@Dol(r.ProfitUsd)</b></td>
                            <td class="r @Down(r.RiskUsd)">@Dol(r.RiskUsd)</td>
                            <td class="r">@Ratio(r.ProfitUsd, r.RiskUsd)</td>
                            <td class="r c-mut">@Orb(r.AvgOrbRange)</td>
                            <td class="r c-mut" title="Target 1 @Dol(r.AvgTgt1Usd) + target 2 @Dol(r.AvgTgt2Usd)">@Dol(r.AvgProfitUsd)</td>
                            <td class="r c-mut">@Dol(r.AvgRiskUsd)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="c-trades-cards">
                @foreach (var r in session.Rows)
                {
                    <details class="c-tcard">
                        <summary>
                            <span class="s"></span>
                            <span><b>@r.SetupLabel</b><small>@r.Ticker · @r.Contracts cts · ORB @Orb(r.OrbRange)</small></span>
                            <span class="rr"><span class="@Up(r.ProfitUsd)">@Dol(r.ProfitUsd)</span><small>risk @Dol(r.RiskUsd)</small></span>
                        </summary>
                        <div class="d">
                            <div><span>Type</span><b>@r.StrategyType</b></div>
                            <div><span>Target / stop</span><b>@((r.TargetPct * 100).ToString("F0"))% / @((r.StopPct * 100).ToString("F0"))%</b></div>
                            <div><span>Target 1</span><b>@Dol(r.Tgt1Usd)</b></div>
                            <div><span>Target 2</span><b>@Dol(r.Tgt2Usd)</b></div>
                            <div><span>R:R</span><b>@Ratio(r.ProfitUsd, r.RiskUsd)</b></div>
                            <div><span>Point value</span><b>$@r.PointValue</b></div>
                            <div><span>@month avg ORB</span><b>@Orb(r.AvgOrbRange)</b></div>
                            <div><span>Avg profit / risk</span><b>@Dol(r.AvgProfitUsd) / @Dol(r.AvgRiskUsd)</b></div>
                        </div>
                    </details>
                }
            </div>
        </section>
    }
    </div>

    <p class="c-mut small mt-3">
        Assumes every switched-on setup fires once per session. Profit is target 1 on the partial plus target 2 on the rest;
        risk is stop distance × point value × all contracts. The @month average uses the opening ranges saved this month.
    </p>
}

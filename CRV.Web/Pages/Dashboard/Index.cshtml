@page "/dashboard"
@model CRV.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Page"]  = "dashboard";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- ── Top bar: Ticker + time + DD status + stream health ──── -->
<div class="d-flex align-items-center gap-3 mb-3">
    <h5 class="mb-0 font-monospace text-warning" id="dash-ticker">@Model.Config.Ticker</h5>
    @if (Model.IsNearRoll)
    {
        <span class="badge bg-warning text-dark" title="Contract is near quarterly roll date. Active front-month: @Model.ActiveContract">
            <i class="bi bi-exclamation-triangle me-1"></i>ROLL SOON → @Model.ActiveContract
        </span>
    }
    <span class="badge bg-dark border border-secondary font-monospace" id="dash-time">--:--:-- ET</span>
    <span class="badge" id="dash-dd-badge">OK</span>
    <span class="badge setup-idle" id="dash-session-badge">—</span>
    <span id="sessionBadge" class="badge bg-secondary ms-2">--</span>
    <!-- Stream health indicator -->
    <span class="d-flex align-items-center gap-1 ms-2" id="stream-health" title="WebSocket stream status">
        <span class="stream-dot" id="stream-dot"></span>
        <span class="font-monospace text-light small" id="stream-price">—</span>
        <span class="text-muted small" id="stream-age"></span>
    </span>
    <span class="ms-auto text-muted small">Execution TF: <strong class="text-light">@Model.Config.ExecutionTFMinutes min</strong>
        &nbsp;|&nbsp; ORB: <strong class="text-light">@Model.Config.OrbStart.ToString("HH:mm")–@Model.Config.OrbEnd.ToString("HH:mm")</strong></span>
</div>

<!-- ── Row 1: Daily stats ────────────────────────────────────── -->
<div class="row g-3 mb-3 stat-card-row">
    <div class="col-6 col-md-3 col-lg-2">
        <div class="card p-3 text-center">
            <div class="stat-label">Today P&L</div>
            <div class="stat-value font-monospace" id="stat-today-pnl">$0</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <div class="card p-3 text-center">
            <div class="stat-label">WIN RATE</div>
            <svg id="wr-gauge" viewBox="0 0 120 85" style="width:100%;max-width:120px;margin:4px auto 0">
                <path d="M 10 65 A 50 50 0 0 1 110 65" fill="none" stroke="#333" stroke-width="10" stroke-linecap="round"/>
                <path id="wr-gauge-arc" d="M 10 65 A 50 50 0 0 1 110 65" fill="none" stroke="#22c55e" stroke-width="10" stroke-linecap="round" stroke-dasharray="0 157"/>
                <text id="wr-gauge-text" x="60" y="55" text-anchor="middle" fill="#e5e5e5" font-size="18" font-weight="bold" font-family="monospace">—</text>
                <text id="wr-gauge-detail" x="60" y="72" text-anchor="middle" fill="#888" font-size="9" font-family="monospace">0W / 0L</text>
            </svg>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <div class="card p-3 text-center">
            <div class="stat-label">Trades</div>
            <div class="stat-value" id="stat-trades">0</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <div class="card p-3 text-center">
            <div class="stat-label">Max DD</div>
            <div class="stat-value text-warning font-monospace" id="stat-maxdd">$0</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <div class="card p-3 text-center" title="E = (Win% × AvgWin) − (Loss% × AvgLoss)">
            <div class="stat-label">Expectancy</div>
            <div class="stat-value font-monospace" id="stat-expectancy">—</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <div class="card p-3 text-center">
            <div class="stat-label">DAILY LOSS LIMIT</div>
            <svg id="dd-gauge" viewBox="0 0 120 85" style="width:100%;max-width:120px;margin:4px auto 0">
                <!-- background arc (grey) -->
                <path d="M 10 65 A 50 50 0 0 1 110 65" fill="none" stroke="#333" stroke-width="10" stroke-linecap="round"/>
                <!-- foreground arc (colored) -->
                <path id="dd-gauge-arc" d="M 10 65 A 50 50 0 0 1 110 65" fill="none" stroke="#22c55e" stroke-width="10" stroke-linecap="round" stroke-dasharray="0 157"/>
                <!-- percentage text -->
                <text id="dd-gauge-text" x="60" y="55" text-anchor="middle" fill="#e5e5e5" font-size="18" font-weight="bold" font-family="monospace">0%</text>
                <!-- used / limit amounts -->
                <text id="dd-gauge-amounts" x="60" y="72" text-anchor="middle" fill="#888" font-size="9" font-family="monospace">$0 / $@(((int)Model.Config.MaxDailyLoss).ToString("N0"))</text>
            </svg>
        </div>
    </div>
</div>

<!-- ── Row 2: Setup A + B + C ──────────────────────────────── -->
<div class="row g-3 mb-3">
    <!-- Setup A -->
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-triangle-fill text-warning"></i>
                <span class="fw-bold text-warning">Setup A — Pullback [XACUZZY]</span>
                <span class="badge" id="enabled-a">ON</span>
                <span class="badge ms-auto" id="status-a">IDLE</span>
                <span class="text-muted small" id="count-a">[0/@Model.Config.MaxTradesA]</span>
                <button id="btn-exit-a" class="btn btn-danger btn-sm d-none py-0 px-2"
                        onclick="forceExit('A')" title="Force exit Setup A at market">
                    <i class="bi bi-x-octagon-fill me-1"></i>Exit Now
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 trade-table" id="table-a">
                    <tbody>
                        <tr><td class="text-muted" style="width:45%">Direction</td><td id="a-dir">—</td></tr>
                        <tr><td class="text-muted">Entry</td><td id="a-entry" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Stop</td><td id="a-stop" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Partial (50%)</td><td id="a-partial" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Target</td><td id="a-target" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Contracts</td><td id="a-cts" class="font-monospace">—</td></tr>
                        <tr title="E = (Win% × AvgWin) − (Loss% × AvgLoss)"><td class="text-muted">Expectancy</td><td id="a-expectancy" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted fw-bold">Unrealized P&L</td><td id="a-unreal" class="font-monospace fw-bold">—</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Setup B -->
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-arrow-up-right-circle-fill text-warning"></i>
                <span class="fw-bold text-warning">Setup B — Breakout [BONGA]</span>
                <span class="badge" id="enabled-b">ON</span>
                <span class="badge ms-auto" id="status-b">IDLE</span>
                <span class="text-muted small" id="count-b">[0/@Model.Config.MaxTradesB]</span>
                <button id="btn-exit-b" class="btn btn-danger btn-sm d-none py-0 px-2"
                        onclick="forceExit('B')" title="Force exit Setup B at market">
                    <i class="bi bi-x-octagon-fill me-1"></i>Exit Now
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 trade-table" id="table-b">
                    <tbody>
                        <tr><td class="text-muted" style="width:45%">Direction</td><td id="b-dir">—</td></tr>
                        <tr><td class="text-muted">Entry</td><td id="b-entry" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Stop</td><td id="b-stop" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Partial (50%)</td><td id="b-partial" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Target</td><td id="b-target" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Contracts</td><td id="b-cts" class="font-monospace">—</td></tr>
                        <tr title="E = (Win% × AvgWin) − (Loss% × AvgLoss)"><td class="text-muted">Expectancy</td><td id="b-expectancy" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted fw-bold">Unrealized P&L</td><td id="b-unreal" class="font-monospace fw-bold">—</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Setup C -->
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-arrow-repeat text-warning"></i>
                <span class="fw-bold text-warning">Setup C — Sweep Reversal</span>
                <span class="badge" id="enabled-c">ON</span>
                <span class="badge ms-auto" id="status-c">IDLE</span>
                <span class="text-muted small" id="count-c">[0/@Model.Config.MaxTradesC]</span>
                <button id="btn-exit-c" class="btn btn-danger btn-sm d-none py-0 px-2"
                        onclick="forceExit('C')" title="Force exit Setup C at market">
                    <i class="bi bi-x-octagon-fill me-1"></i>Exit Now
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 trade-table" id="table-c">
                    <tbody>
                        <tr><td class="text-muted" style="width:45%">Direction</td><td id="c-dir">—</td></tr>
                        <tr><td class="text-muted">Entry</td><td id="c-entry" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Stop</td><td id="c-stop" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Partial (50%)</td><td id="c-partial" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Target</td><td id="c-target" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Contracts</td><td id="c-cts" class="font-monospace">—</td></tr>
                        <tr title="E = (Win% × AvgWin) − (Loss% × AvgLoss)"><td class="text-muted">Expectancy</td><td id="c-expectancy" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted fw-bold">Unrealized P&L</td><td id="c-unreal" class="font-monospace fw-bold">—</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ── Row 3: Setup D + F + Context ────────────────────────── -->
<div class="row g-3 mb-3">
    <!-- Setup D -->
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-lightning-fill text-warning"></i>
                <span class="fw-bold text-warning">Setup D — Drive Pullback</span>
                <span class="badge" id="enabled-d">ON</span>
                <span class="badge ms-auto" id="status-d">IDLE</span>
                <span class="text-muted small" id="count-d">[0/@Model.Config.MaxTradesD]</span>
                <button id="btn-exit-d" class="btn btn-danger btn-sm d-none py-0 px-2"
                        onclick="forceExit('D')" title="Force exit Setup D at market">
                    <i class="bi bi-x-octagon-fill me-1"></i>Exit Now
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 trade-table" id="table-d">
                    <tbody>
                        <tr><td class="text-muted" style="width:45%">Direction</td><td id="d-dir">—</td></tr>
                        <tr><td class="text-muted">Entry</td><td id="d-entry" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Stop</td><td id="d-stop" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Partial (50%)</td><td id="d-partial" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Target</td><td id="d-target" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Contracts</td><td id="d-cts" class="font-monospace">—</td></tr>
                        <tr title="E = (Win% × AvgWin) − (Loss% × AvgLoss)"><td class="text-muted">Expectancy</td><td id="d-expectancy" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted fw-bold">Unrealized P&L</td><td id="d-unreal" class="font-monospace fw-bold">—</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Setup F -->
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-graph-down-arrow text-warning"></i>
                <span class="fw-bold text-warning">Setup F — VWAP Reversion</span>
                <span class="badge" id="enabled-f">ON</span>
                <span class="badge ms-auto" id="status-f">IDLE</span>
                <span class="text-muted small" id="count-f">[0/@Model.Config.MaxTradesF]</span>
                <button id="btn-exit-f" class="btn btn-danger btn-sm d-none py-0 px-2"
                        onclick="forceExit('F')" title="Force exit Setup F at market">
                    <i class="bi bi-x-octagon-fill me-1"></i>Exit Now
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 trade-table" id="table-f">
                    <tbody>
                        <tr><td class="text-muted" style="width:45%">Direction</td><td id="f-dir">—</td></tr>
                        <tr><td class="text-muted">Entry</td><td id="f-entry" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Stop</td><td id="f-stop" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Partial (50%)</td><td id="f-partial" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Target</td><td id="f-target" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted">Contracts</td><td id="f-cts" class="font-monospace">—</td></tr>
                        <tr title="E = (Win% × AvgWin) − (Loss% × AvgLoss)"><td class="text-muted">Expectancy</td><td id="f-expectancy" class="font-monospace">—</td></tr>
                        <tr><td class="text-muted fw-bold">Unrealized P&L</td><td id="f-unreal" class="font-monospace fw-bold">—</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Session / Trend / Active Setup -->
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-clipboard-data text-warning"></i>
                <span class="fw-bold text-warning">Market Context</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 trade-table">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width:45%">Session</td>
                            <td id="stat-session" class="font-monospace">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Session Range</td>
                            <td id="stat-session-range" class="font-monospace small">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Trend Score</td>
                            <td>
                                <span class="font-monospace"><span class="text-success">▲</span> <span id="stat-trend-bull">0</span></span>
                                <span class="font-monospace ms-2"><span class="text-danger">▼</span> <span id="stat-trend-bear">0</span></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Trend Day</td>
                            <td id="stat-trend-label" class="font-monospace">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted">VWAP State</td>
                            <td><span id="stat-vwap-state" class="font-monospace">—</span> <span id="stat-vwap-bands" class="font-monospace small text-muted"></span></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Active Setup</td>
                            <td id="stat-active-setup" class="font-monospace">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Signals</td>
                            <td id="stat-sweep-info" class="font-monospace small">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Signal Strength</td>
                            <td>
                                <span id="stat-signal-strength" class="font-monospace fw-bold">—</span>
                                <span class="font-monospace text-muted small ms-1">
                                    D:<span id="stat-drive-score">0</span>
                                    S:<span id="stat-sweep-score">0</span>
                                    V:<span id="stat-vwap-dev-score">0</span>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ── Row 4: ORB + VWAP + ATR ──────────────────────────────── -->
<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card p-3 text-center">
            <div class="stat-label">ORB Quality</div>
            <div class="d-flex justify-content-center gap-3 font-monospace" style="font-size:1.1rem; font-weight:700">
                <span>H: <span id="orb-high" class="text-warning">—</span></span>
                <span>L: <span id="orb-low" class="text-warning">—</span></span>
                <span>M: <span id="orb-mid" class="text-secondary">—</span></span>
                <span>R: <span id="orb-range" class="text-light">—</span></span>
            </div>
            <div class="small">
                <span class="badge" id="orb-quality-badge">Building...</span>
                <span class="badge ms-1" id="orb-close-badge">—</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg-4">
        <div class="card p-3 text-center">
            <div class="stat-label">VWAP</div>
            <div class="stat-value font-monospace" id="stat-vwap" style="font-size:1.1rem">—</div>
            <div class="small" id="stat-vwap-pos">—</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg-4">
        <div class="card p-3 text-center">
            <div class="stat-label">ATR(14)</div>
            <div class="stat-value font-monospace" id="stat-atr" style="font-size:1.1rem">—</div>
            <div class="small text-muted" id="stat-orb-atr-ratio">vs ORB —</div>
        </div>
    </div>
</div>

<!-- ── Row 5: Alerts feed + Today's trades ───────────────────── -->
<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <i class="bi bi-broadcast me-2 text-success"></i>
                <span class="fw-bold">Alerts Feed</span>
                <button class="btn btn-sm btn-outline-secondary ms-auto" onclick="clearAlerts()">Clear</button>
            </div>
            <div class="alert-feed p-0" id="alert-feed">
                <div class="alert-item info" data-placeholder>
                    <span class="text-muted">--:--:--</span> Waiting for engine...
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                <i class="bi bi-list-ul me-2 text-info"></i>
                <span class="fw-bold">Today's Trades</span>
                <span class="badge bg-dark ms-2 font-monospace" id="today-trade-count">0 trades</span>
            </div>
            <div style="overflow-x:auto; max-height:320px; overflow-y:auto;">
                <table class="table table-sm mb-0 trade-table">
                    <thead>
                        <tr>
                            <th>Time</th><th>Setup</th><th>Dir</th>
                            <th>Entry</th><th>Exit</th><th>Reason</th><th>Net P&L</th><th>R</th>
                        </tr>
                    </thead>
                    <tbody id="trade-tbody">
                        <tr><td colspan="8" class="text-center text-muted py-3">No trades today</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@Html.AntiForgeryToken()
<script>
// ─────────────────────────────────────────────────────────────
// Dashboard JavaScript — subscribes to crv:update / crv:alert
// events dispatched by crv-hub.js when SignalR messages arrive.
// All property names match EngineSnapshot JSON (camelCase).
// ─────────────────────────────────────────────────────────────

const maxDailyLoss = @Model.Config.MaxDailyLoss.ToString(System.Globalization.CultureInfo.InvariantCulture);
let _lastAlertCount = 0;  // track how many alerts we've already rendered

// Seed ON/OFF badges from server-rendered config before first SignalR snapshot
(function () {
    const aOn = @(Model.Config.EnableA ? "true" : "false");
    const bOn = @(Model.Config.EnableB ? "true" : "false");
    const cOn = @(Model.Config.EnableC ? "true" : "false");
    const dOn = @(Model.Config.EnableD ? "true" : "false");
    const fOn = @(Model.Config.EnableF ? "true" : "false");
    var flags = { a: aOn, b: bOn, c: cOn, d: dOn, f: fOn };
    ["a","b","c","d","f"].forEach(id => {
        const el = document.getElementById("enabled-" + id);
        if (!el) return;
        const on = flags[id];
        el.textContent = on ? "ON" : "OFF";
        el.className   = "badge " + (on ? "bg-success" : "bg-secondary");
        if (!on) {
            const card = el.closest(".card");
            if (card) card.style.opacity = "0.45";
        }
    });
}());

document.addEventListener("crv:update", e => updateDashboard(e.detail));
document.addEventListener("crv:alert",  e => addAlert(e.detail));
document.addEventListener("crv:trade",  e => addTradeRow(e.detail));

// ── Load today's trades on page load and compute DB-based stats ──
// These stats survive engine restarts — the engine snapshot may show 0
// after a restart, but the DB trades are still there.
var _dbStats = { pnl: 0, wins: 0, losses: 0, maxDD: 0, trades: 0, winPnl: 0, lossPnl: 0 };
var _dbSetupCounts = { A: 0, B: 0, C: 0, D: 0, F: 0 };
fetch('/api/engine/trades/today')
    .then(r => r.json())
    .then(trades => {
        if (!trades.length) return;
        trades.reverse().forEach(addTradeRow);
        // Compute stats from DB trades
        var peak = 0, runPnl = 0, maxDD = 0;
        for (const t of trades) {
            var net = t.netPnl ?? 0;
            _dbStats.pnl += net;
            _dbStats.trades++;
            if (net > 0) { _dbStats.wins++; _dbStats.winPnl += net; }
            else if (net < 0) { _dbStats.losses++; _dbStats.lossPnl += net; }
            runPnl += net;
            if (runPnl > peak) peak = runPnl;
            var dd = peak - runPnl;
            if (dd > maxDD) maxDD = dd;
        }
        _dbStats.maxDD = maxDD;
        // Count trades per setup from DB
        for (const t of trades) {
            var s = (t.setup ?? "").toUpperCase();
            if (s in _dbSetupCounts) _dbSetupCounts[s]++;
        }
        // Apply DB stats immediately so cards aren't blank
        _applyDbStats();
    })
    .catch(() => {});

function _applyDbStats() {
    var s = _dbStats;
    if (s.trades === 0) return;
    setText("stat-today-pnl", fmtDol(s.pnl), pnlCls(s.pnl));
    setText("stat-trades", s.trades);
    setText("stat-maxdd", "$" + Math.abs(s.maxDD).toFixed(0));
    var total = s.wins + s.losses;
    var exp = total > 0 ? (s.wins / total) * (s.winPnl / Math.max(s.wins,1))
                        - (s.losses / total) * Math.abs(s.lossPnl / Math.max(s.losses,1)) : 0;
    setText("stat-expectancy", exp ? fmtDol(exp) : "—", exp ? pnlCls(exp) : "stat-value font-monospace");
    // Win rate gauge
    var wrArc = document.getElementById("wr-gauge-arc");
    var wrText = document.getElementById("wr-gauge-text");
    var wrDetail = document.getElementById("wr-gauge-detail");
    if (wrArc && wrText && total > 0) {
        var wrPct = Math.round(s.wins / total * 100);
        var arcLen = 157, fill = Math.min(wrPct, 100) / 100 * arcLen;
        wrArc.setAttribute("stroke-dasharray", fill + " " + arcLen);
        var color = wrPct >= 60 ? "#22c55e" : wrPct >= 40 ? "#eab308" : "#ef4444";
        wrArc.setAttribute("stroke", color);
        wrText.textContent = wrPct + "%";
        if (wrDetail) wrDetail.textContent = s.wins + "W / " + s.losses + "L";
    }
    // Per-setup trade counts
    ["a","b","c","d","f"].forEach(id => {
        var el = document.getElementById("count-" + id);
        if (el) {
            var cnt = _dbSetupCounts[id.toUpperCase()] ?? 0;
            var cur = el.textContent.match(/\/(\d+)/);
            var max = cur ? cur[1] : "?";
            el.textContent = "[" + cnt + "/" + max + "]";
        }
    });
}

// Show engine status changes in the alert feed and clear the placeholder
document.addEventListener("crv:status", e => {
    const status = e.detail;
    _clearPlaceholder();
    const isLive = status === "Live";
    const div = document.createElement("div");
    div.className = "alert-item " + (isLive ? "entry" : "info");
    div.innerHTML = `<span class="text-muted">${_etNow()}</span> Engine: <strong>${status}</strong>`;
    const feed = document.getElementById("alert-feed");
    if (feed) feed.insertBefore(div, feed.firstChild);
});

// ET clock + stream health age
let _lastUpdateMs = 0;
setInterval(() => {
    document.getElementById("dash-time").textContent = _etNow() + " ET";
    // Update stream age indicator
    if (_lastUpdateMs > 0) {
        const ageSec = Math.floor((Date.now() - _lastUpdateMs) / 1000);
        const dot = document.getElementById("stream-dot");
        const ageEl = document.getElementById("stream-age");
        if (dot) {
            if (ageSec <= 60)       dot.className = "stream-dot live";
            else if (ageSec <= 300) dot.className = "stream-dot stale";
            else                    dot.className = "stream-dot";
        }
        if (ageEl) {
            if (ageSec < 5) ageEl.textContent = "";
            else if (ageSec < 60) ageEl.textContent = ageSec + "s ago";
            else if (ageSec < 3600) ageEl.textContent = Math.floor(ageSec / 60) + "m ago";
            else ageEl.textContent = Math.floor(ageSec / 3600) + "h ago";
        }
    }
}, 1000);

// ── Helpers ───────────────────────────────────────────────────
function _etNow() {
    return new Date().toLocaleTimeString("en-US", { timeZone: "America/New_York", hour12: false });
}
function _clearPlaceholder() {
    document.querySelector("#alert-feed [data-placeholder]")?.remove();
}
function fmtDol(v) {
    if (v == null) return "—";
    const s = Math.abs(v).toLocaleString("en-US", { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    return (v >= 0 ? "+$" : "−$") + s;
}
function pnlCls(v) { return "stat-value font-monospace " + (v > 0 ? "pnl-pos" : v < 0 ? "pnl-neg" : "pnl-zero"); }
function setText(id, text, cls) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = text ?? "—";
    if (cls != null) el.className = cls;
}

// ── Main update ───────────────────────────────────────────────
function updateDashboard(d) {
    if (!d) return;
    _clearPlaceholder();   // remove "Waiting for engine..." on first live snapshot

    // ── Stream health ─────────────────────────────────────────
    if (d.lastPrice > 0) setText("stream-price", d.lastPrice.toFixed(2));
    if (d.lastUpdate) {
        _lastUpdateMs = new Date(d.lastUpdate).getTime();
        // If server sends UTC without Z suffix, handle it
        if (_lastUpdateMs < Date.now() - 86400000) _lastUpdateMs = Date.now();
    } else {
        _lastUpdateMs = Date.now();
    }

    // ── Daily P&L stats ──────────────────────────────────────
    // Use the larger of engine vs DB stats to survive engine restarts.
    // After restart, engine starts at 0 but DB has all trades from today.
    // As the engine accumulates new trades, it will eventually catch up.
    const engineTrades = d.todayTrades ?? 0;
    const pnl    = engineTrades >= _dbStats.trades ? (d.todayPnl ?? 0) : _dbStats.pnl;
    const trades = Math.max(engineTrades, _dbStats.trades);
    const wins   = engineTrades >= _dbStats.trades ? (d.todayWins ?? 0) : _dbStats.wins;
    setText("stat-today-pnl", fmtDol(pnl), pnlCls(pnl));
    setText("stat-trades",  trades);
    // ── Win Rate gauge ──────────────────────────────────────
    const wrArc    = document.getElementById("wr-gauge-arc");
    const wrText   = document.getElementById("wr-gauge-text");
    const wrDetail = document.getElementById("wr-gauge-detail");
    if (wrArc && wrText) {
        const wrPct   = trades > 0 ? Math.round(wins / trades * 100) : 0;
        const arcLen  = 157;
        const fill    = trades > 0 ? Math.min(wrPct, 100) / 100 * arcLen : 0;
        wrArc.setAttribute("stroke-dasharray", fill + " " + arcLen);
        const color = wrPct >= 60 ? "#22c55e" : wrPct >= 40 ? "#eab308" : trades > 0 ? "#ef4444" : "#333";
        wrArc.setAttribute("stroke", color);
        wrText.textContent = trades > 0 ? wrPct + "%" : "—";
        if (wrDetail) {
            const losses = trades - wins;
            wrDetail.textContent = wins + "W / " + losses + "L";
        }
    }
    const maxdd = engineTrades >= _dbStats.trades ? (d.todayMaxDD ?? 0) : _dbStats.maxDD;
    setText("stat-maxdd",   "$" + Math.abs(maxdd).toFixed(0));

    // Expectancy — show "—" when 0 (no trades yet for that scope)
    setText("stat-expectancy", d.expectancy ? fmtDol(d.expectancy) : "—",
            d.expectancy ? pnlCls(d.expectancy) : "stat-value font-monospace");
    setText("a-expectancy", d.expectancyA ? fmtDol(d.expectancyA) : "—",
            d.expectancyA ? pnlCls(d.expectancyA) + " font-monospace" : "font-monospace");
    setText("b-expectancy", d.expectancyB ? fmtDol(d.expectancyB) : "—",
            d.expectancyB ? pnlCls(d.expectancyB) + " font-monospace" : "font-monospace");
    setText("c-expectancy", d.expectancyC ? fmtDol(d.expectancyC) : "—",
            d.expectancyC ? pnlCls(d.expectancyC) + " font-monospace" : "font-monospace");
    setText("d-expectancy", d.expectancyD ? fmtDol(d.expectancyD) : "—",
            d.expectancyD ? pnlCls(d.expectancyD) + " font-monospace" : "font-monospace");
    setText("f-expectancy", d.expectancyF ? fmtDol(d.expectancyF) : "—",
            d.expectancyF ? pnlCls(d.expectancyF) + " font-monospace" : "font-monospace");

    // ── DD Limit gauge ─────────────────────────────────────
    const ddUsed  = Math.min(Math.abs(pnl < 0 ? pnl : 0), maxDailyLoss);
    const ddPct   = maxDailyLoss > 0 ? Math.round(ddUsed / maxDailyLoss * 100) : 0;
    const ddArc   = document.getElementById("dd-gauge-arc");
    const ddText  = document.getElementById("dd-gauge-text");
    const ddGauge = document.getElementById("dd-gauge");
    const ddAmounts = document.getElementById("dd-gauge-amounts");
    if (ddArc && ddText) {
        const arcLen  = 157; // half-circle circumference for r=50
        const fill    = Math.min(ddPct, 100) / 100 * arcLen;
        ddArc.setAttribute("stroke-dasharray", fill + " " + arcLen);
        const color = ddPct >= 100 ? "#ef4444" : ddPct > 80 ? "#ef4444" : ddPct > 50 ? "#eab308" : "#22c55e";
        ddArc.setAttribute("stroke", color);
        ddText.textContent = ddPct + "%";
        ddText.setAttribute("fill", ddPct >= 100 ? "#ef4444" : "#e5e5e5");
        if (ddAmounts) {
            const usedStr  = "$" + Math.round(ddUsed).toLocaleString();
            const limitStr = "$" + Math.round(maxDailyLoss).toLocaleString();
            ddAmounts.textContent = usedStr + " / " + limitStr;
        }
        // Flash when breached
        if (ddPct >= 100) {
            ddGauge.classList.add("dd-breached");
        } else {
            ddGauge.classList.remove("dd-breached");
        }
    }
    const ddBadge  = document.getElementById("dash-dd-badge");
    if (ddBadge) {
        const halted = d.tradingHalted ?? false;
        ddBadge.textContent = halted ? "DD HALTED" : "OK";
        ddBadge.className   = "badge " + (halted ? "badge-halted" : "bg-success text-dark");
    }

    // ── Session state badge ──────────────────────────────────
    const sessBadge = document.getElementById("dash-session-badge");
    if (sessBadge) {
        if (d.sessionEnded)                        { sessBadge.textContent = "SESSION ENDED"; sessBadge.className = "badge badge-halted"; }
        else if (d.pastCutoffA && d.pastCutoffB)   { sessBadge.textContent = "CUTOFF";        sessBadge.className = "badge setup-armed"; }
        else if (d.pastCutoffA)                    { sessBadge.textContent = "CUTOFF (A)";    sessBadge.className = "badge setup-armed"; }
        else if (d.pastCutoffB)                    { sessBadge.textContent = "CUTOFF (B)";    sessBadge.className = "badge setup-armed"; }
        else if (d.orbFormed)                      { sessBadge.textContent = "TRADING";       sessBadge.className = "badge badge-live"; }
        else                                       { sessBadge.textContent = "ORB FORMING";   sessBadge.className = "badge setup-idle"; }
    }

    // ── Active session badge (Asia / London / NY / Idle) ─────
    const badge = document.getElementById('sessionBadge');
    if (badge) {
        if (d.activeSessionId) {
            badge.textContent = d.activeSessionId + ' Session';
            badge.className = 'badge bg-success ms-2';
        } else {
            badge.textContent = 'Idle';
            badge.className = 'badge bg-secondary ms-2';
        }
    }

    // ── Setup panels ─────────────────────────────────────────
    // d.setupA / d.setupB are ActiveTradeView objects (null when idle/armed/retest)
    updateSetup("a", d.setupA, d.setupAState, d.setupAEnabled !== false, d.pastCutoffA, d.sessionEnded);
    updateSetup("b", d.setupB, d.setupBState, d.setupBEnabled !== false, d.pastCutoffB, d.sessionEnded);

    // ── ORB ──────────────────────────────────────────────────
    setText("orb-high",  d.orbHigh  > 0 ? d.orbHigh.toFixed(2)  : "—");
    setText("orb-low",   d.orbLow   > 0 ? d.orbLow.toFixed(2)   : "—");
    setText("orb-mid",   d.orbMid   > 0 ? d.orbMid.toFixed(2)   : "—");
    setText("orb-range", d.orbRange > 0 ? d.orbRange.toFixed(2) + " pts" : "—");

    const orbQuality = document.getElementById("orb-quality-badge");
    if (orbQuality) {
        if (d.orbRange > 0) {
            orbQuality.textContent = d.orbBullClose ? "Bull Close" : d.orbBearClose ? "Bear Close" : "Neutral";
            orbQuality.className   = "badge " + (d.orbBullClose ? "bg-success" : d.orbBearClose ? "bg-danger" : "bg-secondary");
        } else {
            orbQuality.textContent = "Building...";
            orbQuality.className   = "badge bg-secondary";
        }
    }

    // ── VWAP / ATR ───────────────────────────────────────────
    setText("stat-vwap", d.vwap > 0 ? d.vwap.toFixed(2) : "—");
    if (d.vwap > 0 && d.lastPrice > 0) {
        const above = d.lastPrice > d.vwap;
        setText("stat-vwap-pos", above ? "Above VWAP" : "Below VWAP",
            "small " + (above ? "pnl-pos" : "pnl-neg"));
    }
    setText("stat-atr",  d.atr  > 0 ? d.atr.toFixed(2)  : "—");
    if (d.orbAtrRatio > 0)
        setText("stat-orb-atr-ratio", "vs ORB " + d.orbAtrRatio.toFixed(2) + "x");

    // ── Module outputs ───────────────────────────────────────
    setText("stat-session", d.currentSession || "—");
    if (d.sessionHigh > 0)
        setText("stat-session-range",
            "H: " + d.sessionHigh.toFixed(2) + " L: " + (d.sessionLow > 0 ? d.sessionLow.toFixed(2) : "—"));

    // VWAP state
    var vwapLabels = { "2": "Extended▲", "1": "Accept▲", "0": "Neutral", "-1": "Accept▼", "-2": "Extended▼" };
    var vwapColors = { "2": "pnl-pos", "1": "pnl-pos", "0": "", "-1": "pnl-neg", "-2": "pnl-neg" };
    setText("stat-vwap-state", vwapLabels[String(d.vwapState)] || "—", vwapColors[String(d.vwapState)] || "");
    if (d.vwapUpper1 > 0)
        setText("stat-vwap-bands",
            "±1σ: " + d.vwapUpper1.toFixed(1) + " / " + d.vwapLower1.toFixed(1));

    // Trend score
    setText("stat-trend-bull", d.trendScoreBull != null ? d.trendScoreBull : 0);
    setText("stat-trend-bear", d.trendScoreBear != null ? d.trendScoreBear : 0);
    var trendLabel = d.trendScoreBull >= 4 ? "TREND DAY ▲" : d.trendScoreBear >= 4 ? "TREND DAY ▼" : "Rotational";
    var trendClass = d.trendScoreBull >= 4 ? "pnl-pos" : d.trendScoreBear >= 4 ? "pnl-neg" : "text-muted";
    setText("stat-trend-label", trendLabel, "small " + trendClass);

    // Active setups
    var activeSetup = "—";
    if (d.setupCBull) activeSetup = "C ▲ Sweep Rev";
    else if (d.setupCBear) activeSetup = "C ▼ Sweep Rev";
    else if (d.setupDBull) activeSetup = "D ▲ Drive PB";
    else if (d.setupDBear) activeSetup = "D ▼ Drive PB";
    else if (d.setupFBull) activeSetup = "F ▲ VWAP Rev";
    else if (d.setupFBear) activeSetup = "F ▼ VWAP Rev";
    setText("stat-active-setup", activeSetup);

    // Sweep info + opening drive
    var infoStr = "";
    if (d.lastSweep) infoStr += d.lastSweep;
    if (d.openingDriveBull) infoStr += (infoStr ? " | " : "") + "Drive ▲";
    if (d.openingDriveBear) infoStr += (infoStr ? " | " : "") + "Drive ▼";
    if (d.asiaCompressed) infoStr += (infoStr ? " | " : "") + "Asia ◆";
    setText("stat-sweep-info", infoStr || "—", "small text-muted");

    // Signal Strength
    var ss = d.signalStrength != null ? d.signalStrength : 0;
    var ssColor = ss >= 4 ? "pnl-pos" : ss >= 2 ? "text-warning" : "text-muted";
    setText("stat-signal-strength", ss.toFixed(1) + " / 5", ssColor);
    setText("stat-drive-score", d.driveScore != null ? d.driveScore.toFixed(1) : "0");
    setText("stat-sweep-score", d.sweepScore != null ? d.sweepScore.toFixed(1) : "0");
    setText("stat-vwap-dev-score", d.vwapDevScore != null ? d.vwapDevScore.toFixed(1) : "0");

    // ── Setup C/D/F panels ────────────────────────────────────
    updateSetup("c", d.setupC, d.setupCState, d.setupCEnabled !== false, d.pastCutoffC, d.sessionEnded);
    updateSetup("d", d.setupD, d.setupDState, d.setupDEnabled !== false, d.pastCutoffD, d.sessionEnded);
    updateSetup("f", d.setupF, d.setupFState, d.setupFEnabled !== false, d.pastCutoffF, d.sessionEnded);

    // ── Per-setup trade counts [N/Max] ─────────────────────────
    ["a","b","c","d","f"].forEach(id => {
        var key = "tradeCount" + id.toUpperCase();
        var maxKey = "maxTrades" + id.toUpperCase();
        var el = document.getElementById("count-" + id);
        if (el && d[key] != null) {
            var cnt = d[key];
            var max = d[maxKey] ?? 0;
            // Merge with DB counts if engine restarted
            var dbCnt = _dbSetupCounts[id.toUpperCase()] ?? 0;
            if (cnt < dbCnt) cnt = dbCnt;
            el.textContent = "[" + cnt + "/" + max + "]";
        }
    });

    // ── Alerts from snapshot ─────────────────────────────────
    const alerts = d.recentAlerts;
    if (alerts && alerts.length > _lastAlertCount) {
        // Render only new alerts; snapshot order is oldest→newest so
        // insertBefore(firstChild) naturally puts newest at top.
        const newAlerts = alerts.slice(_lastAlertCount);
        // Sort oldest-first so prepending yields newest-on-top
        newAlerts.sort((a, b) => new Date(a.time) - new Date(b.time));
        for (const al of newAlerts) addAlert(al);
        _lastAlertCount = alerts.length;
    }
}

// ── Force Exit ────────────────────────────────────────────────
async function forceExit(setup) {
    const btn = document.getElementById("btn-exit-" + setup.toLowerCase());
    if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
    try {
        const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";
        const r   = await fetch("?handler=ForceExit" + setup, {
            method: "POST",
            headers: { "RequestVerificationToken": tok, "Content-Type": "application/json" }
        });
        if (r.ok) {
            addAlert({ type: "EXIT", setup: setup, time: new Date().toLocaleTimeString(), message: "Force exit executed" });
        }
    } catch (e) {
        console.error("Force exit error:", e);
    } finally {
        if (btn) { btn.disabled = false; }
    }
}

// ── Setup state badge ─────────────────────────────────────────
// state: A: 0=Idle ±1=Armed ±2=Active   B: 0=Idle ±1=Armed ±2=Retest ±3=Active
function _setupBadge(id, state) {
    const abs  = Math.abs(state);
    const dir  = state > 0 ? "LONG" : state < 0 ? "SHORT" : null;
    if (state === 0)                   return { text: "IDLE",                     cls: "badge setup-idle"   };
    if (abs === 1)                     return { text: `▶ ARMED ${dir}`,           cls: "badge setup-armed"  };
    if (id === "b" && abs === 2)       return { text: `↩ RETEST ${dir}`,          cls: "badge setup-retest" };
    /* active */                       return { text: `● ${dir} ACTIVE`,          cls: "badge " + (state > 0 ? "setup-long" : "setup-short") };
}

// ── Setup panel renderer ──────────────────────────────────────
// trade = ActiveTradeView | null,  state = integer from setupAState / setupBState
// enabled = bool from setupAEnabled / setupBEnabled
// pastCutoff / sessionEnded = booleans to override badge when time has passed
function updateSetup(id, trade, state, enabled, pastCutoff, sessionEnded) {
    const statusEl  = document.getElementById("status-" + id);
    const enabledEl = document.getElementById("enabled-" + id);
    const exitBtn   = document.getElementById("btn-exit-" + id);
    const card      = statusEl?.closest(".card");

    // ON / OFF badge
    if (enabledEl) {
        enabledEl.textContent = enabled ? "ON" : "OFF";
        enabledEl.className   = "badge " + (enabled ? "bg-success" : "bg-secondary");
    }

    // When disabled, show DISABLED in status badge and dim the card
    if (!enabled) {
        if (statusEl) { statusEl.textContent = "DISABLED"; statusEl.className = "badge bg-secondary ms-auto"; }
        if (exitBtn)  exitBtn.classList.add("d-none");
        if (card)     card.style.opacity = "0.45";
        ["dir","entry","stop","partial","target","cts","unreal"].forEach(f => setText(id + "-" + f, "—"));
        return;
    }

    if (card) card.style.opacity = "";  // restore if re-enabled

    if (!trade) {
        // Override state badge when past cutoff or session ended
        let badge;
        if (sessionEnded)   badge = { text: "SESSION ENDED", cls: "badge badge-halted" };
        else if (pastCutoff) badge = { text: "CUTOFF",        cls: "badge setup-armed" };
        else                 badge = _setupBadge(id, state ?? 0);
        if (statusEl) { statusEl.textContent = badge.text; statusEl.className = badge.cls; }
        if (exitBtn)  exitBtn.classList.add("d-none");
        ["dir","entry","stop","partial","target","cts","unreal"].forEach(f => setText(id + "-" + f, "—"));
        // Expectancy persists (updated by updateDashboard from snapshot totals)
        return;
    }

    // Direction enum: 0 = Long, 1 = Short
    const isLong = trade.direction === 0;
    if (statusEl) {
        statusEl.textContent = "● " + (isLong ? "LONG" : "SHORT") + " ACTIVE";
        statusEl.className   = "badge " + (isLong ? "setup-long" : "setup-short");
    }

    if (exitBtn) exitBtn.classList.remove("d-none");
    setText(id + "-dir",     isLong ? "▲ LONG" : "▼ SHORT", isLong ? "pnl-pos" : "pnl-neg");
    setText(id + "-entry",   trade.entry?.toFixed(2) ?? "—");
    // currentStop is the correct field name (may be BE-adjusted)
    const stopLabel = (trade.currentStop?.toFixed(2) ?? "—") + (trade.partialFilled ? " (BE)" : "");
    setText(id + "-stop", stopLabel);
    setText(id + "-partial", (trade.partial?.toFixed(2) ?? "—") + (trade.partialFilled ? " ✓" : ""));
    setText(id + "-target",  trade.target?.toFixed(2) ?? "—");
    const rem = trade.partialFilled ? trade.remainingContracts : trade.contracts;
    setText(id + "-cts",   rem + "/" + trade.contracts);
    setText(id + "-unreal", fmtDol(trade.unrealizedPnl));
}

// ── Alert feed ────────────────────────────────────────────────
function addAlert(a) {
    const feed = document.getElementById("alert-feed");
    if (!feed) return;
    _clearPlaceholder();
    // Determine CSS class from alert type
    const t = a.type ?? "";
    const cls = t === "ENTRY" ? "entry" : t === "EXIT" ? "exit"
              : t === "ORB" || t === "ARMED" ? "info" : "partial";
    // Format time — may be ISO string from server or pre-formatted string
    let timeStr = "";
    if (a.time) {
        const d = new Date(a.time);
        timeStr = isNaN(d) ? a.time : d.toLocaleTimeString("en-US", { timeZone: "America/New_York", hour12: false });
    }
    // Format setup — enum 0=A, 1=B, 2=C, 3=D, 4=F, or string
    const setupMap = { 0: "A", 1: "B", 2: "C", 3: "D", 4: "F" };
    const setup = typeof a.setup === "number" ? (setupMap[a.setup] ?? a.setup) : (a.setup ?? "");
    const div  = document.createElement("div");
    div.className = "alert-item " + cls;
    div.innerHTML = `<span class="text-muted">${timeStr}</span> <strong>[${setup}]</strong> ${a.message ?? ""}`;
    feed.insertBefore(div, feed.firstChild);
    while (feed.children.length > 50) feed.removeChild(feed.lastChild);
}

function clearAlerts() {
    const feed = document.getElementById("alert-feed");
    if (feed) feed.innerHTML = "";
}

// ── Today's Trades table ─────────────────────────────────────────
function addTradeRow(t) {
    const tbody = document.getElementById("trade-tbody");
    if (!tbody) return;
    // Remove "No trades today" placeholder
    const placeholder = tbody.querySelector("td[colspan]");
    if (placeholder) placeholder.closest("tr").remove();
    // Update count badge
    const count = tbody.querySelectorAll("tr").length + 1;
    const badge = document.getElementById("today-trade-count");
    if (badge) badge.textContent = count + (count === 1 ? " trade" : " trades");
    // Build row
    const pnl = t.netPnl ?? 0;
    const cls = pnl >= 0 ? "pnl-pos" : "pnl-neg";
    const setupBadge = `<span class="badge bg-warning text-dark">${t.setup}</span>`;
    const dirBadge   = t.dir === "Long"
        ? '<span class="text-success">▲ Long</span>'
        : '<span class="text-danger">▼ Short</span>';
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${t.time}</td><td>${setupBadge}</td><td>${dirBadge}</td>`
        + `<td>${(t.entry ?? 0).toFixed(2)}</td><td>${(t.exit ?? 0).toFixed(2)}</td>`
        + `<td>${t.reason ?? ""}</td>`
        + `<td class="${cls} fw-bold">${pnl >= 0 ? "+" : ""}$${pnl.toFixed(0)}</td>`
        + `<td class="${cls}">${(t.r ?? 0).toFixed(1)}R</td>`;
    tbody.insertBefore(tr, tbody.firstChild);
}
</script>
}

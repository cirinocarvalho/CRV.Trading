@page "/dashboard"
@model CRV.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Cockpit";
    ViewData["Page"]  = "dashboard";
    ViewData["Section"] = "futures";
    ViewData["LightReady"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@* Element ids are what the script below updates from the SignalR snapshot — keep them. *@
<div class="ck">

<div class="c-head ck-head">
    <h1>Cockpit</h1>
    <span class="c-sub"><span id="dash-ticker">@Model.Config.Ticker</span> · @Model.Config.ExecutionTFMinutes-min bars · ORB <span id="orb-window">@Model.Config.OrbStart.ToString("HH:mm")–@Model.Config.OrbEnd.ToString("HH:mm")</span></span>
    <div class="c-acts ck-status">
        @if (Model.IsNearRoll)
        {
            <span class="c-badge warn" title="Contract is near its roll date. Active front month: @Model.ActiveContract">
                <i class="bi bi-exclamation-triangle"></i>ROLL SOON → @Model.ActiveContract
            </span>
        }
        <span class="badge setup-idle" id="dash-session-badge">—</span>
        <span class="badge bg-secondary" id="sessionBadge">--</span>
        <span class="badge" id="dash-dd-badge">OK</span>
        <span class="ck-stream" id="stream-health" title="Market data stream">
            <span class="stream-dot" id="stream-dot"></span>
            <span class="num" id="stream-price">—</span>
            <span class="c-mut small" id="stream-age"></span>
        </span>
        <span id="dash-time" hidden></span>
    </div>
</div>

<!-- Setups: one card per basket entry, built by createSetupCard() -->
<section class="ck-setups" id="setup-cards-container" aria-label="Setups"></section>

<!-- Today's numbers -->
<section class="ck-tiles" aria-label="Today">
    <div class="c-tile"><small>Today P&amp;L</small><b class="stat-value" id="stat-today-pnl">$0</b></div>
    <div class="c-tile ck-gauge-tile">
        <small>Win rate</small>
        <svg id="wr-gauge" class="ck-gauge" viewBox="0 0 120 80" role="img" aria-label="Win rate">
            <path class="track" d="M 10 65 A 50 50 0 0 1 110 65"/>
            <path class="arc" id="wr-gauge-arc" data-tone="none" d="M 10 65 A 50 50 0 0 1 110 65" stroke-dasharray="0 157"/>
            <text class="big" id="wr-gauge-text" x="60" y="56" text-anchor="middle">—</text>
            <text class="sm" id="wr-gauge-detail" x="60" y="74" text-anchor="middle">0W / 0L</text>
        </svg>
    </div>
    <div class="c-tile"><small>Trades</small><b class="stat-value" id="stat-trades">0</b></div>
    <div class="c-tile"><small>Max drawdown</small><b class="stat-value" id="stat-maxdd">$0</b></div>
    <div class="c-tile" title="(Win% × avg win) − (Loss% × avg loss)"><small>Expectancy</small><b class="stat-value" id="stat-expectancy">—</b></div>
    <div class="c-tile ck-gauge-tile">
        <small>Daily loss limit</small>
        <svg id="dd-gauge" class="ck-gauge" viewBox="0 0 120 80" role="img" aria-label="Daily loss limit used">
            <path class="track" d="M 10 65 A 50 50 0 0 1 110 65"/>
            <path class="arc" id="dd-gauge-arc" data-tone="up" d="M 10 65 A 50 50 0 0 1 110 65" stroke-dasharray="0 157"/>
            <text class="big" id="dd-gauge-text" x="60" y="56" text-anchor="middle">0%</text>
            <text class="sm" id="dd-gauge-amounts" x="60" y="74" text-anchor="middle">$0 / $@(((int)Model.Config.MaxDailyLoss).ToString("N0"))</text>
        </svg>
    </div>
</section>

<div class="c-chips ck-groups" id="group-selector" aria-label="Instrument">
    <span class="c-mut small">Instrument</span>
</div>

<div class="ck-main">
    <section class="c-panel ck-chart">
        <div class="c-panel-h">
            <h2>Chart</h2>
            <div class="ck-overlays">
                <label><input class="form-check-input chart-overlay-toggle" type="checkbox" id="chart-toggle-ema21" data-overlay="ema21" /> EMA21</label>
                <label><input class="form-check-input chart-overlay-toggle" type="checkbox" id="chart-toggle-vwap" data-overlay="vwap" /> VWAP</label>
                <label><input class="form-check-input chart-overlay-toggle" type="checkbox" id="chart-toggle-orb" data-overlay="orb" /> ORB lines</label>
            </div>
        </div>
        <div class="ck-chart-box" id="tv-chart-container">
            <div id="tv-chart-placeholder" class="ck-chart-empty">
                <i class="bi bi-bar-chart-line"></i>
                <span>No market data yet. The chart loads when bars arrive.</span>
            </div>
        </div>
    </section>

    <div class="c-stack">
        <section class="c-panel">
            <div class="c-panel-h"><h2>Market context</h2></div>
            <div class="c-panel-b">
                <div class="c-kv"><span>Session</span><span id="stat-session">—</span></div>
                <div class="c-kv"><span>Session range</span><span id="stat-session-range">—</span></div>
                <div class="c-kv"><span>Trend score</span><span><span class="c-up">▲</span> <span id="stat-trend-bull">0</span> <span class="c-down ms-2">▼</span> <span id="stat-trend-bear">0</span></span></div>
                <div class="c-kv"><span>Trend day</span><span id="stat-trend-label">—</span></div>
                <div class="c-kv"><span>VWAP state</span><span><span id="stat-vwap-state">—</span> <span id="stat-vwap-bands" class="c-mut small"></span></span></div>
                <div class="c-kv"><span>Active setup</span><span id="stat-active-setup">—</span></div>
                <div class="c-kv"><span>Signals</span><span id="stat-sweep-info">—</span></div>
                <div class="c-kv"><span>Signal strength</span><span><span id="stat-signal-strength">—</span>
                    <span class="c-mut small ms-1">D <span id="stat-drive-score">0</span> · S <span id="stat-sweep-score">0</span> · V <span id="stat-vwap-dev-score">0</span></span></span></div>
            </div>
        </section>

        <section class="c-panel">
            <div class="c-panel-h"><h2>False breakout</h2><span class="badge bg-secondary" id="fb-compound-badge">Idle</span></div>
            <div class="c-panel-b">
                <div class="c-kv"><span>Opening range</span><span><span class="badge bg-secondary" id="fb-orb-status">Idle</span> <span id="fb-orb-bars" class="ms-1">—</span> <span id="fb-orb-depth" class="c-mut ms-1">—</span></span></div>
                <div class="c-kv"><span>Session range</span><span><span class="badge bg-secondary" id="fb-session-status">Idle</span> <span id="fb-session-bars" class="ms-1">—</span> <span id="fb-session-depth" class="c-mut ms-1">—</span></span></div>
            </div>
        </section>

        <section class="c-panel">
            <div class="c-panel-h">
                <h2>Key levels</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="forceOrb()" id="btn-force-orb" title="Recalculate the opening range from the broker's historical bars">
                    <i class="bi bi-arrow-repeat me-1"></i>Force ORB
                </button>
            </div>
            <div class="c-panel-b">
                <div class="c-kv"><span>ORB</span><span>H <span id="orb-high" class="c-acc">—</span> · L <span id="orb-low" class="c-acc">—</span> · R <span id="orb-range">—</span></span></div>
                <div class="c-kv"><span>ORB close</span><span><span class="badge bg-secondary" id="orb-quality-badge">Building...</span> <span class="badge" id="orb-close-badge"></span></span></div>
                <div class="c-kv"><span>VWAP</span><span><span id="stat-vwap">—</span> <span id="stat-vwap-pos" class="small ms-1">—</span></span></div>
                <div class="c-kv"><span>ATR(14)</span><span><span id="stat-atr">—</span> <span id="stat-orb-atr-ratio" class="c-mut small ms-1">vs ORB —</span></span></div>
                <div class="c-kv"><span>EMA(21)</span><span><span id="stat-ema21">—</span> <span id="stat-ema21-pos" class="small ms-1">—</span></span></div>
                <div class="c-kv ck-chop" id="row-chop-summary" role="button" tabindex="0" onclick="toggleChopDetails()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleChopDetails();}" title="Show each chop filter">
                    <span>Chop <i class="bi bi-chevron-down ms-1" id="chop-chevron"></i></span>
                    <span><span class="badge bg-secondary" id="stat-chop-badge">OFF</span> <span id="stat-chop-votes" class="c-mut small ms-1">—</span></span>
                </div>
                <div id="row-chop-details" style="display:none">
                    <table class="c-table">
                        <thead><tr><th>Filter</th><th>Vote</th><th class="r">Value</th><th class="r">Threshold</th></tr></thead>
                        <tbody id="chop-filter-rows">
                            <tr data-filter="rangeCompression"><td class="t">Range compression</td><td data-vote>—</td><td class="r" data-value>—</td><td class="r c-mut" data-thresh>—</td></tr>
                            <tr data-filter="flatVwap"><td class="t">Flat VWAP</td><td data-vote>—</td><td class="r" data-value>—</td><td class="r c-mut" data-thresh>—</td></tr>
                            <tr data-filter="weakDrive"><td class="t">Weak drive</td><td data-vote>—</td><td class="r" data-value>—</td><td class="r c-mut" data-thresh>—</td></tr>
                            <tr data-filter="lowVolume"><td class="t">Low volume</td><td data-vote>—</td><td class="r" data-value>—</td><td class="r c-mut" data-thresh>—</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="ck-bottom">
    <section class="c-panel">
        <div class="c-panel-h"><h2>Alerts</h2><button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="clearAlerts()">Clear</button></div>
        <div class="alert-feed" id="alert-feed">
            <div class="alert-item info" data-placeholder><span class="c-mut">--:--:--</span> Waiting for the engine…</div>
        </div>
    </section>

    <section class="c-panel">
        <div class="c-panel-h"><h2>Today's trades</h2><span class="c-right" id="today-trade-count">0 trades</span></div>
        <div class="c-table-wrap ck-trades">
            <table class="c-table">
                <thead><tr><th>Time</th><th>Setup</th><th>Instr</th><th>Side</th><th class="r">Entry</th><th class="r">Exit</th><th>Reason</th><th class="r">Net</th><th class="r">R</th></tr></thead>
                <tbody id="trade-tbody">
                    <tr><td colspan="9" class="t c-mut text-center py-3">No trades today</td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

</div>

<!-- Confirmation dialog (Exit now, Force ORB) -->
<div class="modal fade crv-confirm" id="dashConfirmModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="dashConfirm-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="dashConfirm-title">Confirm</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="dashConfirm-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn" id="dashConfirm-ok">Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@Html.AntiForgeryToken()
<script src="https://unpkg.com/lightweight-charts@4/dist/lightweight-charts.standalone.production.js"></script>
<script>
// ─────────────────────────────────────────────────────────────
// Dashboard JavaScript — subscribes to crv:update / crv:alert
// events dispatched by crv-hub.js when SignalR messages arrive.
// All property names match EngineSnapshot JSON (camelCase).
// ─────────────────────────────────────────────────────────────

const maxDailyLoss = @Model.Config.MaxDailyLoss.ToString(System.Globalization.CultureInfo.InvariantCulture);
let _lastAlertTime = null;  // track latest alert timestamp to detect new ones

// Map broker ticker to group key (e.g. "/MNQM26" → "NQ")
function _tickerToGroup(t) {
    t = (t || "").replace(/^\//, "");
    if (t.startsWith("NQ") || t.startsWith("MNQ")) return "NQ";
    if (t.startsWith("ES") || t.startsWith("MES")) return "ES";
    if (t.startsWith("GC") || t.startsWith("MGC")) return "GC";
    if (t.startsWith("CL") || t.startsWith("MCL")) return "CL";
    if (t.startsWith("YM") || t.startsWith("MYM")) return "YM";
    if (t.startsWith("RTY") || t.startsWith("M2K")) return "RTY";
    if (t.startsWith("BTC") || t.startsWith("MBT")) return "BTC";
    return t;
}

// Seed ON/OFF badges — deferred until cards are created dynamically

document.addEventListener("crv:update", e => updateDashboard(e.detail));
document.addEventListener("crv:alert",  e => {
    addAlert(e.detail);
    // Add trade markers to Lightweight Charts (only for current chart group)
    var al = e.detail;
    if (al && _lwcCurrentGroup && al.ticker) {
        var alertGroup = _tickerToGroup(al.ticker);
        if (alertGroup !== _lwcCurrentGroup) return;  // skip markers for other groups
    }
    if (al && al.type === "ENTRY") {
        var isLong = al.message && al.message.startsWith("LONG");
        _lwcAddTradeMarker(0, true, isLong);
    } else if (al && al.type === "EXIT") {
        _lwcAddTradeMarker(0, false, false);
    }
});
document.addEventListener("crv:trade",  e => {
    addTradeRow(e.detail);
    // Incrementally update _dbStats so the PnL display stays current even after
    // engine restarts (when engineTrades < _dbStats.trades, the dashboard shows
    // _dbStats.pnl — which was stale without this update).
    var net = e.detail.netPnl ?? 0;
    _dbStats.pnl += net;
    _dbStats.trades++;
    if (net > 0) { _dbStats.wins++; _dbStats.winPnl += net; }
    else if (net < 0) { _dbStats.losses++; _dbStats.lossPnl += net; }
    // Recompute maxDD
    var runPnl2 = 0, peak2 = 0, maxDD2 = 0;
    // Approximate: just use current _dbStats (exact DD requires full sequence, but this keeps it reasonable)
    _applyDbStats();
});

// ── Load today's trades on page load and compute DB-based stats ──
// These stats survive engine restarts — the engine snapshot may show 0
// after a restart, but the DB trades are still there.
var _dbStats = { pnl: 0, wins: 0, losses: 0, maxDD: 0, trades: 0, winPnl: 0, lossPnl: 0 };
// _dbSetupCounts removed — per-setup counts are session-scoped (from engine snapshot only)
fetch('/api/engine/trades/today')
    .then(r => r.json())
    .then(trades => {
        if (!trades.length) return;
        trades.reverse().forEach(addTradeRow);
        // Compute stats from DB trades
        var peak = 0, runPnl = 0, maxDD = 0;
        for (const t of trades) {
            var net = t.netPnl ?? 0;
            _dbStats.pnl += net;
            _dbStats.trades++;
            if (net > 0) { _dbStats.wins++; _dbStats.winPnl += net; }
            else if (net < 0) { _dbStats.losses++; _dbStats.lossPnl += net; }
            runPnl += net;
            if (runPnl > peak) peak = runPnl;
            var dd = peak - runPnl;
            if (dd > maxDD) maxDD = dd;
        }
        _dbStats.maxDD = maxDD;
        // Per-setup counts removed — session-scoped, provided by engine snapshot
        // Apply DB stats immediately so cards aren't blank
        _applyDbStats();
    })
    .catch(() => {});

function _applyDbStats() {
    var s = _dbStats;
    if (s.trades === 0) return;
    setText("stat-today-pnl", fmtDol(s.pnl), pnlCls(s.pnl));
    setText("stat-trades", s.trades);
    setText("stat-maxdd", "$" + Math.abs(s.maxDD).toFixed(0));
    var total = s.wins + s.losses;
    var exp = total > 0 ? (s.wins / total) * (s.winPnl / Math.max(s.wins,1))
                        - (s.losses / total) * Math.abs(s.lossPnl / Math.max(s.losses,1)) : 0;
    setText("stat-expectancy", exp ? fmtDol(exp) : "—", exp ? pnlCls(exp) : "stat-value font-monospace");
    // Win rate gauge
    var wrArc = document.getElementById("wr-gauge-arc");
    var wrText = document.getElementById("wr-gauge-text");
    var wrDetail = document.getElementById("wr-gauge-detail");
    if (wrArc && wrText && total > 0) {
        var wrPct = Math.round(s.wins / total * 100);
        var arcLen = 157, fill = Math.min(wrPct, 100) / 100 * arcLen;
        wrArc.setAttribute("stroke-dasharray", fill + " " + arcLen);
        wrArc.dataset.tone = wrPct >= 60 ? "up" : wrPct >= 40 ? "warn" : "down";
        wrText.textContent = wrPct + "%";
        if (wrDetail) wrDetail.textContent = s.wins + "W / " + s.losses + "L";
    }
    // Per-setup trade counts are session-scoped — only the engine snapshot
    // knows the current session's counts. Don't show DB totals here.
}

// Show engine status changes in the alert feed and clear the placeholder
document.addEventListener("crv:status", e => {
    const status = e.detail;
    _clearPlaceholder();
    const isLive = status === "Live";
    const div = document.createElement("div");
    div.className = "alert-item " + (isLive ? "entry" : "info");
    div.innerHTML = `<span class="c-mut">${_etNow()}</span> Engine: <strong>${_esc(status)}</strong>`;
    const feed = document.getElementById("alert-feed");
    if (feed) feed.insertBefore(div, feed.firstChild);
});

// ET clock + stream health age
let _lastUpdateMs = 0;
const _setupLastPriceMs = {};

function _updateDotAge(dotEl, ageEl, lastMs) {
    if (lastMs <= 0) {
        if (dotEl) dotEl.className = "stream-dot";
        if (ageEl) ageEl.textContent = "";
        return;
    }
    const ageSec = Math.floor((Date.now() - lastMs) / 1000);
    if (dotEl) {
        if (ageSec <= 60)       dotEl.className = "stream-dot live";
        else if (ageSec <= 300) dotEl.className = "stream-dot stale";
        else                    dotEl.className = "stream-dot";
    }
    if (ageEl) {
        if (ageSec < 5)          ageEl.textContent = "";
        else if (ageSec < 60)    ageEl.textContent = ageSec + "s ago";
        else if (ageSec < 3600)  ageEl.textContent = Math.floor(ageSec / 60) + "m ago";
        else                     ageEl.textContent = Math.floor(ageSec / 3600) + "h ago";
    }
}

setInterval(() => {
    document.getElementById("dash-time").textContent = _etNow() + " ET";
    // Global stream dot
    _updateDotAge(document.getElementById("stream-dot"), document.getElementById("stream-age"), _lastUpdateMs);
    // Per-setup price dots
    for (const id of Object.keys(_setupLastPriceMs)) {
        _updateDotAge(
            document.getElementById(id + "-price-dot"),
            document.getElementById(id + "-price-age"),
            _setupLastPriceMs[id]);
    }
}, 1000);

// ── Helpers ───────────────────────────────────────────────────
function _etNow() {
    return new Date().toLocaleTimeString("en-US", { timeZone: "America/New_York", hour12: false });
}
function _clearPlaceholder() {
    document.querySelector("#alert-feed [data-placeholder]")?.remove();
}
function fmtDol(v) {
    if (v == null) return "—";
    const s = Math.abs(v).toLocaleString("en-US", { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    return (v >= 0 ? "+$" : "−$") + s;
}
function pnlCls(v) { return "stat-value font-monospace " + (v > 0 ? "pnl-pos" : v < 0 ? "pnl-neg" : "pnl-zero"); }
function setText(id, text, cls) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = text ?? "—";
    if (cls != null) el.className = cls;
}

function findSetup(snap, id) {
    if (snap.setups && Array.isArray(snap.setups)) {
        return snap.setups.find(s => s.id === id) || null;
    }
    return null;
}

// ── Theme tokens (tokens.css) so the chart and gauges follow light/dark ──
function _tok(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }
function _pal() {
    return { bg: _tok('--c-surface'), text: _tok('--c-muted'), line: _tok('--c-line'), fg: _tok('--c-text'),
             up: _tok('--c-up'), down: _tok('--c-down'), accent: _tok('--c-accent'),
             upSoft: _tok('--c-up-soft'), downSoft: _tok('--c-down-soft') };
}
function _esc(v) { return window.CRV && CRV.esc ? CRV.esc(v) : String(v ?? ''); }
function _cardId(id) { return String(id).toLowerCase().replace(/[^a-z0-9]/g, '-'); }

// ── Lightweight Charts (own data from Tradovate stream) ──────
let _lwcChart = null;
let _lwcSeries = null;
let _lwcVolSeries = null;   // volume histogram
let _lwcVolMaSeries = null; // volume MA(21) line
let _lwcLastVolMa = 0;     // last MA value for live updates
let _lwcVwapSeries = null;  // VWAP line series
let _lwcCurrentGroup = null;
let _lwcPriceLines = {};   // { orbHigh, orbLow }
let _lwcMarkers = [];      // trade entry/exit markers
let _lwcPendingMarkers = []; // markers buffered before chart ready
let _lwcLastBarTime = 0;   // track bar transitions
let _lwcDataReady = false; // prevent updates before initial setData
let _lwcHasData = false;   // series has at least one data point
let _lwcEma21Series = null;  // EMA21 line series overlay
let _lwcPriceLineValues = { orbHigh: 0, orbLow: 0, orbMid: 0 }; // cache to avoid re-creating

// ── Chart overlay visibility (persisted per-browser) ─────────────
let _chartOverlays = (function() {
    try {
        var raw = localStorage.getItem('crv.chartOverlays');
        if (raw) return Object.assign({ ema21: true, vwap: false, orb: true }, JSON.parse(raw));
    } catch(e) {}
    return { ema21: true, vwap: false, orb: true };
})();
function _saveChartOverlays() {
    try { localStorage.setItem('crv.chartOverlays', JSON.stringify(_chartOverlays)); } catch(e) {}
}
function _applyChartOverlayVisibility() {
    try { if (_lwcEma21Series) _lwcEma21Series.applyOptions({ visible: !!_chartOverlays.ema21 }); } catch(e) {}
    try { if (_lwcVwapSeries)  _lwcVwapSeries.applyOptions({ visible: !!_chartOverlays.vwap }); } catch(e) {}
    // ORB lines are price-line objects; toggle by forcing a price-line refresh
    // using the current snapshot for the selected group.
    try {
        var gs = (typeof _groupSnapshots !== 'undefined' && _selectedGroup)
            ? _groupSnapshots[_selectedGroup] : null;
        if (gs) {
            // Force re-creation: clear cache so _lwcUpdatePriceLines doesn't short-circuit
            _lwcPriceLineValues = { orbHigh: 0, orbLow: 0, orbMid: 0 };
            if (!_chartOverlays.orb) {
                _lwcRemovePriceLines();
            } else {
                _lwcUpdatePriceLines(gs);
            }
        } else if (!_chartOverlays.orb) {
            _lwcRemovePriceLines();
        }
    } catch(e) {}
}
// Hook up the overlay checkboxes on page load (DOM is ready — script is at bottom)
(function _initChartOverlayToggles() {
    document.querySelectorAll('.chart-overlay-toggle').forEach(function(cb) {
        var key = cb.getAttribute('data-overlay');
        if (key && _chartOverlays[key] != null) cb.checked = !!_chartOverlays[key];
        cb.addEventListener('change', function() {
            _chartOverlays[key] = cb.checked;
            _saveChartOverlays();
            _applyChartOverlayVisibility();
        });
    });
})();

// Compute ET offset in seconds (handles EDT/EST automatically)
function _getEtOffsetSec() {
    var now = new Date();
    var utcStr = now.toLocaleString('en-US', { timeZone: 'UTC' });
    var etStr  = now.toLocaleString('en-US', { timeZone: 'America/New_York' });
    return (new Date(etStr) - new Date(utcStr)) / 1000;
}

function _initLwcChart() {
    var container = document.getElementById("tv-chart-container");
    if (!container || _lwcChart) return;

    var P = _pal();
    _lwcChart = LightweightCharts.createChart(container, {
        layout:     { background: { color: P.bg }, textColor: P.text, fontFamily: 'IBM Plex Mono, monospace' },
        grid:       { vertLines: { visible: false }, horzLines: { visible: false } },
        crosshair:  { mode: LightweightCharts.CrosshairMode.Normal },
        timeScale:  { timeVisible: true, secondsVisible: false, borderColor: P.line },
        rightPriceScale: { borderColor: P.line },
        width:  container.clientWidth || 800,
        height: container.clientHeight || 460,
    });

    _lwcSeries = _lwcChart.addCandlestickSeries({
        upColor:       P.bg,        // hollow body (matches background)
        downColor:     P.down,
        borderUpColor: P.up,
        borderDownColor: P.down,
        wickUpColor:   P.up,
        wickDownColor: P.down,
        lastValueVisible: false,    // disable last-value label on Y axis
        priceLineVisible: false,    // disable horizontal price line at current price
    });

    // Volume histogram — pinned to bottom, 15% of chart height
    _lwcVolSeries = _lwcChart.addHistogramSeries({
        priceFormat:    { type: 'volume' },
        priceScaleId:   'vol',
        lastValueVisible: false,
        priceLineVisible: false,
        crosshairMarkerVisible: false,
    });
    _lwcChart.priceScale('vol').applyOptions({
        scaleMargins: { top: 0.85, bottom: 0 },
        drawTicks:    false,
        visible:      false,          // hide volume axis — only show candlestick price scale
        autoScale:    true,
    });

    // Volume MA(21) line — overlaid on the volume pane
    _lwcVolMaSeries = _lwcChart.addLineSeries({
        color:          P.line,
        lineWidth:      1,
        priceFormat:    { type: 'volume' },
        priceScaleId:   'vol',
        lastValueVisible: false,
        priceLineVisible: false,
        crosshairMarkerVisible: false,
    });

    // EMA21 overlay line
    _lwcEma21Series = _lwcChart.addLineSeries({
        color:          P.fg,
        lineWidth:      1,
        lastValueVisible: true,
        priceLineVisible: false,
        crosshairMarkerVisible: false,
        title: 'EMA21',
        visible: !!_chartOverlays.ema21,
    });

    // VWAP overlay line
    _lwcVwapSeries = _lwcChart.addLineSeries({
        color:          P.accent,
        lineWidth:      1,
        lineStyle:      LightweightCharts.LineStyle.Dotted,
        lastValueVisible: true,
        priceLineVisible: false,
        crosshairMarkerVisible: false,
        title: 'VWAP',
        visible: !!_chartOverlays.vwap,
    });

    // Responsive resize
    var ro = new ResizeObserver(function(entries) {
        var r = entries[0].contentRect;
        if (_lwcChart && r.width > 0 && r.height > 0) _lwcChart.resize(r.width, r.height);
    });
    ro.observe(container);
}

// Re-color the chart when the theme switches (crv-ui.js fires crv:theme).
document.addEventListener('crv:theme', function () {
    if (!_lwcChart) return;
    var P = _pal();
    _lwcChart.applyOptions({ layout: { background: { color: P.bg }, textColor: P.text },
                             timeScale: { borderColor: P.line }, rightPriceScale: { borderColor: P.line } });
    _lwcSeries.applyOptions({ upColor: P.bg, downColor: P.down, borderUpColor: P.up, borderDownColor: P.down, wickUpColor: P.up, wickDownColor: P.down });
    if (_lwcVolMaSeries) _lwcVolMaSeries.applyOptions({ color: P.line });
    if (_lwcEma21Series) _lwcEma21Series.applyOptions({ color: P.fg });
    if (_lwcVwapSeries)  _lwcVwapSeries.applyOptions({ color: P.accent });
    _applyChartOverlayVisibility();   // rebuilds ORB price lines with the new colors
});

function _lwcRemovePriceLines() {
    Object.values(_lwcPriceLines).forEach(function(pl) {
        try { _lwcSeries.removePriceLine(pl); } catch(e) {}
    });
    _lwcPriceLines = {};
}

function _lwcUpdatePriceLines(gs) {
    if (!_lwcDataReady || !_lwcSeries || !gs) return;
    // Never create price lines on a series with no data — LWC throws "Value is null"
    if (!_lwcHasData) return;
    try {
        var wantOrb = _chartOverlays.orb && gs.orbHigh > 0 && gs.orbFormed;
        var h = wantOrb ? gs.orbHigh : 0;
        var l = wantOrb ? gs.orbLow  : 0;
        var m = wantOrb ? gs.orbMid  : 0;
        // Skip if nothing changed (avoids remove+recreate race with LWC render cycle)
        if (h === _lwcPriceLineValues.orbHigh && l === _lwcPriceLineValues.orbLow && m === _lwcPriceLineValues.orbMid) return;
        _lwcRemovePriceLines();
        _lwcPriceLineValues = { orbHigh: h, orbLow: l, orbMid: m };
        if (wantOrb) {
            _lwcPriceLines.orbHigh = _lwcSeries.createPriceLine({ price: h, color: _pal().up, lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: 'ORB H' });
            _lwcPriceLines.orbLow  = _lwcSeries.createPriceLine({ price: l, color: _pal().down, lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: 'ORB L' });
            _lwcPriceLines.orbMid  = _lwcSeries.createPriceLine({ price: m, color: _pal().accent, lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dotted, axisLabelVisible: false, title: 'ORB M' });
        }
    } catch(e) { /* suppress during group switch */ }
}

let _lwcLoadSeq = 0;  // guard against stale async responses
async function _lwcLoadGroup(groupKey) {
    if (!_lwcChart) _initLwcChart();
    if (!_lwcSeries) { console.warn("[LWC] no series"); return; }
    _lwcCurrentGroup = groupKey;
    _lwcMarkers = [];
    _lwcPendingMarkers = [];
    _prevSetupStates = {};
    _lwcLastBarTime = 0;
    _lwcLastVolMa = 0;
    _lwcDataReady = false;  // block live updates until setData completes
    _lwcHasData = false;
    _lwcPriceLineValues = { orbHigh: 0, orbLow: 0, orbMid: 0, ema21: 0 };
    // Remove old price lines BEFORE loading new data (avoids "Value is null")
    _lwcRemovePriceLines();
    var seq = ++_lwcLoadSeq;
    var ph = document.getElementById("tv-chart-placeholder");
    try {
        console.log("[LWC] fetching bars for", groupKey);
        var resp = await fetch("/api/engine/bars/" + encodeURIComponent(groupKey));
        if (!resp.ok) { console.warn("[LWC] bad response", resp.status); _lwcSeries.setData([]); return; }
        var bars = await resp.json();
        if (seq !== _lwcLoadSeq) return;  // stale response — a newer group was selected
        var _volUp = _pal().upSoft, _volDown = _pal().downSoft;
        console.log("[LWC] received", bars.length, "bars");
        // Shift UTC timestamps to ET for display (LWC renders raw timestamps on axis)
        var etOffset = _getEtOffsetSec();
        bars.forEach(function(b) { b.time = Math.round(b.time + etOffset); });
        // Filter out bars with null/zero/NaN OHLC values (warmup bars before first trade)
        var rawLen = bars.length;
        bars = bars.filter(function(b) {
            return Number.isFinite(b.time) && b.time > 0
                && Number.isFinite(b.open) && b.open > 0
                && Number.isFinite(b.high) && b.high > 0
                && Number.isFinite(b.low)  && b.low > 0
                && Number.isFinite(b.close) && b.close > 0;
        });
        // Ensure strictly ascending times (LWC requirement) — deduplicate by keeping last
        bars.sort(function(a, b) { return a.time - b.time; });
        var deduped = [];
        for (var di = 0; di < bars.length; di++) {
            if (deduped.length > 0 && bars[di].time <= deduped[deduped.length - 1].time) {
                deduped[deduped.length - 1] = bars[di]; // keep latest value for duplicate time
            } else {
                deduped.push(bars[di]);
            }
        }
        bars = deduped;
        console.log("[LWC]", bars.length, "of", rawLen, "bars passed filter");
        // Clear all series atomically before setting new data to avoid stale cross-series state
        _lwcSeries.setData([]);
        _lwcVolSeries.setData([]);
        _lwcVolMaSeries.setData([]);
        if (_lwcEma21Series) _lwcEma21Series.setData([]);
        // Now set new data
        _lwcSeries.setData(bars);
        _lwcSeries.setMarkers([]);
        _lwcHasData = bars.length > 0;

        // Volume histogram — color based on candle direction
        var volData = bars.map(function(b) {
            return { time: b.time, value: b.volume || 0, color: b.close >= b.open ? _volUp : _volDown };
        });
        _lwcVolSeries.setData(volData);

        // Volume SMA(20) — matches EMA21 strategy's VolSmaPeriod
        var maLen = 20;
        var maData = [];
        for (var i = 0; i < bars.length; i++) {
            var lookback = Math.min(i + 1, maLen);
            var sum = 0;
            for (var j = i - lookback + 1; j <= i; j++) sum += (bars[j].volume || 0);
            maData.push({ time: bars[i].time, value: sum / lookback });
        }
        _lwcVolMaSeries.setData(maData);
        if (maData.length > 0) _lwcLastVolMa = maData[maData.length - 1].value;

        // EMA21 line overlay
        if (_lwcEma21Series) {
            var ema21Data = bars.filter(function(b) { return b.ema21 > 0; })
                .map(function(b) { return { time: b.time, value: b.ema21 }; });
            _lwcEma21Series.setData(ema21Data);
        }

        // VWAP line overlay
        if (_lwcVwapSeries) {
            var vwapData = bars.filter(function(b) { return b.vwap > 0; })
                .map(function(b) { return { time: b.time, value: b.vwap }; });
            _lwcVwapSeries.setData(vwapData);
        }

        if (bars.length > 0) {
            _lwcLastBarTime = bars[bars.length - 1].time;
            if (ph) ph.remove();
        } else {
            /* placeholder already removed */
        }
        _lwcDataReady = true;  // allow live updates now
        // Flush any markers that arrived before chart was ready
        if (_lwcPendingMarkers.length > 0) {
            _lwcPendingMarkers.forEach(function(m) {
                _lwcAddTradeMarker(m.time, m.isEntry, m.isLong);
            });
            _lwcPendingMarkers = [];
        }
        // Show visible range — fitContent for small datasets, 8-hour window otherwise
        if (bars.length > 20) {
            var lastBarTime = bars[bars.length - 1].time;
            var hoursBack = 8 * 3600;
            _lwcChart.timeScale().setVisibleRange({ from: lastBarTime - hoursBack, to: lastBarTime + 900 });
        } else {
            _lwcChart.timeScale().fitContent();
        }
        _lwcChart.priceScale('right').applyOptions({ autoScale: true });
    } catch(e) {
        console.error("[LWC] Failed to load bars for", groupKey, e);
        try { _lwcSeries.setData([]); } catch(x) {}
        try { _lwcVolSeries.setData([]); } catch(x) {}
        try { _lwcVolMaSeries.setData([]); } catch(x) {}
        // _lwcVwapSeries disabled
    }
}

function _lwcUpdateCandle(gs) {
    if (!_lwcDataReady || !_lwcSeries || !gs || gs.barTime === 0) return;
    if (!gs.barOpen || !gs.barHigh || !gs.barLow || !gs.barClose) return;
    try {
    var t = Math.round(gs.barTime + _getEtOffsetSec());
    if (!Number.isFinite(t) || !Number.isFinite(gs.barOpen) || !Number.isFinite(gs.barClose)) return;
    // Only update if this timestamp is >= the last known bar time (never overwrite history)
    if (_lwcLastBarTime > 0 && t < _lwcLastBarTime) return;
    _lwcSeries.update({ time: t, open: gs.barOpen, high: gs.barHigh, low: gs.barLow, close: gs.barClose });
    _lwcHasData = true;
    // Update volume bar for current candle
    if (_lwcVolSeries) {
        var volColor = gs.barClose >= gs.barOpen ? _pal().upSoft : _pal().downSoft;
        _lwcVolSeries.update({ time: t, value: gs.barVolume || 0, color: volColor });
    }
    // Keep volume MA line in sync so LWC doesn't throw "Value is null"
    // when the line series has fewer data points than the candle series.
    if (_lwcVolMaSeries) {
        _lwcVolMaSeries.update({ time: t, value: _lwcLastVolMa || 0 });
    }
    // Update EMA21 overlay with latest value
    if (_lwcEma21Series && gs.ema21 > 0) {
        _lwcEma21Series.update({ time: t, value: gs.ema21 });
    }
    // Update VWAP overlay with latest value
    if (_lwcVwapSeries && gs.vwap > 0) {
        _lwcVwapSeries.update({ time: t, value: gs.vwap });
    }
    _lwcLastBarTime = t;
    var ph = document.getElementById("tv-chart-placeholder");
    if (ph) ph.remove();
    } catch(e) { /* suppress during group switch */ }
}

function _lwcAddTradeMarker(time, isEntry, isLong) {
    // Buffer if chart not ready — will be flushed after bars load
    if (!_lwcDataReady || _lwcLastBarTime === 0) {
        _lwcPendingMarkers.push({ time: time, isEntry: isEntry, isLong: isLong });
        return;
    }
    var markerTime = _lwcLastBarTime;
    if (isEntry) {
        _lwcMarkers.push({
            time: markerTime,
            position: isLong ? 'belowBar' : 'aboveBar',
            shape: isLong ? 'arrowUp' : 'arrowDown',
            color: isLong ? _pal().up : _pal().down,
            text: isLong ? 'L' : 'S',
        });
    } else {
        _lwcMarkers.push({
            time: markerTime,
            position: 'aboveBar',
            shape: 'circle',
            color: _pal().fg,
            text: 'X',
        });
    }
    _lwcMarkers.sort(function(a, b) { return a.time - b.time; });
    try { _lwcSeries.setMarkers(_lwcMarkers); } catch(e) {}
}

// ── Setup State Markers (triangles on arm/retest) ────────────
var _prevSetupStates = {};  // track previous state per setup to detect transitions
var _setupColors = {
    Pullback:        '#3b82f6',  // blue
    Retest:          '#f59e0b',  // amber
    OrbFakeout:      '#a855f7',  // purple
    SessionFakeout:  '#06b6d4',  // cyan
};

function _lwcCheckSetupMarkers(setups) {
    if (!_lwcDataReady || !_lwcSeries || !setups) return;
    var markerTime = _lwcLastBarTime > 0 ? _lwcLastBarTime : Math.floor(Date.now() / 1000) + _getEtOffsetSec();
    var added = false;
    setups.forEach(function(s) {
        // Only show markers for the currently displayed chart group
        if (_lwcCurrentGroup && s.ticker) {
            var setupGroup = _tickerToGroup(s.ticker);
            if (setupGroup !== _lwcCurrentGroup) return;
        }
        var prev = _prevSetupStates[s.id] || 0;
        var cur  = s.state || 0;
        _prevSetupStates[s.id] = cur;
        if (prev === cur) return;  // no transition
        // Detect arm (0 → ±1): small circle
        if (prev === 0 && Math.abs(cur) === 1) {
            var isLong = cur > 0;
            var color  = _setupColors[s.strategyType] || '#9ca3af';
            _lwcMarkers.push({
                time: markerTime,
                position: isLong ? 'belowBar' : 'aboveBar',
                shape: 'circle',
                size: 0.5,
                color: color,
                text: '',
            });
            added = true;
        }
        // Detect entry (has pending entry — trade fired): small triangle
        if (s.trade && prev !== 0 && (s.trade.entry || 0) > 0) {
            var isLong = cur > 0 || (s.trade && s.trade.direction === 0);
            var color  = _setupColors[s.strategyType] || '#9ca3af';
            var label  = (s.id || '').split('-').pop() || s.strategyType;
            _lwcMarkers.push({
                time: markerTime,
                position: isLong ? 'belowBar' : 'aboveBar',
                shape: isLong ? 'arrowUp' : 'arrowDown',
                size: 0.5,
                color: color,
                text: label.toUpperCase(),
            });
            added = true;
        }
    });
    if (added) {
        _lwcMarkers.sort(function(a, b) { return a.time - b.time; });
        try { _lwcSeries.setMarkers(_lwcMarkers); } catch(e) {}
    }
}

// ── Ticker Group Selector ─────────────────────────────────────
let _selectedGroup = null;  // null = primary (flat fields)
let _groupKeys = [];        // populated from first snapshot
let _groupSnapshots = {};   // latest per-group data

function _buildGroupPills(keys) {
    const container = document.getElementById("group-selector");
    if (!container || _groupKeys.length > 0) return; // build once
    _groupKeys = keys;
    keys.forEach((key, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn btn-sm " + (i === 0 ? "btn-warning" : "btn-outline-secondary");
        btn.textContent = key;
        btn.dataset.group = key;
        btn.onclick = () => _selectGroup(key);
        container.appendChild(btn);
    });
    // Auto-select first group and load its chart
    if (keys.length > 0) {
        _selectedGroup = keys[0];
        _lwcLoadGroup(keys[0]).then(function() {
            var gs = _groupSnapshots[keys[0]];
            if (gs) _lwcUpdatePriceLines(gs);
        });
    }
}

function _selectGroup(key) {
    _selectedGroup = key;
    // Update button styles
    document.querySelectorAll("#group-selector button").forEach(btn => {
        btn.className = "btn btn-sm " + (btn.dataset.group === key ? "btn-warning" : "btn-outline-secondary");
    });
    // Re-render context panels from cached data
    if (_groupSnapshots[key]) {
        _applyGroupContext(_groupSnapshots[key]);
    }
    // Load chart data for this group
    _lwcLoadGroup(key).then(function() {
        var gs = _groupSnapshots[key];
        if (gs) _lwcUpdatePriceLines(gs);
    });
}

function _applyGroupContext(g) {
    if (!g) return;

    // ── Market Context ──────────────────────────────────────
    setText("stat-session", g.currentSession || "—");
    if (g.sessionHigh > 0)
        setText("stat-session-range",
            "H: " + g.sessionHigh.toFixed(2) + " L: " + (g.sessionLow > 0 ? g.sessionLow.toFixed(2) : "—"));

    // VWAP state
    var vwapLabels = { "2": "Extended▲", "1": "Accept▲", "0": "Neutral", "-1": "Accept▼", "-2": "Extended▼" };
    var vwapColors = { "2": "pnl-pos", "1": "pnl-pos", "0": "", "-1": "pnl-neg", "-2": "pnl-neg" };
    setText("stat-vwap-state", vwapLabels[String(g.vwapState)] || "—", vwapColors[String(g.vwapState)] || "");
    if (g.vwapUpper1 > 0)
        setText("stat-vwap-bands",
            "±1σ: " + g.vwapUpper1.toFixed(1) + " / " + g.vwapLower1.toFixed(1));

    // Trend score
    setText("stat-trend-bull", g.trendScoreBull != null ? g.trendScoreBull : 0);
    setText("stat-trend-bear", g.trendScoreBear != null ? g.trendScoreBear : 0);
    var trendLabel = g.trendScoreBull >= 4 ? "TREND DAY ▲" : g.trendScoreBear >= 4 ? "TREND DAY ▼" : "Rotational";
    var trendClass = g.trendScoreBull >= 4 ? "pnl-pos" : g.trendScoreBear >= 4 ? "pnl-neg" : "text-muted";
    setText("stat-trend-label", trendLabel, "small " + trendClass);

    // Sweep info + opening drive
    var infoStr = "";
    if (g.lastSweep) infoStr += g.lastSweep;
    if (g.openingDriveBull) infoStr += (infoStr ? " | " : "") + "Drive ▲";
    if (g.openingDriveBear) infoStr += (infoStr ? " | " : "") + "Drive ▼";
    if (g.asiaCompressed) infoStr += (infoStr ? " | " : "") + "Asia ◆";
    setText("stat-sweep-info", infoStr || "—", "small text-muted");

    // Signal Strength
    var ss = g.signalStrength != null ? g.signalStrength : 0;
    var ssColor = ss >= 4 ? "pnl-pos" : ss >= 2 ? "text-warning" : "text-muted";
    setText("stat-signal-strength", ss.toFixed(1) + " / 5", ssColor);
    setText("stat-drive-score", g.driveScore != null ? g.driveScore.toFixed(1) : "0");
    setText("stat-sweep-score", g.sweepScore != null ? g.sweepScore.toFixed(1) : "0");
    setText("stat-vwap-dev-score", g.vwapDevScore != null ? g.vwapDevScore.toFixed(1) : "0");

    // ── False Breakout ──────────────────────────────────────
    var fbOrbEl = document.getElementById("fb-orb-status");
    if (fbOrbEl) {
        if (g.fbOrbActivated)             { fbOrbEl.textContent = "Activated"; fbOrbEl.className = "badge bg-success"; }
        else if (g.fbOrbBreakoutActive)   { fbOrbEl.textContent = "Tracking";  fbOrbEl.className = "badge bg-warning text-dark"; }
        else                              { fbOrbEl.textContent = "Idle";      fbOrbEl.className = "badge bg-secondary"; }
    }
    setText("fb-orb-bars",  g.fbOrbBarsInBreakout > 0 ? g.fbOrbBarsInBreakout + " bars" : "—");
    setText("fb-orb-depth", g.fbOrbPenetrationDepth > 0 ? g.fbOrbPenetrationDepth.toFixed(2) + " pts" : "—");

    var fbSessEl = document.getElementById("fb-session-status");
    if (fbSessEl) {
        if (g.fbSessionActivated)             { fbSessEl.textContent = "Activated"; fbSessEl.className = "badge bg-success"; }
        else if (g.fbSessionBreakoutActive)   { fbSessEl.textContent = "Tracking";  fbSessEl.className = "badge bg-warning text-dark"; }
        else                                  { fbSessEl.textContent = "Idle";      fbSessEl.className = "badge bg-secondary"; }
    }
    setText("fb-session-bars",  g.fbSessionBarsInBreakout > 0 ? g.fbSessionBarsInBreakout + " bars" : "—");
    setText("fb-session-depth", g.fbSessionPenetrationDepth > 0 ? g.fbSessionPenetrationDepth.toFixed(2) + " pts" : "—");

    var fbCompound = document.getElementById("fb-compound-badge");
    if (fbCompound) {
        var orbOn = g.fbOrbActivated || g.fbOrbBreakoutActive;
        var sessOn = g.fbSessionActivated || g.fbSessionBreakoutActive;
        if (orbOn && sessOn)  { fbCompound.textContent = "Compound"; fbCompound.className = "badge bg-danger ms-auto"; }
        else if (orbOn)       { fbCompound.textContent = "ORB Only"; fbCompound.className = "badge bg-warning text-dark ms-auto"; }
        else if (sessOn)      { fbCompound.textContent = "Session Only"; fbCompound.className = "badge bg-warning text-dark ms-auto"; }
        else                  { fbCompound.textContent = "Idle"; fbCompound.className = "badge bg-secondary ms-auto"; }
    }

    // ── ORB / VWAP / ATR ────────────────────────────────────
    setText("orb-high",  g.orbHigh  > 0 ? g.orbHigh.toFixed(2)  : "—");
    setText("orb-low",   g.orbLow   > 0 ? g.orbLow.toFixed(2)   : "—");
    setText("orb-mid",   g.orbMid   > 0 ? g.orbMid.toFixed(2)   : "—");
    setText("orb-range", g.orbRange > 0 ? g.orbRange.toFixed(2) + " pts" : "—");

    var orbQuality = document.getElementById("orb-quality-badge");
    if (orbQuality) {
        if (g.orbRange > 0) {
            orbQuality.textContent = g.orbBullClose ? "Bull Close" : g.orbBearClose ? "Bear Close" : "Neutral";
            orbQuality.className   = "badge " + (g.orbBullClose ? "bg-success" : g.orbBearClose ? "bg-danger" : "bg-secondary");
        } else {
            orbQuality.textContent = "Building...";
            orbQuality.className   = "badge bg-secondary";
        }
    }

    setText("stat-vwap", g.vwap > 0 ? g.vwap.toFixed(2) : "—");
    setText("stat-atr",  g.atr  > 0 ? g.atr.toFixed(2)  : "—");
    setText("stat-ema21", g.ema21 > 0 ? g.ema21.toFixed(2) : "—");
    if (g.orbAtrRatio > 0)
        setText("stat-orb-atr-ratio", "vs ORB " + g.orbAtrRatio.toFixed(2) + "x");
    else
        setText("stat-orb-atr-ratio", "vs ORB —");

    // ── Chop Regime ───────────────────────────────────────
    var chopBadge = document.getElementById("stat-chop-badge");
    if (chopBadge) {
        if (!g.chopFilterEnabled) {
            chopBadge.textContent = "OFF";
            chopBadge.className   = "badge bg-secondary";
        } else if (g.chopBlocked) {
            // Sticky RestOfDay block OR currently chop
            chopBadge.textContent = g.chopIsActive ? "CHOP" : "BLOCKED";
            chopBadge.className   = "badge bg-danger";
        } else {
            chopBadge.textContent = "CLEAR";
            chopBadge.className   = "badge bg-success";
        }
    }
    setText("stat-chop-votes",
        g.chopFilterEnabled && g.chopVotesRequired > 0
            ? "votes " + (g.chopVotes ?? 0) + "/" + g.chopVotesRequired
            : "—");

    // Per-filter breakdown (expanded view)
    updateChopFilterRow("rangeCompression", g.chopRangeCompression, "x", false);
    updateChopFilterRow("flatVwap",         g.chopFlatVwap,         "%", true);
    updateChopFilterRow("weakDrive",        g.chopWeakDrive,        "",  false);
    updateChopFilterRow("lowVolume",        g.chopLowVolume,        "x", false);
}

function updateChopFilterRow(filterKey, diag, suffix, isPct) {
    var row = document.querySelector('#chop-filter-rows tr[data-filter="' + filterKey + '"]');
    if (!row || !diag) return;
    var voteCell  = row.querySelector('[data-vote]');
    var valueCell = row.querySelector('[data-value]');
    var threshCell = row.querySelector('[data-thresh]');

    if (!diag.active) {
        voteCell.textContent  = "—";
        voteCell.className    = "text-center text-muted";
        valueCell.textContent = "—";
        threshCell.textContent = "—";
        return;
    }
    if (diag.voted) {
        voteCell.innerHTML = '<i class="bi bi-check-circle-fill"></i>';
        voteCell.className = "text-center text-danger";
    } else {
        voteCell.innerHTML = '<i class="bi bi-dash-circle"></i>';
        voteCell.className = "text-center text-success";
    }
    var format = function(v) {
        var n = Number(v);
        if (!isFinite(n)) return "—";
        var precision = isPct ? 3 : 2;
        return n.toFixed(precision) + (suffix || "");
    };
    valueCell.textContent  = format(diag.value);
    threshCell.textContent = "< " + format(diag.threshold);
}

function toggleChopDetails() {
    var row = document.getElementById("row-chop-details");
    var chevron = document.getElementById("chop-chevron");
    if (!row) return;
    var isHidden = row.style.display === "none";
    row.style.display = isHidden ? "" : "none";
    if (chevron) chevron.style.transform = isHidden ? "rotate(180deg)" : "";
}

// ── Dynamic setup card creation ───────────────────────────────
var _cardsCreated = false;

function createSetupCard(setup) {
    var id = _cardId(setup.id);
    var typeLabels = { Pullback: "\u25B2", Retest: "\u27F3", OrbFakeout: "\u2194", SessionFakeout: "\u21A9" };
    var typeChar = typeLabels[setup.strategyType] || "\u25CF";
    var row = (label, key, extra) => `<div class="ck-cell"><span>${label}</span><b id="${id}-${key}" ${extra || ''}>\u2014</b></div>`;

    var card = document.createElement("article");
    card.className = "c-panel ck-setup";
    card.id = "card-" + id;
    card.innerHTML = `
        <header class="ck-setup-h">
            <span class="ck-type" title="${_esc(setup.strategyType)}">${typeChar}</span>
            <b class="ck-name">${_esc(setup.label)}</b>
            <span class="badge" id="enabled-${id}">ON</span>
            <span class="badge" id="status-${id}">IDLE</span>
            <span class="c-mut small num" id="count-${id}">[0/${Number(setup.maxTrades ?? 0)}]</span>
            <button type="button" id="btn-exit-${id}" class="btn btn-danger btn-sm d-none ms-auto"
                    data-setup="${_esc(setup.id)}" onclick="forceExit(this.dataset.setup)" title="Close this setup's position at market">
                <i class="bi bi-x-octagon-fill me-1"></i>Exit now
            </button>
        </header>
        <div class="ck-price">
            <span id="${id}-price" class="num">\u2014</span>
            <span class="stream-dot" id="${id}-price-dot"></span>
            <span id="${id}-price-age" class="c-mut small"></span>
            <span id="${id}-ticker" class="c-mut small ms-auto"></span>
        </div>
        <div class="ck-grid">
            ${row("Direction", "dir")}
            ${row("Contracts", "cts")}
            ${row("Entry", "entry")}
            ${row("Stop", "stop")}
            ${row("Partial", "partial")}
            ${row("Target", "target")}
            ${row("Expectancy", "expectancy", 'title="(Win% \u00D7 avg win) \u2212 (Loss% \u00D7 avg loss)"')}
            ${row("Unrealized", "unreal")}
        </div>
    `;
    return card;
}

// ── Main update ───────────────────────────────────────────────
// A stopped engine isn't watching anything: setup states and the ORB status are left over from
// its last run, so they're shown as stopped rather than as if they were live.
const engineRunning = () => window.CRV?.engine?.running !== false;
let _lastDashboard = null;
document.addEventListener('crv:engine', () => { if (_lastDashboard) updateDashboard(_lastDashboard); });

function updateDashboard(d) {
    if (!d) return;
    _lastDashboard = d;
    _clearPlaceholder();   // remove "Waiting for engine..." on first live snapshot

    // ── Auto-create setup cards (recreate when count changes or on first snapshot) ──
    if (d.setups && d.setups.length > 0) {
        var container = document.getElementById("setup-cards-container");
        var setupIds = d.setups.map(s => s.id).join(',');
        if (!_cardsCreated || container.dataset.setupIds !== setupIds) {
            container.innerHTML = "";
            d.setups.forEach(s => container.appendChild(createSetupCard(s)));
            container.dataset.setupIds = setupIds;
            _cardsCreated = true;
        }
    }

    // ── Stream health ─────────────────────────────────────────
    if (d.lastPrice > 0) setText("stream-price", d.lastPrice.toFixed(2));
    // The snapshot's own time, not when this page drew it. On load the server replays the last
    // snapshot, which can be hours old; stamping it "now" made a stopped engine look live.
    if (d.lastUpdate) {
        const t = String(d.lastUpdate);
        // The server's time is UTC; read it as UTC even if it arrives without a zone suffix.
        const ms = new Date(/[zZ]|[+-]\d\d:?\d\d$/.test(t) ? t : t + 'Z').getTime();
        _lastUpdateMs = isNaN(ms) || ms <= 0 ? 0 : Math.min(ms, Date.now());
    } else {
        _lastUpdateMs = 0;   // unknown: no dot and no age, rather than a fake "live"
    }

    // ── Daily P&L stats ──────────────────────────────────────
    // Use the larger of engine vs DB stats to survive engine restarts.
    // After restart, engine starts at 0 but DB has all trades from today.
    // As the engine accumulates new trades, it will eventually catch up.
    const engineTrades = d.todayTrades ?? 0;
    const pnl    = engineTrades >= _dbStats.trades ? (d.todayPnl ?? 0) : _dbStats.pnl;
    const trades = Math.max(engineTrades, _dbStats.trades);
    const wins   = engineTrades >= _dbStats.trades ? (d.todayWins ?? 0) : _dbStats.wins;
    setText("stat-today-pnl", fmtDol(pnl), pnlCls(pnl));
    setText("stat-trades",  trades);
    // ── Win Rate gauge ──────────────────────────────────────
    const wrArc    = document.getElementById("wr-gauge-arc");
    const wrText   = document.getElementById("wr-gauge-text");
    const wrDetail = document.getElementById("wr-gauge-detail");
    if (wrArc && wrText) {
        const wrPct   = trades > 0 ? Math.round(wins / trades * 100) : 0;
        const arcLen  = 157;
        const fill    = trades > 0 ? Math.min(wrPct, 100) / 100 * arcLen : 0;
        wrArc.setAttribute("stroke-dasharray", fill + " " + arcLen);
        wrArc.dataset.tone = wrPct >= 60 ? "up" : wrPct >= 40 ? "warn" : trades > 0 ? "down" : "none";
        wrText.textContent = trades > 0 ? wrPct + "%" : "—";
        if (wrDetail) {
            const losses = trades - wins;
            wrDetail.textContent = wins + "W / " + losses + "L";
        }
    }
    const maxdd = engineTrades >= _dbStats.trades ? (d.todayMaxDD ?? 0) : _dbStats.maxDD;
    setText("stat-maxdd",   "$" + Math.abs(maxdd).toFixed(0));

    // Expectancy — fall back to DB stats after engine restart (same pattern as P&L)
    var exp = d.expectancy;
    if (!exp && _dbStats.trades > 0) {
        var s = _dbStats;
        var total = s.wins + s.losses;
        if (total > 0) {
            var wr = s.wins / total, lr = s.losses / total;
            var avgW = s.wins > 0 ? s.winPnl / s.wins : 0;
            var avgL = s.losses > 0 ? s.lossPnl / s.losses : 0;
            exp = wr * avgW - lr * avgL;
        }
    }
    setText("stat-expectancy", exp ? fmtDol(exp) : "—",
            exp ? pnlCls(exp) : "stat-value font-monospace");
    if (d.setups) {
        d.setups.forEach(s => {
            var eid = s.id.toLowerCase().replace(/[^a-z0-9]/g, '-') + "-expectancy";
            setText(eid, s.expectancy ? fmtDol(s.expectancy) : "—",
                    s.expectancy ? pnlCls(s.expectancy) : "");
        });
    }

    // ── DD Limit gauge ─────────────────────────────────────
    // Same fallback pattern as P&L: after restart engine has 0, use DB loss instead
    const ddUsedEngine = d.dailyLossUsed ?? 0;
    const ddUsedDb     = Math.max(0, -(_dbStats.pnl ?? 0));
    const ddUsed  = Math.min(engineTrades >= _dbStats.trades ? ddUsedEngine : ddUsedDb, maxDailyLoss);
    const ddPct   = maxDailyLoss > 0 ? Math.round(ddUsed / maxDailyLoss * 100) : 0;
    const ddArc   = document.getElementById("dd-gauge-arc");
    const ddText  = document.getElementById("dd-gauge-text");
    const ddGauge = document.getElementById("dd-gauge");
    const ddAmounts = document.getElementById("dd-gauge-amounts");
    if (ddArc && ddText) {
        const arcLen  = 157; // half-circle circumference for r=50
        const fill    = Math.min(ddPct, 100) / 100 * arcLen;
        ddArc.setAttribute("stroke-dasharray", fill + " " + arcLen);
        ddArc.dataset.tone = ddPct > 80 ? "down" : ddPct > 50 ? "warn" : "up";
        ddText.textContent = ddPct + "%";
        ddText.classList.toggle("bad", ddPct >= 100);
        if (ddAmounts) {
            const usedStr  = "$" + Math.round(ddUsed).toLocaleString();
            const limitStr = "$" + Math.round(maxDailyLoss).toLocaleString();
            ddAmounts.textContent = usedStr + " / " + limitStr;
        }
        // Flash when breached
        if (ddPct >= 100) {
            ddGauge.classList.add("dd-breached");
        } else {
            ddGauge.classList.remove("dd-breached");
        }
    }
    const ddBadge  = document.getElementById("dash-dd-badge");
    if (ddBadge) {
        const halted = d.tradingHalted ?? false;
        ddBadge.textContent = halted ? "DD HALTED" : "OK";
        ddBadge.className   = "badge " + (halted ? "badge-halted" : "bg-success text-dark");
    }

    // ── Session state badge ──────────────────────────────────
    const sessBadge = document.getElementById("dash-session-badge");
    if (sessBadge) {
        var allCutoff = d.setups && d.setups.length > 0 && d.setups.every(s => s.pastCutoff);
        var someCutoff = d.setups && d.setups.some(s => s.pastCutoff);
        if (!engineRunning())                      { sessBadge.textContent = "ENGINE STOPPED"; sessBadge.className = "badge bg-secondary"; }
        else if (d.sessionEnded)                   { sessBadge.textContent = "SESSION ENDED"; sessBadge.className = "badge badge-halted"; }
        else if (allCutoff)
                                                   { sessBadge.textContent = "CUTOFF";        sessBadge.className = "badge setup-armed"; }
        else if (someCutoff) {
            var cutoffs = d.setups.filter(s => s.pastCutoff).map(s => s.id);
            sessBadge.textContent = "CUTOFF (" + cutoffs.join(",") + ")";
            sessBadge.className = "badge setup-armed";
        }
        else if (d.orbFormed)                      { sessBadge.textContent = "TRADING";       sessBadge.className = "badge badge-live"; }
        else                                       { sessBadge.textContent = "ORB FORMING";   sessBadge.className = "badge setup-idle"; }
    }

    // ── Active session badge (Asia / London / NY / Idle) ─────
    const badge = document.getElementById('sessionBadge');
    if (badge) {
        if (d.activeSessionId) {
            badge.textContent = d.activeSessionId + ' Session';
            badge.className = 'badge bg-success ms-2';
        } else {
            badge.textContent = 'Idle';
            badge.className = 'badge bg-secondary ms-2';
        }
    }

    // ── Setup panels ─────────────────────────────────────────
    if (d.setups) {
        d.setups.forEach(s => {
            var id = s.id.toLowerCase().replace(/[^a-z0-9]/g, '-');
            updateSetup(id, s, d.sessionEnded);
        });
        // Add triangle markers when setup state transitions (arm/retest)
        _lwcCheckSetupMarkers(d.setups);
    }

    // ── ORB window (dynamic per session) ─────────────────────
    if (d.orbWindowStart && d.orbWindowEnd) {
        var el = document.getElementById("orb-window");
        if (el) el.textContent = d.orbWindowStart + "–" + d.orbWindowEnd;
    }

    // Active setups — find which setups belong to the selected group
    var activeSetups = [];
    var signalsList = [];

    // _tickerToGroup defined at global scope (above)

    if (d.setups) {
        d.setups.forEach(s => {
            if (_selectedGroup && _tickerToGroup(s.ticker) !== _selectedGroup) return;
            var ID = s.id;
            if (s.trade && s.trade.entry > 0) {
                activeSetups.push(ID + (s.trade.direction === 0 ? " Long" : " Short"));
            } else if (s.state !== 0) {
                var dir = s.state > 0 ? "▲" : "▼";
                signalsList.push(ID + " Armed " + dir);
            }
        });
    }
    setText("stat-active-setup", activeSetups.length > 0 ? activeSetups.join(", ") : "—");

    // ── Ticker Group context panels (Market Context, FB, ORB, VWAP, ATR) ──
    // Cache group snapshots and build pills on first snapshot
    if (d.groupSnapshots && typeof d.groupSnapshots === "object") {
        var keys = Object.keys(d.groupSnapshots).sort();
        if (keys.length > 0) {
            _groupSnapshots = d.groupSnapshots;
            _buildGroupPills(keys);
            // Apply selected group's data + live chart candle
            var sel = _selectedGroup || keys[0];
            if (_groupSnapshots[sel]) {
                _applyGroupContext(_groupSnapshots[sel]);
                // Append setup armed/retest signals to the Signals row (after _applyGroupContext)
                if (signalsList.length > 0) {
                    var el = document.getElementById("stat-sweep-info");
                    if (el) {
                        var existing = el.textContent;
                        el.textContent = (existing && existing !== "—")
                            ? existing + " | " + signalsList.join(", ")
                            : signalsList.join(", ");
                    }
                }
                // Live candle update for active chart group
                if (sel === _lwcCurrentGroup) {
                    _lwcUpdateCandle(_groupSnapshots[sel]);
                    _lwcUpdatePriceLines(_groupSnapshots[sel]);
                }
            }
        }
    } else {
        // Fallback: no group snapshots (legacy/single-ticker) — use flat fields
        setText("orb-high",  d.orbHigh  > 0 ? d.orbHigh.toFixed(2)  : "—");
        setText("orb-low",   d.orbLow   > 0 ? d.orbLow.toFixed(2)   : "—");
        setText("orb-mid",   d.orbMid   > 0 ? d.orbMid.toFixed(2)   : "—");
        setText("orb-range", d.orbRange > 0 ? d.orbRange.toFixed(2) + " pts" : "—");
        setText("stat-vwap", d.vwap > 0 ? d.vwap.toFixed(2) : "—");
        setText("stat-atr",  d.atr  > 0 ? d.atr.toFixed(2)  : "—");
        setText("stat-ema21", d.ema21 > 0 ? d.ema21.toFixed(2) : "—");
        if (d.orbAtrRatio > 0)
            setText("stat-orb-atr-ratio", "vs ORB " + d.orbAtrRatio.toFixed(2) + "x");
        setText("stat-session", d.currentSession || "—");
        if (d.sessionHigh > 0)
            setText("stat-session-range",
                "H: " + d.sessionHigh.toFixed(2) + " L: " + (d.sessionLow > 0 ? d.sessionLow.toFixed(2) : "—"));
    }

    // VWAP position — uses the selected group's price and VWAP
    var selGs = _selectedGroup && _groupSnapshots[_selectedGroup] ? _groupSnapshots[_selectedGroup] : null;
    var selVwap = selGs ? selGs.vwap : d.vwap;
    var selPrice = selGs ? selGs.barClose : d.lastPrice;  // group's live price, not global
    if (selVwap > 0 && selPrice > 0) {
        const above = selPrice > selVwap;
        setText("stat-vwap-pos", above ? "Above VWAP" : "Below VWAP",
            "small " + (above ? "pnl-pos" : "pnl-neg"));
    }

    // EMA21 position
    var selEma21 = selGs ? selGs.ema21 : d.ema21;
    if (selEma21 > 0 && selPrice > 0) {
        const aboveEma = selPrice > selEma21;
        setText("stat-ema21-pos", aboveEma ? "Above EMA" : "Below EMA",
            "small " + (aboveEma ? "pnl-pos" : "pnl-neg"));
    }

    // ── Per-setup trade counts [N/Max] ─────────────────────────
    if (d.setups) {
        d.setups.forEach(s => {
            var sid = s.id.toLowerCase().replace(/[^a-z0-9]/g, '-');
            var el = document.getElementById("count-" + sid);
            if (el) {
                el.textContent = "[" + s.tradeCount + "/" + (s.maxTrades ?? 0) + "]";
            }
        });
    }

    // ── Alerts from snapshot ─────────────────────────────────
    const alerts = d.recentAlerts;
    if (alerts && alerts.length > 0) {
        // Filter to only alerts newer than the last one we rendered
        const newAlerts = _lastAlertTime
            ? alerts.filter(a => new Date(a.time) > _lastAlertTime)
            : alerts;  // first load: render all
        if (newAlerts.length > 0) {
            // Sort oldest-first so prepending yields newest-on-top
            newAlerts.sort((a, b) => new Date(a.time) - new Date(b.time));
            for (const al of newAlerts) addAlert(al);
            // Track the latest alert time
            _lastAlertTime = new Date(alerts.reduce((max, a) =>
                new Date(a.time) > new Date(max.time) ? a : max).time);
        }
    }
}

// ── Confirmation modal helper ─────────────────────────────────
const _dashModal = new bootstrap.Modal(document.getElementById('dashConfirmModal'));
function dashConfirm(title, bodyHtml, btnClass, onConfirm) {
    document.getElementById('dashConfirm-title').textContent = title;
    document.getElementById('dashConfirm-body').innerHTML    = bodyHtml;
    const okBtn = document.getElementById('dashConfirm-ok');
    okBtn.className = 'btn ' + (btnClass || 'btn-warning');
    okBtn.textContent = title;
    const fresh = okBtn.cloneNode(true);
    okBtn.replaceWith(fresh);
    fresh.addEventListener('click', () => { _dashModal.hide(); onConfirm(); });
    _dashModal.show();
}

// ── Force Exit ────────────────────────────────────────────────
function forceExit(setup) {
    dashConfirm(
        'Exit now',
        `<p class="mb-0">Close <strong>${_esc(setup)}</strong>'s position at market now?</p>`,
        'btn-danger',
        () => _doForceExit(setup)
    );
}
async function _doForceExit(setup) {
    const btn = document.getElementById("btn-exit-" + _cardId(setup));
    if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
    try {
        const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";
        const r   = await fetch("?handler=ForceExit&setupId=" + encodeURIComponent(setup), {
            method: "POST",
            headers: { "RequestVerificationToken": tok, "Content-Type": "application/json" }
        });
        if (r.ok) {
            addAlert({ type: "EXIT", setup: setup, time: new Date().toISOString(), message: "Exit sent at market" });
        } else {
            addAlert({ type: "EXIT", setup: setup, time: new Date().toISOString(), message: "Exit failed (HTTP " + r.status + "). Check Positions & orders." });
        }
    } catch (e) {
        console.error("Force exit error:", e);
        addAlert({ type: "EXIT", setup: setup, time: new Date().toISOString(), message: "Exit failed: no response from the app. Check Positions & orders." });
    } finally {
        if (btn) { btn.disabled = false; }
    }
}

function forceOrb() {
    dashConfirm(
        'Force ORB',
        '<p class="mb-0">Recalculate the opening range from the broker\'s historical bars? Setups use the new range right away.</p>',
        'btn-warning',
        _doForceOrb
    );
}
async function _doForceOrb() {
    const btn = document.getElementById("btn-force-orb");
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Loading…'; }
    try {
        const r = await fetch("/api/engine/force-orb", { method: "POST" });
        const data = await r.json();
        if (r.ok) {
            addAlert({ type: "ORB", setup: "A", time: new Date().toLocaleTimeString(), message: "Force ORB: " + data.message });
        } else {
            addAlert({ type: "ORB", setup: "A", time: new Date().toLocaleTimeString(), message: "Force ORB failed: " + data.message });
        }
    } catch (e) {
        console.error("Force ORB error:", e);
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Force ORB'; }
    }
}

// ── Setup state badge ─────────────────────────────────────────
// state: 0=Idle ±1=Armed ±2=Retest(Retest)/Active(Pullback)
function _setupBadge(state, strategyType) {
    const abs  = Math.abs(state);
    const dir  = state > 0 ? "LONG" : state < 0 ? "SHORT" : null;
    if (state === 0)                               return { text: "IDLE",                     cls: "badge setup-idle"   };
    if (abs === 1)                                 return { text: `▶ ARMED ${dir}`,           cls: "badge setup-armed"  };
    if (strategyType === "Retest" && abs === 2)    return { text: `↩ RETEST ${dir}`,          cls: "badge setup-retest" };
    /* active */                                   return { text: `● ${dir} ACTIVE`,          cls: "badge " + (state > 0 ? "setup-long" : "setup-short") };
}

// ── Setup panel renderer ──────────────────────────────────────
// trade = ActiveTradeView | null,  state = integer from setupAState / setupBState
// enabled = bool from setupAEnabled / setupBEnabled
// pastCutoff / sessionEnded = booleans to override badge when time has passed
function updateSetup(id, setup, sessionEnded) {
    if (!setup) return;
    var trade = setup.trade;
    var state = setup.state;
    var enabled = setup.enabled !== false;
    var pastCutoff = setup.pastCutoff;
    var maxTradesReached = setup.tradeCount >= setup.maxTrades;
    var lastPrice = setup.lastPrice;
    var ticker = setup.ticker;
    var pointValue = setup.pointValue;

    const statusEl  = document.getElementById("status-" + id);
    const enabledEl = document.getElementById("enabled-" + id);
    const exitBtn   = document.getElementById("btn-exit-" + id);
    const card      = statusEl?.closest(".ck-setup");

    // ── Per-setup last price (always shown, even when idle) ───
    if (lastPrice > 0) {
        setText(id + "-price", lastPrice.toFixed(2), "num");
        // When the price is from: the snapshot's time, so a replayed snapshot shows its real age.
        _setupLastPriceMs[id] = _lastUpdateMs;
    } else {
        setText(id + "-price", "—", "num");
    }
    setText(id + "-ticker", ticker || "");

    // ON / OFF badge
    if (enabledEl) {
        enabledEl.textContent = enabled ? "ON" : "OFF";
        enabledEl.className   = "badge " + (enabled ? "bg-success" : "bg-secondary");
    }

    // When disabled, show DISABLED in status badge and dim the card
    if (!enabled) {
        if (statusEl) { statusEl.textContent = "DISABLED"; statusEl.className = "badge bg-secondary ms-auto"; }
        if (exitBtn)  exitBtn.classList.add("d-none");
        if (card)     card.style.opacity = "0.45";
        ["dir","entry","stop","partial","target","cts","unreal"].forEach(f => setText(id + "-" + f, "—"));
        return;
    }

    if (card) card.style.opacity = "";  // restore if re-enabled

    if (!trade) {
        // Override state badge when past cutoff, session ended, or max trades reached
        let badge;
        if (!engineRunning())    badge = { text: "STOPPED",       cls: "badge bg-secondary" };
        else if (sessionEnded)   badge = { text: "SESSION ENDED", cls: "badge badge-halted" };
        else if (maxTradesReached) badge = { text: "MAX TRADES",   cls: "badge badge-halted" };
        else if (pastCutoff)     badge = { text: "CUTOFF",        cls: "badge setup-armed" };
        else                     badge = _setupBadge(state ?? 0, setup.strategyType);
        if (statusEl) { statusEl.textContent = badge.text; statusEl.className = badge.cls; }
        if (exitBtn)  exitBtn.classList.add("d-none");
        ["dir","entry","stop","partial","target","cts","unreal"].forEach(f => setText(id + "-" + f, "—"));
        // Expectancy persists (updated by updateDashboard from snapshot totals)
        return;
    }

    // Direction enum: 0 = Long, 1 = Short
    const isLong = trade.direction === 0;
    if (statusEl) {
        let statusText = "● " + (isLong ? "LONG" : "SHORT") + " ACTIVE";
        if (trade.groupStatus) {
            const gs = trade.groupStatus.toUpperCase();
            statusText += " [" + gs + "]";
        }
        statusEl.textContent = statusText;
        statusEl.className   = "badge " + (isLong ? "setup-long" : "setup-short");
    }

    if (exitBtn) exitBtn.classList.remove("d-none");
    setText(id + "-dir",     isLong ? "▲ LONG" : "▼ SHORT", isLong ? "pnl-pos" : "pnl-neg");
    setText(id + "-entry",   trade.entry?.toFixed(2) ?? "—");

    // ── Stop / Partial / Target with USD risk/reward ──────────
    const pv = trade.pointValue || pointValue || 0;
    const rem = trade.partialFilled ? trade.remainingContracts : trade.contracts;

    // Stop — dollar risk + points distance
    const stopPrice = trade.currentStop;
    let stopLabel = (stopPrice?.toFixed(2) ?? "—") + (trade.partialFilled ? " (BE)" : "");
    if (stopPrice != null && trade.entry != null && pv > 0) {
        const stopUsd = Math.abs(trade.entry - stopPrice) * rem * pv;
        const stopPts = Math.abs(trade.entry - stopPrice);
        stopLabel += " | $" + Math.round(stopUsd).toLocaleString() + " | " + stopPts.toFixed(2) + " pts";
    }
    setText(id + "-stop", stopLabel);

    // Partial — dollar gain + points distance
    const partPrice = trade.partial;
    let partLabel = partPrice?.toFixed(2) ?? "—";
    if (partPrice != null && trade.entry != null && pv > 0) {
        const partCts = trade.partialFilled
            ? (trade.contracts - trade.remainingContracts)   // actual exited contracts
            : (trade.partialContracts || Math.floor(trade.contracts / 2));  // from config, fallback to half
        const partUsd = Math.abs(partPrice - trade.entry) * partCts * pv;
        const partPts = Math.abs(partPrice - trade.entry);
        partLabel += " | $" + Math.round(partUsd).toLocaleString() + " | " + partPts.toFixed(2) + " pts";
    }
    if (trade.partialFilled) partLabel += " ✓";
    setText(id + "-partial", partLabel);

    // Target — realistic total P&L (partial + remaining to target)
    const tgtPrice = trade.target;
    let tgtLabel = tgtPrice?.toFixed(2) ?? "—";
    if (tgtPrice != null && trade.entry != null && pv > 0) {
        const tgtPts = Math.abs(tgtPrice - trade.entry);
        const partCts = trade.partialContracts || Math.floor(trade.contracts / 2);
        const remCts  = trade.contracts - partCts;  // contracts that ride to target
        // Target P&L for remaining contracts
        const tgtRemUsd = tgtPts * remCts * pv;
        // Partial P&L for exited contracts (add projected partial gain)
        const partPts = partPrice != null ? Math.abs(partPrice - trade.entry) : 0;
        const partLockedUsd = partPts * partCts * pv;
        const totalUsd = tgtRemUsd + partLockedUsd;
        tgtLabel += " | $" + Math.round(totalUsd).toLocaleString() + " | " + tgtPts.toFixed(2) + " pts";
    }
    setText(id + "-target", tgtLabel);

    setText(id + "-cts",   rem + "/" + trade.contracts);
    setText(id + "-unreal", fmtDol(trade.unrealizedPnl));
}

// ── Alert feed ────────────────────────────────────────────────
function addAlert(a) {
    const feed = document.getElementById("alert-feed");
    if (!feed) return;
    _clearPlaceholder();
    // Determine CSS class from alert type
    const t = a.type ?? "";
    const cls = t === "ENTRY" ? "entry" : t === "EXIT" ? "exit"
              : t === "ORB" || t === "ARMED" ? "info" : "partial";
    // Format time — may be ISO string from server or pre-formatted string
    let timeStr = "";
    if (a.time) {
        const d = new Date(a.time);
        timeStr = isNaN(d) ? a.time : d.toLocaleTimeString("en-US", { timeZone: "America/New_York", hour12: false });
    }
    // Prefer setupLabel (basket ID like "retest-mnq"), fall back to enum
    const setupMap = { 0: "A", 1: "B", 2: "C", 3: "D", 4: "F" };
    const setup = a.setupLabel || (typeof a.setup === "number" ? (setupMap[a.setup] ?? a.setup) : (a.setup ?? ""));
    const div  = document.createElement("div");
    div.className = "alert-item " + cls;
    div.innerHTML = `<span class="c-mut">${_esc(timeStr)}</span> <strong>${_esc(setup)}</strong> ${_esc(a.message ?? "")}`;
    feed.insertBefore(div, feed.firstChild);
    while (feed.children.length > 50) feed.removeChild(feed.lastChild);
}

function clearAlerts() {
    const feed = document.getElementById("alert-feed");
    if (feed) feed.innerHTML = "";
}

// ── Today's Trades table ─────────────────────────────────────────
function addTradeRow(t) {
    const tbody = document.getElementById("trade-tbody");
    if (!tbody) return;
    // Remove "No trades today" placeholder
    const placeholder = tbody.querySelector("td[colspan]");
    if (placeholder) placeholder.closest("tr").remove();
    // Update count badge
    const count = tbody.querySelectorAll("tr").length + 1;
    const badge = document.getElementById("today-trade-count");
    if (badge) badge.textContent = count + (count === 1 ? " trade" : " trades");
    // Build row
    const pnl = t.netPnl ?? 0;
    const cls = pnl > 0 ? "c-up" : pnl < 0 ? "c-down" : "";
    const isLong = t.dir === "Long";
    const tr = document.createElement("tr");
    tr.innerHTML = `<td>${_esc(t.time)}</td><td class="t">${_esc(t.setup)}</td><td>${_esc((t.ticker || "—").replace(/^\//, ""))}</td>`
        + `<td><span class="c-side ${isLong ? "long" : "short"}">${isLong ? "LONG" : "SHORT"}</span></td>`
        + `<td class="r">${(t.entry ?? 0).toFixed(2)}</td><td class="r">${(t.exit ?? 0).toFixed(2)}</td>`
        + `<td class="t">${_esc(t.reason ?? "")}</td>`
        + `<td class="r ${cls}"><b>${pnl >= 0 ? "+$" : "−$"}${Math.abs(pnl).toFixed(0)}</b></td>`
        + `<td class="r ${cls}">${(t.r ?? 0).toFixed(1)}R</td>`;
    tbody.insertBefore(tr, tbody.firstChild);
}

// ── Initialize Lightweight Charts on page load ───────────────
_initLwcChart();

// Eagerly try to load chart bars on page load (don't wait for SignalR).
(async function() {
    try {
        var resp = await fetch("/api/engine/status");
        if (!resp.ok) return;
        var s = await resp.json();
        var d = s && s.snapshot;
        if (d && d.groupSnapshots) {
            var keys = Object.keys(d.groupSnapshots).sort();
            if (keys.length > 0) {
                _groupSnapshots = d.groupSnapshots;
                _buildGroupPills(keys);
                var sel = _selectedGroup || keys[0];
                _selectedGroup = sel;
                _applyGroupContext(d.groupSnapshots[sel]);
                await _lwcLoadGroup(sel);
                if (d.groupSnapshots[sel]) _lwcUpdatePriceLines(d.groupSnapshots[sel]);
                return;
            }
        }
    } catch(e) { console.warn("Status fetch failed, trying direct bar load", e); }
    // Fallback: if status had no group snapshots, try pills already in DOM
    var pills = document.querySelectorAll("#group-selector button");
    if (pills.length > 0) {
        var key = pills[0].dataset.group;
        if (key) { _selectedGroup = key; await _lwcLoadGroup(key); }
    }
})();
</script>
}

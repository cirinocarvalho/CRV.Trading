@page "/trading/orders"
@model CRV.Web.Pages.Trading.OrdersModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Order history";
    ViewData["Page"]  = "orders";
    // Shared between sections — the link carries which one the user came from,
    // so landing here from Options does not flip the nav back to Futures.
    ViewData["Section"] = Request.Query["section"] == "options" ? "options" : "futures";
    ViewData["LightReady"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="c-head">
    <h1>Order history</h1>
    <span class="c-sub">Orders at the broker, and the engine's bracket groups</span>
    <div class="c-acts">
        <span class="c-badge" id="orders-updated">—</span>
    </div>
</div>

@if (Model.Messages.Count > 0)
{
    <div class="c-note mb-3" role="status"><i class="bi bi-info-circle"></i>
        <span>@foreach (var m in Model.Messages) { <span class="d-block">@m</span> }</span></div>
}

<section class="c-panel mb-3">
    <div class="c-panel-b">
        <div class="ho-filters">
            <div class="ho-field">
                <label class="form-label" for="f-broker">Broker</label>
                <select id="f-broker" class="form-select" onchange="onBrokerChanged()">
                    @foreach (var b in new[] { "Mock", "Schwab", "TradeStation", "Tradovate" })
                    {
                        <option value="@b" selected="@(b == Model.CurrentBroker ? "selected" : null)">@b</option>
                    }
                </select>
            </div>
            <div class="ho-field">
                <label class="form-label" for="f-asset">Show</label>
                <select id="f-asset" class="form-select" onchange="renderOrders(_lastOrders)">
                    <option value="">Futures and options</option>
                    <option value="FUTURE" selected="@(Request.Query["section"] == "options" ? null : "selected")">Futures</option>
                    <option value="OPTION" selected="@(Request.Query["section"] == "options" ? "selected" : null)">Options</option>
                </select>
            </div>
            <div class="ho-field">
                <label class="form-label" for="f-status">Status</label>
                <select id="f-status" class="form-select"></select>
            </div>
            <div class="ho-field">
                <label class="form-label" for="f-setup">Setup <small class="c-mut">(groups)</small></label>
                <select id="f-setup" class="form-select" onchange="applyGroupFilter()">
                    <option value="">All, including none</option>
                    <option value="__has_setup__" selected>All with a setup</option>
                </select>
            </div>
            <div class="ho-field">
                <label class="form-label" for="f-from">From</label>
                <input type="date" id="f-from" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="ho-field">
                <label class="form-label" for="f-to">To</label>
                <input type="date" id="f-to" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="ho-field ho-actions">
                <button class="btn btn-warning" onclick="loadOrders()"><i class="bi bi-search me-1"></i>Search</button>
                <label class="c-switch ho-auto mb-0">
                    <span>Refresh every 30 s</span>
                    <input class="form-check-input" type="checkbox" role="switch" id="auto-refresh" />
                </label>
            </div>
        </div>
    </div>
</section>

<div class="c-seg mb-3" role="tablist" aria-label="Order views">
    <button class="active" data-bs-toggle="tab" data-bs-target="#tab-broker" type="button" role="tab" aria-selected="true">Broker orders</button>
    <button data-bs-toggle="tab" data-bs-target="#tab-groups" type="button" role="tab" aria-selected="false" onclick="loadGroupOrders()">Engine groups</button>
</div>

<div class="tab-content">
<div class="tab-pane fade show active" id="tab-broker" role="tabpanel">
<section class="c-panel">
    <div class="c-panel-b">
        <div id="orders-error" class="c-note bad d-none mb-2"></div>
        <div class="table-responsive c-table-wrap">
            <table class="table table-sm table-hover mb-0 ho-table" id="orders-table">
                <thead>
                    <tr class="small c-mut">
                        <th>Order</th><th>Setup</th><th>Symbol</th><th>Type</th><th>Action</th>
                        <th class="text-end">Qty</th><th class="text-end">Limit</th><th class="text-end">Stop</th>
                        <th>Status</th><th>Placed</th><th></th>
                    </tr>
                </thead>
                <tbody id="orders-tbody">
                    <tr><td colspan="11" class="text-center c-mut small py-3">Loading…</td></tr>
                </tbody>
            </table>
        </div>
        <div class="small c-mut mt-2" id="orders-count"></div>
    </div>
</section>
</div>

<div class="tab-pane fade" id="tab-groups" role="tabpanel">
<section class="c-panel">
    <div class="c-panel-b">
        <div id="groups-error" class="c-note bad d-none mb-2"></div>
        <div class="table-responsive c-table-wrap">
            <table class="table table-sm table-hover mb-0 ho-table" id="groups-table">
                <thead>
                    <tr class="small c-mut">
                        <th>Group</th><th>Setup</th><th>Ticker</th><th>Side</th><th class="text-end">Cts</th>
                        <th class="text-end">Entry</th><th>Status</th><th>Broker</th><th>Created</th><th>Completed</th><th></th>
                    </tr>
                </thead>
                <tbody id="groups-tbody">
                    <tr><td colspan="11" class="text-center c-mut small py-3">Loading…</td></tr>
                </tbody>
            </table>
        </div>
        <div class="small c-mut mt-2" id="groups-count"></div>
        <p class="small c-mut mt-1 mb-0">Tap a group to see its legs.</p>
    </div>
</section>
</div>
</div>

<!-- Cancel confirmation -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title"><i class="bi bi-x-circle c-down me-2"></i>Cancel order</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-0">Cancel order <span class="num" id="cancel-modal-id"></span>?</p>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-sm btn-danger" id="cancel-confirm-btn"><i class="bi bi-x-circle me-1"></i>Yes, cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Flatten group confirmation -->
<div class="modal fade" id="flatGroupModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title"><i class="bi bi-x-lg c-down me-2"></i>Close this group</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3" id="flat-group-body"></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-sm btn-danger" id="flat-group-confirm-btn"><i class="bi bi-x-lg me-1"></i>Yes, close at market</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let _ordersTimer = null;

const _tsStatuses = [
    { value: 'ALL', label: 'All' },
    { value: 'OPN', label: 'Open' },
    { value: 'ACK', label: 'Acknowledged' },
    { value: 'FPR', label: 'Partial Fill' },
    { value: 'FLL', label: 'Filled' },
    { value: 'CAN', label: 'Cancelled' },
    { value: 'REJ', label: 'Rejected' },
    { value: 'EXP', label: 'Expired' },
];
const _defaultStatuses = [
    { value: 'ALL', label: 'All' },
    { value: 'WORKING', label: 'Working' },
    { value: 'ACCEPTED', label: 'Accepted' },
    { value: 'FILLED', label: 'Filled' },
    { value: 'CANCELED', label: 'Cancelled' },
    { value: 'REJECTED', label: 'Rejected' },
    { value: 'EXPIRED', label: 'Expired' },
];

function onBrokerChanged() {
    const broker = document.getElementById('f-broker').value;
    const sel    = document.getElementById('f-status');
    const opts   = broker === 'TradeStation' ? _tsStatuses : _defaultStatuses;
    sel.innerHTML = opts.map(o => `<option value="${o.value}">${o.label}</option>`).join('');
    loadOrders();
}

function loadOrders() {
    const broker = document.getElementById('f-broker').value;
    const status = document.getElementById('f-status').value;
    const from   = document.getElementById('f-from').value;
    const to     = document.getElementById('f-to').value;
    const url    = `?handler=Orders&broker=${encodeURIComponent(broker)}&status=${status}&from=${from}&to=${to}`;

    document.getElementById('orders-tbody').innerHTML =
        '<tr><td colspan="11" class="text-center text-muted small py-3">Loading…</td></tr>';
    document.getElementById('orders-error').classList.add('d-none');

    fetch(url)
        .then(r => r.text().then(text => {
            // Read body as text first so we can show real error even if it's an HTML page
            if (!r.ok) throw new Error(`HTTP ${r.status} — ${text.substring(0, 500)}`);
            try { return JSON.parse(text); }
            catch { throw new Error(`Non-JSON response: ${text.substring(0, 200)}`); }
        }))
        .then(data => renderOrders(data))
        .catch(err => {
            document.getElementById('orders-error').textContent = 'Load error: ' + err;
            document.getElementById('orders-error').classList.remove('d-none');
            document.getElementById('orders-tbody').innerHTML =
                '<tr><td colspan="11" class="text-center text-muted small py-3">Error.</td></tr>';
        });
}

let _lastOrders = [];

function renderOrders(data) {
    _lastOrders = data;
    const tbody   = document.getElementById('orders-tbody');
    const errEl   = document.getElementById('orders-error');
    errEl.classList.add('d-none');

    if (data.error) {
        errEl.textContent = data.error;
        errEl.classList.remove('d-none');
        tbody.innerHTML = '<tr><td colspan="11" class="text-center text-muted small py-3">Error.</td></tr>';
        return;
    }

    const all = Array.isArray(data) ? data : [];
    // Futures / options: option orders are tagged OPTION; anything else counts as futures.
    const asset = document.getElementById('f-asset').value;
    const orders = asset === 'OPTION' ? all.filter(o => o.assetType === 'OPTION')
                 : asset === 'FUTURE' ? all.filter(o => o.assetType !== 'OPTION') : all;
    document.getElementById('orders-updated').textContent = 'updated ' + new Date().toLocaleTimeString();
    document.getElementById('orders-count').textContent   = orders.length === all.length
        ? `${orders.length} order(s)` : `${orders.length} of ${all.length} order(s)`;

    if (orders.length === 0) {
        tbody.innerHTML = '<tr><td colspan="11" class="text-center text-muted small py-3">No orders found.</td></tr>';
        return;
    }

    const statusCls = s => {
        s = (s || '').toUpperCase();
        if (s.includes('FILL') || s === 'FLL') return 'c-up';
        if (s.includes('WORK') || s === 'OPN' || s === 'ACK') return 'ho-working';
        if (s.includes('CANCEL') || s === 'CAN') return 'c-mut';
        if (s.includes('REJECT') || s === 'REJ') return 'c-down';
        return '';
    };

    const fmtPrice = v => v == null ? '—' : Number(v).toLocaleString('en-US',
        {minimumFractionDigits: 2, maximumFractionDigits: 2});

    const fmtTime = t => {
        if (!t) return '—';
        try { return new Date(t).toLocaleString(); } catch { return t; }
    };

    tbody.innerHTML = orders.map(o => {
        const cancelBtn = o.canCancel
            ? `<button class="btn btn-outline-danger btn-sm py-0 px-2"
                       onclick="cancelOrder('${o.orderId}')">
                   <i class="bi bi-x-circle me-1"></i>Cancel
               </button>`
            : '';

        const setupBadge = o.setup
            ? `<span class="c-badge warn">${o.setup}</span>`
            : '—';
        return `<tr>
            <td class="small">${o.orderId}</td>
            <td>${setupBadge}</td>
            <td class="fw-bold">${o.displaySymbol || o.symbol || '—'}
                ${o.assetType === 'OPTION' ? '<span class="c-badge info ms-1">OPT</span>' : ''}
                ${o.isMultiLeg ? `<div class="small c-mut num">${o.legs.map(l =>
                    `${l.instruction} ${l.quantity} ${l.symbol}`).join('<br>')}</div>` : ''}</td>
            <td>${o.orderType || '—'}</td>
            <td>${o.action || '—'}</td>
            <td class="text-end">${o.quantity || '—'}</td>
            <td class="text-end">${fmtPrice(o.limitPrice)}</td>
            <td class="text-end">${fmtPrice(o.stopPrice)}</td>
            <td class="${statusCls(o.status)} small">${o.statusLabel || o.status}</td>
            <td class="small c-mut">${fmtTime(o.placedTime)}</td>
            <td class="text-end">${cancelBtn}</td>
        </tr>`;
    }).join('');
}

let _cancelOrderId = null;
const _cancelModal = new bootstrap.Modal(document.getElementById('cancelModal'));

function cancelOrder(orderId) {
    _cancelOrderId = orderId;
    document.getElementById('cancel-modal-id').textContent = orderId;
    _cancelModal.show();
}

document.getElementById('cancel-confirm-btn').addEventListener('click', async () => {
    if (!_cancelOrderId) return;
    const btn = document.getElementById('cancel-confirm-btn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Cancelling…';

    const broker = document.getElementById('f-broker').value;
    const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value
             || '@Html.Raw(Antiforgery.GetAndStoreTokens(HttpContext).RequestToken)';
    try {
        const res = await fetch(`?handler=CancelOrder&broker=${encodeURIComponent(broker)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': tok },
            body: `orderId=${encodeURIComponent(_cancelOrderId)}&broker=${encodeURIComponent(broker)}`
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        _cancelModal.hide();
        loadOrders(); // refresh table immediately
    } catch (err) {
        CRV.toast('Cancel failed: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Yes, cancel';
        _cancelOrderId = null;
    }
});

// Auto-refresh toggle
document.getElementById('auto-refresh').addEventListener('change', e => {
    if (e.target.checked) {
        _ordersTimer = setInterval(loadOrders, 30000);
    } else {
        if (_ordersTimer) { clearInterval(_ordersTimer); _ordersTimer = null; }
    }
});

// ── Group Orders ─────────────────────────────────────────────
function loadGroupOrders() {
    const from = document.getElementById('f-from').value;
    const to   = document.getElementById('f-to').value;
    const broker = document.getElementById('f-broker').value;
    const url  = `?handler=GroupOrders&broker=${encodeURIComponent(broker)}&from=${from}&to=${to}`;

    document.getElementById('groups-tbody').innerHTML =
        '<tr><td colspan="10" class="text-center text-muted small py-3">Loading…</td></tr>';
    document.getElementById('groups-error').classList.add('d-none');

    fetch(url)
        .then(r => r.json())
        .then(data => renderGroupOrders(data))
        .catch(err => {
            document.getElementById('groups-error').textContent = 'Load error: ' + err;
            document.getElementById('groups-error').classList.remove('d-none');
        });
}

// Store last loaded data for client-side filtering
let _lastGroupData = [];

function renderGroupOrders(data) {
    _lastGroupData = Array.isArray(data) ? data : [];

    // Populate setup filter dropdown with unique setups from data
    const setupSel = document.getElementById('f-setup');
    const curVal = setupSel.value;
    const setups = [...new Set(_lastGroupData.map(g => g.setupId).filter(s => s))].sort();
    // Keep first two static options, remove old dynamic ones
    while (setupSel.options.length > 2) setupSel.remove(2);
    for (const s of setups) {
        const opt = document.createElement('option');
        opt.value = s; opt.textContent = s;
        setupSel.add(opt);
    }
    setupSel.value = curVal || '';

    applyGroupFilter();
}

function fmtDt(s) {
    if (!s) return '—';
    const d = new Date(s);
    if (isNaN(d)) return s;
    return d.toLocaleString('en-US', { month:'2-digit', day:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false, timeZone:'America/New_York' });
}

function applyGroupFilter() {
    const tbody = document.getElementById('groups-tbody');
    const setupFilter = document.getElementById('f-setup').value;

    if (_lastGroupData.error) {
        document.getElementById('groups-error').textContent = _lastGroupData.error;
        document.getElementById('groups-error').classList.remove('d-none');
        return;
    }

    let groups = _lastGroupData;

    // Apply setup filter
    if (setupFilter === '__has_setup__') {
        groups = groups.filter(g => g.setupId);
    } else if (setupFilter) {
        groups = groups.filter(g => g.setupId === setupFilter);
    }
    // default (empty) = show all including blank

    document.getElementById('groups-count').textContent = `${groups.length} group(s)`;

    if (groups.length === 0) {
        tbody.innerHTML = '<tr><td colspan="11" class="text-center text-muted small py-3">No group orders found.</td></tr>';
        return;
    }

    const statusCls = s => {
        if (s === 'Active' || s === 'PartialFilled') return 'ho-working';
        if (s === 'Completed') return 'c-up';
        if (s === 'Canceled') return 'c-mut';
        return '';
    };
    const fmtP = v => v == null ? '—' : Number(v).toFixed(2);

    let html = '';
    for (const g of groups) {
        const dirCls = g.direction === 'Long' ? 'c-up' : 'c-down';
        const isActive = g.status === 'Active' || g.status === 'Pending' || g.status === 'PartialFilled';
        const flatBtn = isActive
            ? `<button class="btn btn-danger btn-sm py-0 px-2"
                       onclick="event.stopPropagation(); flatGroup('${g.groupOrderId}', '${g.setupId}', '${g.direction}', ${g.totalContracts})">
                   <i class="bi bi-x-lg me-1"></i>Close
               </button>`
            : '';
        html += `<tr style="cursor:pointer" onclick="this.nextElementSibling?.classList.toggle('d-none')">
            <td class="small fw-bold">${g.groupOrderId}</td>
            <td><span class="c-badge warn">${g.setupId}</span></td>
            <td>${g.ticker || '—'}</td>
            <td class="${dirCls}">${g.direction === 'Long' ? '▲ LONG' : '▼ SHORT'}</td>
            <td class="text-end">${g.totalContracts}</td>
            <td class="text-end">${fmtP(g.entryPrice)}</td>
            <td class="${statusCls(g.status)} small">${g.status}</td>
            <td class="small">${g.broker}</td>
            <td class="small c-mut">${fmtDt(g.createdAt)}</td>
            <td class="small c-mut">${fmtDt(g.completedAt)}</td>
            <td class="text-end">${flatBtn}</td>
        </tr>`;
        // Expandable legs row
        if (g.legs && g.legs.length > 0) {
            html += `<tr class="d-none"><td colspan="11" class="px-4 py-1">
                <table class="table table-sm table-borderless mb-0 num small">
                    <thead><tr class="c-mut"><th>Leg</th><th>Order ID</th><th>Type</th><th>Action</th>
                        <th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Fill</th>
                        <th>Status</th><th>Fill Time</th></tr></thead>
                    <tbody>${g.legs.map(l => `<tr>
                        <td class="fw-bold">${l.legType}</td>
                        <td class="small">${l.orderId}</td>
                        <td>${l.orderType}</td>
                        <td>${l.action}</td>
                        <td class="text-end">${l.quantity}</td>
                        <td class="text-end">${fmtP(l.price)}</td>
                        <td class="text-end">${fmtP(l.fillPrice)}</td>
                        <td class="${statusCls(l.status)}">${l.status}</td>
                        <td class="small c-mut">${l.fillTime || '—'}</td>
                    </tr>`).join('')}</tbody>
                </table>
            </td></tr>`;
        }
    }
    tbody.innerHTML = html;
}

// ── Flat group order ──────────────────────────────────────────
let _flatGroupId = null;
const _flatGroupModal = new bootstrap.Modal(document.getElementById('flatGroupModal'));

function flatGroup(groupOrderId, setupId, direction, contracts) {
    _flatGroupId = groupOrderId;
    const dirCls = direction === 'Long' ? 'c-up' : 'c-down';
    const dirLabel = direction === 'Long' ? 'LONG' : 'SHORT';
    document.getElementById('flat-group-body').innerHTML =
        `<div class="mb-2">Close this group at <strong>market</strong>:</div>
         <table class="table table-sm table-borderless mb-0">
           <tr><td class="c-mut pe-3">Group</td><td class="num">${groupOrderId}</td></tr>
           <tr><td class="c-mut pe-3">Setup</td><td><strong>${setupId}</strong></td></tr>
           <tr><td class="c-mut pe-3">Side</td><td class="${dirCls}">${dirLabel}</td></tr>
           <tr><td class="c-mut pe-3">Contracts</td><td>${contracts}</td></tr>
         </table>
         <div class="c-note warn mt-2 small"><i class="bi bi-exclamation-triangle"></i><span>This cancels the group's stop and targets and closes its position with a market order. Other groups are not touched.</span></div>`;
    _flatGroupModal.show();
}

document.getElementById('flat-group-confirm-btn').addEventListener('click', async () => {
    if (!_flatGroupId) return;
    const btn = document.getElementById('flat-group-confirm-btn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Flattening…';

    const tok = '@Html.Raw(Antiforgery.GetAndStoreTokens(HttpContext).RequestToken)';
    try {
        const res = await fetch('?handler=FlatGroup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': tok },
            body: `groupOrderId=${encodeURIComponent(_flatGroupId)}`
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
        _flatGroupModal.hide();
        loadGroupOrders();
    } catch (err) {
        CRV.toast('Close failed: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-x-lg me-1"></i>Yes, close at market';
        _flatGroupId = null;
    }
});

// Populate status options for initial broker, then load
onBrokerChanged();
</script>
}

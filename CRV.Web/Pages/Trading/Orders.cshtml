@page "/trading/orders"
@model CRV.Web.Pages.Trading.OrdersModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Orders";
    ViewData["Page"]  = "orders";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center mb-3 gap-3">
    <h5 class="mb-0"><i class="bi bi-list-ul me-2 text-info"></i>Orders</h5>
</div>

@if (Model.Messages.Count > 0)
{
    <div class="alert alert-info" role="alert">
        <ul class="mb-0">
            @foreach (var m in Model.Messages) { <li>@m</li> }
        </ul>
    </div>
}

<!-- ── Filter bar ────────────────────────────────────────────── -->
<div class="settings-section mb-3">
    <div class="row g-2 align-items-end">

        <div class="col-auto">
            <label class="form-label small">Broker</label>
            @{
                var brokers = new[] { "Mock", "Schwab", "TradeStation", "Tradovate" };
            }
            <select id="f-broker" class="form-select form-select-sm" style="min-width:140px"
                    onchange="onBrokerChanged()">
                @foreach (var b in brokers)
                {
                    if (b == Model.CurrentBroker)
                    {
                        <option value="@b" selected>@b</option>
                    }
                    else
                    {
                        <option value="@b">@b</option>
                    }
                }
            </select>
        </div>

        <div class="col-auto">
            <label class="form-label small">Status</label>
            <select id="f-status" class="form-select form-select-sm" style="min-width:160px">
            </select>
        </div>

        <div class="col-auto">
            <label class="form-label small">From</label>
            <input type="date" id="f-from" class="form-control form-control-sm"
                   value="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-auto">
            <label class="form-label small">To</label>
            <input type="date" id="f-to" class="form-control form-control-sm"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-auto d-flex gap-2">
            <button class="btn btn-primary btn-sm" onclick="loadOrders()">
                <i class="bi bi-search me-1"></i>Search
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="loadOrders()" id="btn-refresh">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>

        <div class="col-auto ms-auto">
            <div class="form-check form-switch mt-3">
                <input class="form-check-input" type="checkbox" id="auto-refresh" />
                <label class="form-check-label small" for="auto-refresh">Auto (30s)</label>
            </div>
        </div>

        <div class="col-auto">
            <span class="badge bg-secondary small" id="orders-updated">—</span>
        </div>
    </div>
</div>

<!-- ── Orders table ──────────────────────────────────────────── -->
<div class="settings-section">
    <div id="orders-error" class="alert alert-danger d-none small py-1 mb-2"></div>

    <div class="table-responsive">
        <table class="table table-sm table-hover trade-table font-monospace" id="orders-table">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Setup</th>
                    <th>Symbol</th>
                    <th>Type</th>
                    <th>Action</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Limit</th>
                    <th class="text-end">Stop</th>
                    <th>Status</th>
                    <th>Placed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="orders-tbody">
                <tr><td colspan="11" class="text-center text-muted small py-3">Click Search to load orders.</td></tr>
            </tbody>
        </table>
    </div>

    <div class="small text-muted mt-1" id="orders-count"></div>
</div>

<!-- Cancel confirmation modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary py-2">
                <h6 class="modal-title"><i class="bi bi-x-circle text-danger me-2"></i>Cancel Order</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-0">Cancel order <code id="cancel-modal-id"></code>?</p>
            </div>
            <div class="modal-footer border-secondary py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-sm btn-danger" id="cancel-confirm-btn">
                    <i class="bi bi-x-circle me-1"></i>Yes, Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let _ordersTimer = null;

const _tsStatuses = [
    { value: 'ALL', label: 'All' },
    { value: 'OPN', label: 'Open' },
    { value: 'ACK', label: 'Acknowledged' },
    { value: 'FPR', label: 'Partial Fill' },
    { value: 'FLL', label: 'Filled' },
    { value: 'CAN', label: 'Cancelled' },
    { value: 'REJ', label: 'Rejected' },
    { value: 'EXP', label: 'Expired' },
];
const _defaultStatuses = [
    { value: 'ALL', label: 'All' },
    { value: 'WORKING', label: 'Working' },
    { value: 'ACCEPTED', label: 'Accepted' },
    { value: 'FILLED', label: 'Filled' },
    { value: 'CANCELED', label: 'Cancelled' },
    { value: 'REJECTED', label: 'Rejected' },
    { value: 'EXPIRED', label: 'Expired' },
];

function onBrokerChanged() {
    const broker = document.getElementById('f-broker').value;
    const sel    = document.getElementById('f-status');
    const opts   = broker === 'TradeStation' ? _tsStatuses : _defaultStatuses;
    sel.innerHTML = opts.map(o => `<option value="${o.value}">${o.label}</option>`).join('');
    loadOrders();
}

function loadOrders() {
    const broker = document.getElementById('f-broker').value;
    const status = document.getElementById('f-status').value;
    const from   = document.getElementById('f-from').value;
    const to     = document.getElementById('f-to').value;
    const url    = `?handler=Orders&broker=${encodeURIComponent(broker)}&status=${status}&from=${from}&to=${to}`;

    document.getElementById('orders-tbody').innerHTML =
        '<tr><td colspan="11" class="text-center text-muted small py-3">Loading…</td></tr>';
    document.getElementById('orders-error').classList.add('d-none');

    fetch(url)
        .then(r => r.text().then(text => {
            // Read body as text first so we can show real error even if it's an HTML page
            if (!r.ok) throw new Error(`HTTP ${r.status} — ${text.substring(0, 500)}`);
            try { return JSON.parse(text); }
            catch { throw new Error(`Non-JSON response: ${text.substring(0, 200)}`); }
        }))
        .then(data => renderOrders(data))
        .catch(err => {
            document.getElementById('orders-error').textContent = 'Load error: ' + err;
            document.getElementById('orders-error').classList.remove('d-none');
            document.getElementById('orders-tbody').innerHTML =
                '<tr><td colspan="11" class="text-center text-muted small py-3">Error.</td></tr>';
        });
}

function renderOrders(data) {
    const tbody   = document.getElementById('orders-tbody');
    const errEl   = document.getElementById('orders-error');
    errEl.classList.add('d-none');

    if (data.error) {
        errEl.textContent = data.error;
        errEl.classList.remove('d-none');
        tbody.innerHTML = '<tr><td colspan="11" class="text-center text-muted small py-3">Error.</td></tr>';
        return;
    }

    const orders = Array.isArray(data) ? data : [];
    document.getElementById('orders-updated').textContent = new Date().toLocaleTimeString();
    document.getElementById('orders-count').textContent   = `${orders.length} order(s)`;

    if (orders.length === 0) {
        tbody.innerHTML = '<tr><td colspan="11" class="text-center text-muted small py-3">No orders found.</td></tr>';
        return;
    }

    const statusCls = s => {
        s = (s || '').toUpperCase();
        if (s.includes('FILL') || s === 'FLL') return 'text-success';
        if (s.includes('WORK') || s === 'OPN' || s === 'ACK') return 'text-warning';
        if (s.includes('CANCEL') || s === 'CAN') return 'text-secondary';
        if (s.includes('REJECT') || s === 'REJ') return 'text-danger';
        return '';
    };

    const fmtPrice = v => v == null ? '—' : Number(v).toLocaleString('en-US',
        {minimumFractionDigits: 2, maximumFractionDigits: 2});

    const fmtTime = t => {
        if (!t) return '—';
        try { return new Date(t).toLocaleString(); } catch { return t; }
    };

    tbody.innerHTML = orders.map(o => {
        const cancelBtn = o.canCancel
            ? `<button class="btn btn-outline-danger btn-sm py-0 px-2"
                       onclick="cancelOrder('${o.orderId}')">
                   <i class="bi bi-x-circle me-1"></i>Cancel
               </button>`
            : '';

        const setupBadge = o.setup
            ? `<span class="badge bg-warning text-dark">${o.setup}</span>`
            : '—';
        return `<tr>
            <td class="small">${o.orderId}</td>
            <td>${setupBadge}</td>
            <td class="fw-bold">${o.symbol || '—'}</td>
            <td>${o.orderType || '—'}</td>
            <td>${o.action || '—'}</td>
            <td class="text-end">${o.quantity || '—'}</td>
            <td class="text-end">${fmtPrice(o.limitPrice)}</td>
            <td class="text-end">${fmtPrice(o.stopPrice)}</td>
            <td class="${statusCls(o.status)} small">${o.statusLabel || o.status}</td>
            <td class="small text-muted">${fmtTime(o.placedTime)}</td>
            <td class="text-end">${cancelBtn}</td>
        </tr>`;
    }).join('');
}

let _cancelOrderId = null;
const _cancelModal = new bootstrap.Modal(document.getElementById('cancelModal'));

function cancelOrder(orderId) {
    _cancelOrderId = orderId;
    document.getElementById('cancel-modal-id').textContent = orderId;
    _cancelModal.show();
}

document.getElementById('cancel-confirm-btn').addEventListener('click', async () => {
    if (!_cancelOrderId) return;
    const btn = document.getElementById('cancel-confirm-btn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Cancelling…';

    const broker = document.getElementById('f-broker').value;
    const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value
             || '@Html.Raw(Antiforgery.GetAndStoreTokens(HttpContext).RequestToken)';
    try {
        const res = await fetch(`?handler=CancelOrder&broker=${encodeURIComponent(broker)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': tok },
            body: `orderId=${encodeURIComponent(_cancelOrderId)}&broker=${encodeURIComponent(broker)}`
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        _cancelModal.hide();
        loadOrders(); // refresh table immediately
    } catch (err) {
        alert('Cancel failed: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Yes, Cancel';
        _cancelOrderId = null;
    }
});

// Auto-refresh toggle
document.getElementById('auto-refresh').addEventListener('change', e => {
    if (e.target.checked) {
        _ordersTimer = setInterval(loadOrders, 30000);
    } else {
        if (_ordersTimer) { clearInterval(_ordersTimer); _ordersTimer = null; }
    }
});

// Populate status options for initial broker, then load
onBrokerChanged();
</script>
}

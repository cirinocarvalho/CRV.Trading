@page "/setup/strategies"
@model CRV.Web.Pages.Setup.StrategiesModel
@using CRV.Core.Strategy
@using CRV.Web.Pages
@using CRV.Web.Pages.Setup
@{
    ViewData["Title"] = "Strategies";
    ViewData["Page"]  = "strategies";
    ViewData["LightReady"] = true;
    var on = Model.Items.Count(i => i.Entry.Enabled);
}

<div class="c-head">
    <h1>Strategies</h1>
    <span class="c-sub">@Model.Items.Count strategies · @on on · results: last 30 days, @(Model.ResultSource == "mock" ? "paper" : "live")</span>
    <div class="c-acts">
        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#st-add"><i class="bi bi-plus-lg me-1"></i>Add strategy</button>
    </div>
</div>

@if (Model.Message != null) { <div class="c-note mb-3"><i class="bi bi-check-circle"></i><span>@Model.Message</span></div> }
@if (Model.Error != null) { <div class="c-note bad mb-3" role="alert"><i class="bi bi-exclamation-octagon"></i><span>@Model.Error</span></div> }
@if (on == 0 && Model.Items.Count > 0)
{
    <div class="c-note warn mb-3"><i class="bi bi-exclamation-triangle"></i><span>No strategy is on, so the engine won't place any trades.</span></div>
}
@if (Model.LegacyInUse)
{
    <div class="c-note warn mb-3"><i class="bi bi-info-circle"></i>
        <span>You have no opening-range strategies here, so the engine uses the older A–D setups on <a href="/setup/risk">Sessions &amp; risk</a>. Add one to switch over.</span></div>
}

<section class="c-panel">
    @if (Model.Items.Count == 0)
    {
        <div class="c-empty"><i class="bi bi-diagram-3"></i><b>No strategies yet</b><span>Add one to get started.</span></div>
    }
    @foreach (var item in Model.Items.OrderByDescending(i => i.Entry.Enabled).ThenBy(i => i.Entry.Label))
    {
        var e = item.Entry;
        var name = e.Label is { Length: > 0 } ? e.Label : e.Id;
        Model.Last30.TryGetValue(e.Id, out var r);
        <div class="st-row @(e.Enabled ? "" : "off")">
            <form method="post" asp-page-handler="Toggle" class="m-0"
                  data-confirm-title="@(e.Enabled ? $"Turn {name} off?" : $"Turn {name} on?")"
                  data-confirm-body="@(e.Enabled ? "It stops taking new trades. An open trade keeps its stop and target." : "It can start placing trades" + (Model.EngineRunning ? " the next time the engine starts." : " when the engine runs."))"
                  data-confirm-ok="@(e.Enabled ? "Turn off" : "Turn on")">
                <input type="hidden" name="id" value="@e.Id" />
                <input type="hidden" name="enabled" value="@(e.Enabled ? "false" : "true")" />
                <button type="submit" class="st-switch @(e.Enabled ? "on" : "")" role="switch" aria-checked="@(e.Enabled ? "true" : "false")" aria-label="@name is @(e.Enabled ? "on" : "off")"><i></i></button>
            </form>
            <a class="st-row-main" href="/setup/strategies/@Uri.EscapeDataString(e.Id)">
                <b>@name</b>
                <small class="c-mut">@StrategyText.TypeName(e.StrategyType) · @e.Ticker · @StrategyText.Sessions(e)</small>
            </a>
            <span class="num @(r.Net > 0 ? "c-up" : r.Net < 0 ? "c-down" : "c-mut") st-row-net">@(r.Trades > 0 ? ViewFmt.Money(r.Net) : "—")<small class="d-block c-mut">@r.Trades trade@(r.Trades == 1 ? "" : "s")</small></span>
            <a class="c-mut st-row-chev" href="/setup/strategies/@Uri.EscapeDataString(e.Id)" aria-hidden="true" tabindex="-1"><i class="bi bi-chevron-right"></i></a>
        </div>
    }
</section>

<div class="modal fade c-sheet" id="st-add" tabindex="-1" aria-labelledby="st-add-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Add" class="modal-content c-form">
            <div class="modal-header">
                <h2 class="modal-title" id="st-add-title">Add a strategy</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-grid gap-3">
                <div>
                    <label class="form-label" for="st-add-type">Strategy</label>
                    <select class="form-select" id="st-add-type" name="type">
                        @foreach (var t in new[] { StrategyType.Pullback, StrategyType.Retest, StrategyType.OrbFakeout, StrategyType.SessionFakeout, StrategyType.Ema21 })
                        { <option value="@t">@StrategyText.TypeName(t)</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="st-add-instr">Instrument</label>
                    <select class="form-select" id="st-add-instr" name="instrument"></select>
                    <input type="hidden" name="tick" id="st-add-tick" value="0.25" />
                </div>
                <p class="c-mut small mb-0">It's added switched off, with starting settings you can change before turning it on.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning">Add</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const sel = document.getElementById('st-add-instr');
    const all = [...CRV_INSTRUMENTS.micro, ...CRV_INSTRUMENTS.mini];
    sel.innerHTML = ['micro', 'mini'].map(g => `<optgroup label="${g === 'micro' ? 'Micro' : 'E-mini'}">` +
        CRV_INSTRUMENTS[g].map(i => `<option value="${i.code}">${CRV.esc(CRV_activeContract(i.code))} · ${CRV.esc(i.label.split('—')[1]?.trim() || i.code)}</option>`).join('') + '</optgroup>').join('');
    const tick = () => { document.getElementById('st-add-tick').value = (all.find(i => i.code === sel.value) || {}).tickSize || 0.25; };
    sel.addEventListener('change', tick); tick();
})();
</script>
}

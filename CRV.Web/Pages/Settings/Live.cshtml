@page "/settings/live"
@model CRV.Web.Pages.Settings.LiveModel
@{
    ViewData["Title"] = "Live Settings";
    ViewData["Page"]  = "live-settings";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center mb-3 gap-3 flex-wrap">
    <h5 class="mb-0"><i class="bi bi-sliders me-2 text-warning"></i>Live Trading Settings</h5>
    @if (Model.Saved)
    {
        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Saved</span>
    }
    @if (Model.IsNearRoll)
    {
        <span class="badge bg-warning text-dark">
            <i class="bi bi-exclamation-triangle me-1"></i>ROLL SOON → @Model.ActiveContract
        </span>
    }
    <small class="text-muted" style="font-size:0.75rem">
        Last saved: <span class="font-monospace">@Model.Config.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm:ss")</span>
    </small>
    <span class="badge @(Model.IsRunning ? "bg-success" : "bg-secondary") ms-auto">
        <i class="bi bi-circle-fill me-1" style="font-size:0.6rem"></i>@Model.EngineStatus
    </span>
</div>

<!-- ── Engine Start / Stop ──────────────────────────────────── -->
<div class="d-flex gap-2 mb-3">
    @if (!Model.IsRunning)
    {
        <form method="post" asp-page-handler="Start">
            <button type="submit" class="btn btn-success btn-sm fw-bold">
                <i class="bi bi-play-fill me-1"></i>Start Engine
            </button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Stop">
            <button type="submit" class="btn btn-danger btn-sm fw-bold">
                <i class="bi bi-stop-fill me-1"></i>Stop Engine
            </button>
        </form>
    }
    <small class="text-muted align-self-center">
        Save settings first, then start the engine. Account IDs are read from
        <code>appsettings.json</code> / user-secrets (<code>Schwab:AccountId</code>,
        <code>TradeStation:AccountId</code>, <code>Tradovate:AccountId</code>).
    </small>
</div>

<!-- ── Broker Auth Status ───────────────────────────────────── -->
<div class="alert @(Model.SchwabConnected ? "alert-success" : "alert-warning") d-flex align-items-center gap-2 py-2 mb-2" role="alert">
    <i class="bi @(Model.SchwabConnected ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
    <span class="me-auto">
        <strong>Schwab:</strong>
        @if (Model.SchwabConnected)
        {
            <span>Authorized — tokens stored and ready.</span>
        }
        else
        {
            <span>Not connected. Schwab live trading requires OAuth2 authorization.</span>
        }
    </span>
    <a href="/auth/schwab" class="btn btn-sm @(Model.SchwabConnected ? "btn-outline-success" : "btn-warning") fw-bold">
        <i class="bi bi-shield-lock me-1"></i>
        @(Model.SchwabConnected ? "Manage" : "Connect Schwab")
    </a>
</div>

<div class="alert @(Model.TsConnected ? "alert-success" : "alert-warning") d-flex align-items-center gap-2 py-2 mb-2" role="alert">
    <i class="bi @(Model.TsConnected ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
    <span class="me-auto">
        <strong>TradeStation:</strong>
        @if (Model.TsConnected)
        {
            <span>Authorized — tokens stored and ready.</span>
        }
        else
        {
            <span>Not connected. TradeStation live trading requires OAuth2 authorization.</span>
        }
    </span>
    <a href="/auth/tradestation" class="btn btn-sm @(Model.TsConnected ? "btn-outline-success" : "btn-warning") fw-bold">
        <i class="bi bi-shield-lock me-1"></i>
        @(Model.TsConnected ? "Manage" : "Connect TradeStation")
    </a>
</div>

<div class="alert @(Model.TvConnected ? "alert-success" : "alert-warning") d-flex align-items-center gap-2 py-2 mb-3" role="alert">
    <i class="bi @(Model.TvConnected ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
    <span class="me-auto">
        <strong>Tradovate:</strong>
        @if (Model.TvConnected)
        {
            <span>Connected — tokens valid and ready.</span>
        }
        else
        {
            <span>Not connected. Click Connect to authenticate with your Tradovate credentials.</span>
        }
    </span>
    <a href="/auth/tradovate" class="btn btn-sm @(Model.TvConnected ? "btn-outline-success" : "btn-warning") fw-bold">
        <i class="bi bi-shield-lock me-1"></i>
        @(Model.TvConnected ? "Manage" : "Connect Tradovate")
    </a>
</div>

<form method="post" novalidate>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger py-2 small mb-3">
        <strong>Validation errors:</strong>
        <ul class="mb-0 mt-1">
        @foreach (var key in ViewData.ModelState.Keys)
        {
            @foreach (var err in ViewData.ModelState[key]!.Errors)
            {
                <li><code>@key</code>: @err.ErrorMessage</li>
            }
        }
        </ul>
    </div>
}

<input type="hidden" name="Config.BasketJson" id="basket-json" value="@(Model.Config.BasketJson ?? "")" />

<!-- ════════════════════════════════════════════════════════════ -->
<!-- ── Row 1: Global Settings (3 columns) ─────────────────── -->
<!-- ════════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-3 align-items-stretch">

<!-- ── Instrument ──────────────────────────────────────────── -->
<div class="col-12 col-xl-4">
    <div class="settings-section">
        <h6><i class="bi bi-currency-dollar me-1"></i>Instrument</h6>

        <!-- Grouped instrument selector -->
        <div class="mb-2">
            <label class="form-label small">Instrument</label>
            <select id="instr-select" class="form-select form-select-sm" onchange="instrOnChange()">
                <optgroup label="Mini">
                    <option value="NQ">NQ  — E-mini Nasdaq-100</option>
                    <option value="ES">ES  — E-mini S&amp;P 500</option>
                    <option value="YM">YM  — E-mini Dow Jones</option>
                    <option value="RTY">RTY — E-mini Russell 2000</option>
                    <option value="GC">GC  — Gold</option>
                    <option value="CL">CL  — Crude Oil</option>
                    <option value="BTC">BTC — Bitcoin</option>
                </optgroup>
                <optgroup label="Micro">
                    <option value="MNQ">MNQ — Micro Nasdaq-100</option>
                    <option value="MES">MES — Micro S&amp;P 500</option>
                    <option value="MYM">MYM — Micro Dow Jones</option>
                    <option value="M2K">M2K — Micro Russell 2000</option>
                    <option value="MGC">MGC — Micro Gold</option>
                    <option value="MCL">MCL — Micro Crude Oil</option>
                    <option value="MBT">MBT — Micro Bitcoin</option>
                </optgroup>
            </select>
        </div>

        <!-- Active contract display -->
        <div class="mb-2">
            <label class="form-label small">Active Contract</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                <input id="instr-contract" class="form-control form-control-sm font-monospace fw-bold" readonly />
                <span class="input-group-text text-muted small" id="instr-pv-label">—</span>
            </div>
            <!-- Hidden form values submitted to server -->
            <input type="hidden" name="Config.Ticker"       id="instr-ticker-hidden" value="@Model.Config.Ticker" />
            <input type="hidden" name="Config.Exchange"     value="CME" />
            <input type="hidden" name="Config.PointValue"   id="instr-pv-hidden"     value="@Model.Config.PointValue" />
            <!-- PullbackPct is not shown in the UI (derived from ModeA) but must be preserved -->
            <input type="hidden" name="Config.PullbackPct"  id="instr-pullback-pct"  value="@Model.Config.PullbackPct" />
        </div>

        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label small">Data Broker</label>
                <select name="Config.Broker" class="form-select form-select-sm">
                    <option value="Schwab"       selected="@(Model.Config.Broker=="Schwab"       ? "selected" : null)">Schwab</option>
                    <option value="TradeStation" selected="@(Model.Config.Broker=="TradeStation" ? "selected" : null)">TradeStation</option>
                    <option value="Tradovate"       selected="@(Model.Config.Broker=="Tradovate"       ? "selected" : null)">Tradovate</option>
                    <option value="TradovateReplay" selected="@(Model.Config.Broker=="TradovateReplay" ? "selected" : null)">Tradovate Replay</option>
                    <option value="Mock"            selected="@(Model.Config.Broker=="Mock"            ? "selected" : null)">Mock (Paper)</option>
                </select>
                <div class="form-text text-muted" style="font-size:.7rem">Market data + bar feed</div>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small">Exec Broker</label>
                <select name="Config.ExecBroker" class="form-select form-select-sm">
                    <option value=""             selected="@(string.IsNullOrEmpty(Model.Config.ExecBroker) ? "selected" : null)">Same as Data</option>
                    <option value="Schwab"       selected="@(Model.Config.ExecBroker=="Schwab"       ? "selected" : null)">Schwab</option>
                    <option value="TradeStation" selected="@(Model.Config.ExecBroker=="TradeStation" ? "selected" : null)">TradeStation</option>
                    <option value="Tradovate"       selected="@(Model.Config.ExecBroker=="Tradovate"       ? "selected" : null)">Tradovate</option>
                    <option value="TradovateReplay" selected="@(Model.Config.ExecBroker=="TradovateReplay" ? "selected" : null)">Tradovate Replay</option>
                    <option value="Mock"            selected="@(Model.Config.ExecBroker=="Mock"            ? "selected" : null)">Mock (Paper)</option>
                </select>
                <div class="form-text text-muted" style="font-size:.7rem">Order execution (leave empty = same)</div>
            </div>
        </div>
        <div class="row g-2 mt-1" id="replaySettings" style="display:none">
            <div class="col-12 col-md-3">
                <label class="form-label small">Replay Date</label>
                <input type="date" name="Config.ReplayDate" class="form-control form-control-sm"
                       value="@(Model.Config.ReplayDate?.ToString("yyyy-MM-dd") ?? Model.PreviousTradingDay.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small">Replay Speed</label>
                <select name="Config.ReplaySpeed" class="form-select form-select-sm">
                    @foreach (var v in new[]{25,50,100,200,400})
                    {
                        <option value="@v" selected="@(Model.Config.ReplaySpeed==v ? "selected" : null)">@v%</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small">Initial Balance</label>
                <input type="number" name="Config.ReplayBalance" class="form-control form-control-sm"
                       value="@Model.Config.ReplayBalance" min="1000" step="1000" />
            </div>
            <div class="col-12 col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input type="checkbox" name="Config.SaveReplayTrades" value="true"
                           class="form-check-input" id="saveReplayTrades"
                           checked="@(Model.Config.SaveReplayTrades ? "checked" : null)" />
                    <label class="form-check-label small" for="saveReplayTrades">Save Replay Trades</label>
                </div>
            </div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-6">
                <label class="form-label small">Tick Size</label>
                <input name="Config.TickSize" id="instr-tick-sz" type="number" step="any"
                       value="@Model.Config.TickSize" class="form-control form-control-sm" />
            </div>
            <div class="col-6">
                <label class="form-label small">Execution TF</label>
                <select name="Config.ExecutionTFMinutes" class="form-select form-select-sm">
                    <option value="1"  selected="@(Model.Config.ExecutionTFMinutes==1  ? "selected" : null)">1 min</option>
                    <option value="2"  selected="@(Model.Config.ExecutionTFMinutes==2  ? "selected" : null)">2 min</option>
                    <option value="5"  selected="@(Model.Config.ExecutionTFMinutes==5  ? "selected" : null)">5 min</option>
                    <option value="15" selected="@(Model.Config.ExecutionTFMinutes==15 ? "selected" : null)">15 min</option>
                    <option value="30" selected="@(Model.Config.ExecutionTFMinutes==30 ? "selected" : null)">30 min</option>
                    <option value="60" selected="@(Model.Config.ExecutionTFMinutes==60 ? "selected" : null)">60 min</option>
                </select>
            </div>
        </div>
        <div class="mt-2 form-text text-muted small">
            Account IDs: set <code>Schwab:AccountId</code> / <code>TradeStation:AccountId</code>
            / <code>Tradovate:AccountId</code> in <code>appsettings.json</code>.
        </div>
    </div>
</div>

<!-- ── Timeframes & Sessions ──────────────────────────────── -->
<div class="col-12 col-xl-4">
    <div class="settings-section">
        <h6><i class="bi bi-clock me-1"></i>Timeframes & Sessions</h6>
        <!-- ORB/RTH timing is configured per-session in the Session Configuration tabs below.
             These hidden fields preserve the flat config values for backward compat (backtest, defaults). -->
        <input type="hidden" name="Config.OrbStart" value="@Model.Config.OrbStart.ToString("HH:mm")" />
        <input type="hidden" name="Config.OrbEnd"   value="@Model.Config.OrbEnd.ToString("HH:mm")" />
        <input type="hidden" name="Config.RthStart"  value="@Model.Config.RthStart.ToString("HH:mm")" />
        <input type="hidden" name="Config.RthEnd"    value="@Model.Config.RthEnd.ToString("HH:mm")" />
        <input type="hidden" name="Config.ExitMinutesBefore" value="@Model.Config.ExitMinutesBefore" />
        <small class="text-muted d-block mb-2">ORB & RTH windows are configured per-session below.</small>
        <div class="mt-2">
            <label class="form-label small">Timezone</label>
            <select name="Config.Timezone" class="form-select form-select-sm">
                <option value="America/New_York"    selected="@(Model.Config.Timezone=="America/New_York"    ? "selected" : null)">America/New_York (ET)</option>
                <option value="America/Chicago"     selected="@(Model.Config.Timezone=="America/Chicago"     ? "selected" : null)">America/Chicago (CT)</option>
                <option value="America/Los_Angeles" selected="@(Model.Config.Timezone=="America/Los_Angeles" ? "selected" : null)">America/Los_Angeles (PT)</option>
                <option value="UTC"                 selected="@(Model.Config.Timezone=="UTC"                 ? "selected" : null)">UTC</option>
            </select>
        </div>
        <!-- False Breakout Module (Global) -->
        <h6 class="mt-3"><i class="bi bi-arrow-repeat me-1"></i>False Breakout Filters</h6>
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label small">Max Time Out (ORB) min</label>
                <input name="Config.FBMaxTimeOutsideMinutesOrb" type="number" min="0" step="1"
                       value="@Model.Config.FBMaxTimeOutsideMinutesOrb" class="form-control form-control-sm" />
            </div>
            <div class="col-6">
                <label class="form-label small">Max Time Out (SR) min</label>
                <input name="Config.FBMaxTimeOutsideMinutesSR" type="number" min="0" step="1"
                       value="@Model.Config.FBMaxTimeOutsideMinutesSR" class="form-control form-control-sm" />
            </div>
            <div class="col-6">
                <label class="form-label small">Max Pen % (ORB)</label>
                <input name="Config.FBMaxPenetrationPctOrb" type="number" min="0" step="0.01"
                       value="@Model.Config.FBMaxPenetrationPctOrb" class="form-control form-control-sm" />
            </div>
            <div class="col-6">
                <label class="form-label small">Max Pen % (SR)</label>
                <input name="Config.FBMaxPenetrationPctSR" type="number" min="0" step="0.01"
                       value="@Model.Config.FBMaxPenetrationPctSR" class="form-control form-control-sm" />
            </div>
            <div class="col-6">
                <label class="form-label small">Min Rejection Body %</label>
                <input name="Config.FBMinRejectionBodyPct" type="number" min="0" step="0.01"
                       value="@Model.Config.FBMinRejectionBodyPct" class="form-control form-control-sm" />
            </div>
            <div class="col-6">
                <label class="form-label small">Max Trend Day Score</label>
                <input name="Config.FBMaxTrendDayScore" type="number" min="0" step="1"
                       value="@Model.Config.FBMaxTrendDayScore" class="form-control form-control-sm" />
            </div>
        </div>
    </div>
</div>

<!-- ── Trade Filters (Global) ─────────────────────────────── -->
<div class="col-12 col-xl-4">
    <div class="settings-section">
        <h6><i class="bi bi-shield-exclamation me-1"></i>Trade Filters (Global)</h6>
        <div class="mb-2">
            <label class="form-label small">Min ORB/ATR Ratio</label>
            <input name="Config.AtrFilterPct" type="number" step="any" value="@Model.Config.AtrFilterPct" class="form-control form-control-sm" />
        </div>
        <div class="row g-2 mt-1">
            <div class="col-4">
                <label class="form-label small">Max Daily Loss ($)</label>
                <input name="Config.MaxDailyLoss" type="number" step="50" value="@Model.Config.MaxDailyLoss" class="form-control form-control-sm" />
            </div>
            <div class="col-4">
                <label class="form-label small">Loss Mode</label>
                @{ var dlm = Model.Config.DailyLossMode; }
                <select name="Config.DailyLossMode" class="form-select form-select-sm">
                    <option value="Floor" selected="@(dlm == CRV.Core.Models.DailyLossMode.Floor)">Floor</option>
                    <option value="Peak"  selected="@(dlm == CRV.Core.Models.DailyLossMode.Peak)">Peak</option>
                </select>
            </div>
            <div class="col-4">
                <label class="form-label small">Commission ($/side)</label>
                <input name="Config.CommissionPerSide" type="number" step="0.01" value="@Model.Config.CommissionPerSide" class="form-control form-control-sm" />
            </div>
        </div>
        <div class="mt-2 d-flex flex-column gap-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Config.UseDailyLossLimit" value="true" id="chk-dd" @(Model.Config.UseDailyLossLimit ? "checked" : "") />
                <input type="hidden" name="Config.UseDailyLossLimit" value="false" />
                <label class="form-check-label small" for="chk-dd">Daily Loss Limit</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Config.UseTimeFilter" value="true" id="chk-time" @(Model.Config.UseTimeFilter ? "checked" : "") />
                <input type="hidden" name="Config.UseTimeFilter" value="false" />
                <label class="form-check-label small" for="chk-time">Time Filter (cutoff)</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Config.AllowBothSameBar" value="true" id="chk-both" @(Model.Config.AllowBothSameBar ? "checked" : "") />
                <input type="hidden" name="Config.AllowBothSameBar" value="false" />
                <label class="form-check-label small" for="chk-both">Allow Both Setups Same Bar</label>
            </div>
        </div>
    </div>
</div>

</div>


<!-- ════════════════════════════════════════════════════════════ -->
<!-- ── Session Tabs (Asia | London | NY) ───────────────────── -->
<!-- ════════════════════════════════════════════════════════════ -->
<h5 class="mt-4 mb-3">Session Configuration</h5>
<ul class="nav nav-tabs mb-3" id="sessionTabs" role="tablist">
    @for (int i = 0; i < Model.Sessions.Count; i++)
    {
        var s = Model.Sessions[i];
        var active = s.SessionId == CRV.Core.Models.SessionId.NY ? "active" : "";
        <li class="nav-item" role="presentation">
            <button class="nav-link @active" id="tab-@s.SessionId" data-bs-toggle="tab"
                    data-bs-target="#pane-@s.SessionId" type="button" role="tab">
                @s.SessionId
                @if (!s.Enabled) { <span class="badge bg-secondary ms-1">Off</span> }
            </button>
        </li>
    }
</ul>

<input type="hidden" name="SessionsJson" id="sessionsJson" />

<div class="tab-content" id="sessionTabContent">
    @for (int i = 0; i < Model.Sessions.Count; i++)
    {
        var s = Model.Sessions[i];
        var active = s.SessionId == CRV.Core.Models.SessionId.NY ? "show active" : "";
        <div class="tab-pane fade @active" id="pane-@s.SessionId" role="tabpanel">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">Enabled</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input session-field" type="checkbox"
                                       data-session="@i" data-field="Enabled" @(s.Enabled ? "checked" : "") />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">ORB Start</label>
                            <input type="time" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="OrbStart" value="@s.OrbStart.ToString("HH:mm")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">ORB End</label>
                            <input type="time" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="OrbEnd" value="@s.OrbEnd.ToString("HH:mm")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">RTH Start</label>
                            <input type="time" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="RthStart" value="@s.RthStart.ToString("HH:mm")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">RTH End</label>
                            <input type="time" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="RthEnd" value="@s.RthEnd.ToString("HH:mm")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Exit Min Before</label>
                            <input type="number" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="ExitMinutesBefore" value="@s.ExitMinutesBefore" />
                        </div>
                    </div>

                    <!-- ── Per-setup config for this session (expandable rows) ── -->
                    <hr class="my-3" />
                    <h6 class="mb-2 text-muted"><i class="bi bi-sliders me-1"></i>Setups <small class="text-muted fw-normal">(click row to expand)</small></h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0" style="font-size:.85rem">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:80px">Setup</th>
                                    <th style="width:70px" class="text-center">Enabled</th>
                                    <th style="width:80px">Contracts</th>
                                    <th style="width:80px">Max Trades</th>
                                    <th style="width:120px">Cutoff (HH:MM)</th>
                                    <th style="width:80px">Min R:R</th>
                                    <th style="width:80px">Order Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @await Html.PartialAsync("_SetupConfigSection", new SetupConfigSectionModel(
                                    SessionIndex:   i,
                                    SessionId:      s.SessionId.ToString(),
                                    SetupLetter:    "A",
                                    Setup:          s.SetupA,
                                    NearPct:        s.SetupA.NearPct,
                                    StopPct:        s.SetupA.StopPct,
                                    TargetPct:      s.SetupA.TargetPct,
                                    EntryTickOffset: s.SetupA.EntryTickOffset,
                                    Mode:           s.SetupA.Mode,
                                    PullbackPct:    s.SetupA.PullbackPct,
                                    RetestPct:      null,
                                    UseVwap:        s.SetupA.UseVwap,
                                    UseOrbClose:    s.SetupA.UseOrbClose))
                                @await Html.PartialAsync("_SetupConfigSection", new SetupConfigSectionModel(
                                    SessionIndex:   i,
                                    SessionId:      s.SessionId.ToString(),
                                    SetupLetter:    "B",
                                    Setup:          s.SetupB,
                                    NearPct:        s.SetupB.NearPct,
                                    StopPct:        s.SetupB.StopPct,
                                    TargetPct:      s.SetupB.TargetPct,
                                    EntryTickOffset: s.SetupB.EntryTickOffset,
                                    Mode:           s.SetupB.Mode,
                                    PullbackPct:    null,
                                    RetestPct:      s.SetupB.RetestPct,
                                    UseVwap:        s.SetupB.UseVwap,
                                    UseOrbClose:    s.SetupB.UseOrbClose))
                                @await Html.PartialAsync("_SetupConfigSection", new SetupConfigSectionModel(
                                    SessionIndex:   i,
                                    SessionId:      s.SessionId.ToString(),
                                    SetupLetter:    "C",
                                    Setup:          s.SetupC,
                                    NearPct:        s.SetupC.NearPct,
                                    StopPct:        s.SetupC.StopPct,
                                    TargetPct:      s.SetupC.TargetPct,
                                    EntryTickOffset: s.SetupC.EntryTickOffset,
                                    Mode:           null,
                                    PullbackPct:    null,
                                    RetestPct:      null,
                                    UseVwap:        null,
                                    UseOrbClose:    null))
                                @await Html.PartialAsync("_SetupConfigSection", new SetupConfigSectionModel(
                                    SessionIndex:   i,
                                    SessionId:      s.SessionId.ToString(),
                                    SetupLetter:    "D",
                                    Setup:          s.SetupD,
                                    NearPct:        s.SetupD.NearPct,
                                    StopPct:        s.SetupD.StopPct,
                                    TargetPct:      s.SetupD.TargetPct,
                                    EntryTickOffset: s.SetupD.EntryTickOffset,
                                    Mode:           null,
                                    PullbackPct:    null,
                                    RetestPct:      null,
                                    UseVwap:        null,
                                    UseOrbClose:    null))
                                </tbody>
                        </table>
                    </div>
                    <!-- TrendDay Module (SetupF) -->
                    <hr class="my-2" />
                    <div class="small text-muted mb-1"><i class="bi bi-bar-chart me-1"></i>TrendDay Module</div>
                    <div class="row g-2" style="font-size:.85rem">
                        <div class="col-4">
                            <label class="form-label small mb-0">Threshold</label>
                            <input type="number" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="SetupF.TrendDayThreshold"
                                   value="@s.SetupF.TrendDayThreshold" min="0" max="10" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small mb-0">Shallow PB Max</label>
                            <input type="number" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="SetupF.ShallowPullbackMax"
                                   value="@s.SetupF.ShallowPullbackMax" min="0" max="1" step="0.01" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small mb-0">VWAP Dev Period</label>
                            <input type="number" class="form-control form-control-sm session-field"
                                   data-session="@i" data-field="SetupF.VwapDevPeriod"
                                   value="@s.SetupF.VwapDevPeriod" min="1" max="100" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .basket-chevron { transition: transform 0.2s; display: inline-block; }
    [aria-expanded="true"] .basket-chevron { transform: rotate(90deg); }
</style>
<!-- ── Setup Basket ────────────────────────────────────────── -->
<div class="card crv-card mb-3 mt-4">
    <div class="card-header d-flex align-items-center">
        <h6 class="mb-0"><i class="bi bi-basket me-2"></i>Setup Basket</h6>
        <button type="button" class="btn btn-sm btn-outline-warning ms-auto" onclick="addBasketEntry()">
            <i class="bi bi-plus-lg me-1"></i>Add Setup
        </button>
    </div>
    <div class="card-body p-2">
        <div id="basket-entries">
            <!-- Entries rendered by JS -->
        </div>
        <div id="basket-empty" class="text-muted small text-center py-2">
            No basket entries — using legacy A/B/C/D setups.
            Click "Add Setup" to create a custom basket.
        </div>
    </div>
</div>

<!-- ── Save button ────────────────────────────────────────── -->
<button type="submit" class="btn btn-warning w-100 fw-bold mt-3">
    <i class="bi bi-floppy me-2"></i>Save Live Settings
</button>
<div class="small text-muted mt-2 text-center">
    Changes take effect on the next bar. Active trades are not affected.
</div>

</form>


@section Scripts {
<script src="~/js/crv-instruments.js" asp-append-version="true"></script>
<script>
// ── Instrument selector for Live Settings ─────────────────────
function instrOnChange() {
    const base = document.getElementById('instr-select').value;
    const info = window.CRV_findInstrument(base);
    if (!info) return;
    const ticker = window.CRV_activeContract(base);
    document.getElementById('instr-contract').value  = ticker;
    document.getElementById('instr-ticker-hidden').value = ticker;
    document.getElementById('instr-pv-hidden').value    = info.pointValue;
    document.getElementById('instr-pv-label').textContent = '$' + info.pointValue + '/pt';
    document.getElementById('instr-tick-sz').value       = info.tickSize;
}

// Initialise display-only elements on page load.
// Do NOT call instrOnChange() — that would overwrite saved TickSize / PointValue
// with catalog defaults. Instead, only update the contract ticker to the current
// front month (the saved ticker may be stale after rollover).
(function () {
    const ticker = document.getElementById('instr-ticker-hidden').value;
    const base   = window.CRV_parseBase(ticker);

    // Sync the instrument dropdown to the saved base code
    if (base) document.getElementById('instr-select').value = base;

    // Show the current front-month contract (recalculated, not the stale saved value)
    const frontMonth = base ? window.CRV_activeContract(base) : ticker;
    document.getElementById('instr-contract').value      = frontMonth;
    document.getElementById('instr-ticker-hidden').value = frontMonth;

    // Point-value badge from the saved server value — no catalog overwrite
    const pvHidden = document.getElementById('instr-pv-hidden').value;
    document.getElementById('instr-pv-label').textContent = pvHidden ? '$' + pvHidden + '/pt' : '—';
})();

// ── Show/hide replay settings based on broker selection ────
(function () {
    var brokerSel   = document.querySelector('select[name="Config.Broker"]');
    var replayPanel = document.getElementById('replaySettings');
    if (!brokerSel || !replayPanel) return;

    function toggle() {
        replayPanel.style.display = brokerSel.value === 'TradovateReplay' ? '' : 'none';
    }
    brokerSel.addEventListener('change', toggle);
    toggle();
})();

// ── Auto-populate commission based on broker + contract type ────
(function () {
    var brokerSel = document.querySelector('select[name="Config.Broker"]');
    var execSel   = document.querySelector('select[name="Config.ExecBroker"]');
    var instrSel  = document.getElementById('instr-select');
    var commInput = document.querySelector('input[name="Config.CommissionPerSide"]');
    if (!commInput) return;

    function syncCommission() {
        var broker = (execSel && execSel.value) ? execSel.value : brokerSel.value;
        var base   = instrSel ? instrSel.value : null;
        commInput.value = window.CRV_getCommission(broker, base);
    }

    if (brokerSel) brokerSel.addEventListener('change', syncCommission);
    if (execSel)   execSel.addEventListener('change', syncCommission);
    if (instrSel)  instrSel.addEventListener('change', syncCommission);
})();

// ── Setup row expand/collapse toggle ─────────────────────────
(function () {
    document.querySelectorAll('.setup-summary-row').forEach(function (row) {
        row.addEventListener('click', function () {
            var targetId = row.dataset.target;
            var detail = document.getElementById(targetId);
            if (!detail) return;
            var chevron = row.querySelector('.setup-chevron');
            if (detail.style.display === 'none') {
                detail.style.display = '';
                if (chevron) { chevron.classList.remove('bi-chevron-right'); chevron.classList.add('bi-chevron-down'); }
            } else {
                detail.style.display = 'none';
                if (chevron) { chevron.classList.remove('bi-chevron-down'); chevron.classList.add('bi-chevron-right'); }
            }
        });
    });
})();

// ── Session tabs: gather values into SessionsJson on submit ────
(function () {
    // Target the main settings form (has novalidate), not the Start/Stop engine forms
    const form = document.querySelector('form[method="post"][novalidate]');
    if (!form) return;
    form.addEventListener('submit', function () {
        const sessions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sessions));
        document.querySelectorAll('.session-field').forEach(function (el) {
            const idx   = parseInt(el.dataset.session);
            const field = el.dataset.field;
            var val;
            if (el.type === 'checkbox')      val = el.checked;
            else if (el.type === 'number')   val = parseFloat(el.value) || 0;
            else if (el.type === 'time')     val = el.value + ':00';
            else                             val = el.value;
            // Support nested paths like "SetupA.Enabled"
            var parts = field.split('.');
            if (parts.length === 2) {
                sessions[idx][parts[0]][parts[1]] = val;
            } else {
                sessions[idx][field] = val;
            }
        });
        var json = JSON.stringify(sessions);
        console.log('Sessions JSON being submitted:', json);
        console.log('Asia Enabled:', sessions[0]?.Enabled, 'London Enabled:', sessions[1]?.Enabled, 'NY Enabled:', sessions[2]?.Enabled);
        document.getElementById('sessionsJson').value = json;
    });
})();

// ── Per-setup custom instrument toggle + sync ──────────────────
(function () {
    // Checkbox: enable/disable the dropdown
    document.querySelectorAll('.setup-custom-instr-chk').forEach(function (chk) {
        chk.addEventListener('change', function () {
            var setup = chk.dataset.setup;
            var sess  = chk.dataset.session;
            var row   = chk.closest('.setup-detail-row') || chk.closest('td');
            var sel   = row.querySelector('.setup-custom-instr-sel[data-setup="' + setup + '"]');
            if (sel) sel.disabled = !chk.checked;
            if (chk.checked && sel) setupInstrOnChange(sel, setup, sess);
        });
    });

    // Dropdown: update hidden fields when instrument changes
    document.querySelectorAll('.setup-custom-instr-sel').forEach(function (sel) {
        sel.addEventListener('change', function () {
            setupInstrOnChange(sel, sel.dataset.setup, sel.dataset.session);
        });
    });

    function setupInstrOnChange(sel, setup, sess) {
        var base = sel.value;
        var info = window.CRV_findInstrument(base);
        if (!info) return;
        var ticker = window.CRV_activeContract(base);
        var row = sel.closest('.setup-detail-row') || sel.closest('td');
        var hTicker = row.querySelector('.setup-custom-ticker-hidden[data-setup="' + setup + '"]');
        var hPV     = row.querySelector('.setup-custom-pv-hidden[data-setup="' + setup + '"]');
        var hTS     = row.querySelector('.setup-custom-ts-hidden[data-setup="' + setup + '"]');
        var label   = row.querySelector('.setup-custom-instr-label[data-setup="' + setup + '"]');
        if (hTicker) hTicker.value = ticker;
        if (hPV)     hPV.value     = info.pointValue;
        if (hTS)     hTS.value     = info.tickSize;
        if (label)   label.textContent = ticker + ' ($' + info.pointValue + '/pt)';
    }

    // Init: sync dropdowns to saved values on page load
    document.querySelectorAll('.setup-custom-ticker-hidden').forEach(function (h) {
        var savedTicker = h.value;
        if (!savedTicker) return;
        var setup = h.dataset.setup;
        var row   = h.closest('.setup-detail-row') || h.closest('td');
        var sel   = row.querySelector('.setup-custom-instr-sel[data-setup="' + setup + '"]');
        if (!sel) return;
        var base  = window.CRV_parseBase(savedTicker);
        if (base) {
            sel.value = base;
            var info = window.CRV_findInstrument(base);
            var label = row.querySelector('.setup-custom-instr-label[data-setup="' + setup + '"]');
            if (info && label) {
                var front = window.CRV_activeContract(base);
                label.textContent = front + ' ($' + info.pointValue + '/pt)';
                // Update hidden ticker to front month (may have rolled)
                h.value = front;
            }
        }
    });
})();

// ── Setup Basket editor ─────────────────────────────────────
var _basket = [];

(function() {
    var raw = document.getElementById('basket-json').value;
    if (raw) {
        try { _basket = JSON.parse(raw); } catch(e) { _basket = []; }
    }
    renderBasket();
})();

function addBasketEntry() {
    var id = 'setup-' + Date.now();
    _basket.push({
        Id: id,
        Label: '',
        StrategyType: 1,
        Ticker: '',
        PointValue: 20,
        TickSize: 0.25,
        Config: { MaxTrades: 5, CutoffHour: 14, CutoffMinute: 30, Contracts: 2, MaxContracts: 2, HiVolMult: 1, StopPct: 0.35, TargetPct: 65, PartialPct: 50, MinRr: 1.5, Mode: 'Aggressive', OrderType: 'Market', UsePartial: true, UseBe: true, PartialCts: 1, MaxEntrySlippage: 0, MaxAdverseMinutes: 0 }
    });
    renderBasket();
}

function removeBasketEntry(id) {
    _basket = _basket.filter(function(b) { return b.Id !== id; });
    renderBasket();
}

// Helpers for basket config field rendering
function _bField(id, field, type, val, w, label, parse, step) {
    var onChange = parse === 'float'
        ? "updateBasketConfig('" + id + "','" + field + "',parseFloat(this.value))"
        : "updateBasketConfig('" + id + "','" + field + "',parseInt(this.value))";
    var stepAttr = step ? ' step="' + step + '"' : '';
    return '<div class="col-auto"><label class="form-label small mb-0">' + label + '</label>' +
        '<input type="' + type + '"' + stepAttr + ' class="form-control form-control-sm" style="width:' + w + 'px" value="' + val + '" onchange="' + onChange + '"></div>';
}
function _bCheck(id, field, checked, label) {
    var chk = checked ? ' checked' : '';
    return '<div class="col-auto d-flex align-items-end pb-1"><div class="form-check form-check-inline mb-0">' +
        '<input type="checkbox" class="form-check-input"' + chk + ' onchange="updateBasketConfig(\'' + id + '\',\'' + field + '\',this.checked)">' +
        '<label class="form-check-label small">' + label + '</label></div></div>';
}

function _calcRR(cfg) {
    var stop = cfg.StopPct || 0.35;
    var target = (cfg.TargetPct || 65) / 100;
    var rr = stop > 0 ? (target / stop).toFixed(1) : '—';
    return 'R:R ' + rr;
}

function _updateRRLabel(id) {
    var entry = _basket.find(function(b) { return b.Id === id; });
    if (!entry) return;
    var label = document.getElementById('rr-label-' + id);
    if (!label) return;
    var cfg = entry.Config || {};
    var rr = _calcRR(cfg);
    var minRr = cfg.MinRr || 1.5;
    var stop = cfg.StopPct || 0.35;
    var target = (cfg.TargetPct || 65) / 100;
    var rrVal = stop > 0 ? target / stop : 0;
    label.textContent = rr;
    label.className = 'badge ' + (rrVal >= minRr ? 'bg-success' : 'bg-danger');
}

function _bSelect(id, field, val, w, label, options) {
    var opts = options.map(function(o) {
        var sel = (o.value == val) ? ' selected' : '';
        return '<option value="' + o.value + '"' + sel + '>' + o.text + '</option>';
    }).join('');
    return '<div class="col-auto"><label class="form-label small mb-0">' + label + '</label>' +
        '<select class="form-select form-select-sm" style="width:' + w + 'px" onchange="updateBasketConfig(\'' + id + '\',\'' + field + '\',parseInt(this.value))">' + opts + '</select></div>';
}

function _bSessionSlot(entry, sessionId) {
    var slots = entry.Sessions || [];
    var slot = slots.find(function(s) { return s.SessionId === sessionId; });
    var enabled = slot ? slot.Enabled : (sessionId === 'NY');
    var h = slot ? slot.CutoffHour : (sessionId === 'Asia' ? 1 : sessionId === 'London' ? 8 : 14);
    var m = slot ? slot.CutoffMinute : (sessionId === 'Asia' ? 30 : 0);
    var chk = enabled ? ' checked' : '';
    return '<div class="col-auto d-flex align-items-end gap-1 pb-1">' +
        '<div class="form-check form-check-inline mb-0">' +
            '<input type="checkbox" class="form-check-input"' + chk + ' onchange="updateSessionSlot(\'' + entry.Id + '\',\'' + sessionId + '\',\'Enabled\',this.checked)">' +
            '<label class="form-check-label small">' + sessionId + '</label>' +
        '</div>' +
        '<input type="time" class="form-control form-control-sm" style="width:95px;' + (enabled ? '' : 'opacity:0.4') + '" value="' +
            String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + '" ' +
            (enabled ? '' : 'disabled') +
            ' onchange="var p=this.value.split(\':\'); updateSessionSlot(\'' + entry.Id + '\',\'' + sessionId + '\',\'CutoffHour\',parseInt(p[0])); updateSessionSlot(\'' + entry.Id + '\',\'' + sessionId + '\',\'CutoffMinute\',parseInt(p[1]));">' +
    '</div>';
}

function renderBasket() {
    var container = document.getElementById('basket-entries');
    var empty = document.getElementById('basket-empty');

    if (_basket.length === 0) {
        container.innerHTML = '';
        empty.style.display = '';
        document.getElementById('basket-json').value = '';
        return;
    }
    empty.style.display = 'none';

    container.innerHTML = _basket.map(function(entry, i) {
        var stratTypes = [
            { val: 0, label: 'Pullback' },
            { val: 1, label: 'Retest' },
            { val: 2, label: 'OrbFakeout' },
            { val: 3, label: 'SessionFakeout' }
        ];
        var stratOptions = stratTypes.map(function(t) {
            return '<option value="' + t.val + '" ' + (entry.StrategyType === t.val ? 'selected' : '') + '>' + t.label + '</option>';
        }).join('');

        var instrData = window.CRV_INSTRUMENTS || { mini: [], micro: [] };
        function _instrOpts(list, entry) {
            return list.map(function(instr) {
                var front = window.CRV_activeContract ? window.CRV_activeContract(instr.code) : instr.code;
                // Match by exact ticker or by base code at start of ticker (avoid "NQ" matching "MNQM26")
                var ticker = (entry.Ticker || '').replace(/^\//, '');
                var selected = ticker === front || ticker.indexOf(instr.code) === 0 ? 'selected' : '';
                return '<option value="' + instr.code + '" ' + selected + '>' + instr.label + ' ($' + instr.pointValue + '/pt)</option>';
            }).join('');
        }
        var instrOptions = '<option value="">— Select —</option>' +
            '<optgroup label="Micro">' + _instrOpts(instrData.micro, entry) + '</optgroup>' +
            '<optgroup label="Mini">' + _instrOpts(instrData.mini, entry) + '</optgroup>';

        var cfg = entry.Config || {};

        var collapseId = 'basket-collapse-' + entry.Id;
        return '<div class="basket-entry border rounded p-2 mb-2" data-id="' + entry.Id + '">' +
            '<div class="d-flex gap-2 align-items-center">' +
                '<button type="button" class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="collapse" data-bs-target="#' + collapseId + '" style="width:20px">' +
                    '<i class="bi bi-chevron-right basket-chevron"></i>' +
                '</button>' +
                '<span class="badge bg-warning text-dark">#' + (i+1) + '</span>' +
                '<select class="form-select form-select-sm" style="width:160px" onchange="updateBasketField(\'' + entry.Id + '\',\'StrategyType\',parseInt(this.value))">' + stratOptions + '</select>' +
                '<select class="form-select form-select-sm" style="width:220px" onchange="updateBasketInstrument(\'' + entry.Id + '\',this.value)">' + instrOptions + '</select>' +
                '<input type="text" class="form-control form-control-sm" style="width:140px" placeholder="Label" value="' + (entry.Label || '') + '" onchange="updateBasketField(\'' + entry.Id + '\',\'Label\',this.value)">' +
                '<button type="button" class="btn btn-sm btn-outline-danger ms-auto" onclick="removeBasketEntry(\'' + entry.Id + '\')">' +
                    '<i class="bi bi-trash"></i>' +
                '</button>' +
            '</div>' +
            '<div class="collapse mt-2" id="' + collapseId + '">' +
            '<div class="row g-2">' +
                _bField(entry.Id, 'Contracts', 'number', cfg.Contracts || 2, 70, 'Contracts', 'int') +
                _bField(entry.Id, 'MaxContracts', 'number', cfg.MaxContracts || cfg.Contracts || 2, 80, 'Max Cts', 'int') +
                _bField(entry.Id, 'HiVolMult', 'number', cfg.HiVolMult || 1, 70, 'HiVol ×', 'float', '0.1') +
                _bField(entry.Id, 'MaxTrades', 'number', cfg.MaxTrades || 5, 70, 'Max Trades', 'int') +
                _bField(entry.Id, 'MaxLongTrades', 'number', cfg.MaxLongTrades || 0, 70, 'Max Long', 'int') +
                _bField(entry.Id, 'MaxShortTrades', 'number', cfg.MaxShortTrades || 0, 70, 'Max Short', 'int') +
                _bField(entry.Id, 'StopPct', 'number', cfg.StopPct || 0.35, 75, 'Stop %', 'float', '0.01') +
                _bSelect(entry.Id, 'TargetPct', cfg.TargetPct || 65, 90, 'Target %',
                    [25,50,65,75,100,125,150,200,250,300,350,400,450,500].map(function(v) { return {value:v, text:v+'%'}; })) +
                _bSelect(entry.Id, 'PartialPct', cfg.PartialPct || 50, 80, 'Partial %',
                    [{value:25,text:'25%'},{value:50,text:'50%'},{value:75,text:'75%'}]) +
                _bField(entry.Id, 'NearPct', 'number', cfg.NearPct || 0.15, 75, 'Near %', 'float', '0.01') +
                _bField(entry.Id, 'MinRr', 'number', cfg.MinRr || 1.5, 65, 'Min R:R', 'float', '0.1') +
                '<div class="col-auto d-flex align-items-end pb-1"><span class="badge bg-secondary" id="rr-label-' + entry.Id + '">' + _calcRR(cfg) + '</span></div>' +
                (entry.StrategyType === 0 ? _bField(entry.Id, 'PullbackPct', 'number', cfg.PullbackPct || 0.50, 85, 'Pullback %', 'float', '0.01') : '') +
                (entry.StrategyType === 1 ? _bField(entry.Id, 'RetestPct', 'number', cfg.RetestPct || 0.05, 85, 'Retest %', 'float', '0.01') : '') +
            '</div>' +
            '<div class="row g-2 mt-1">' +
                '<div class="col-auto"><label class="form-label small mb-0">Sessions</label></div>' +
                _bSessionSlot(entry, 'Asia') +
                _bSessionSlot(entry, 'London') +
                _bSessionSlot(entry, 'NY') +
            '</div>' +
            '<div class="row g-2 mt-1">' +
                '<div class="col-auto"><label class="form-label small mb-0">Mode</label>' +
                    '<select class="form-select form-select-sm" style="width:120px" onchange="updateBasketConfig(\'' + entry.Id + '\',\'Mode\',this.value)">' +
                        '<option ' + ((cfg.Mode||'Aggressive')==='Aggressive'?'selected':'') + '>Aggressive</option>' +
                        '<option ' + ((cfg.Mode||'')==='SmartAggressive'?'selected':'') + ' value="SmartAggressive">Smart Aggressive</option>' +
                        '<option ' + ((cfg.Mode||'')==='Conservative'?'selected':'') + '>Conservative</option>' +
                    '</select></div>' +
                '<div class="col-auto"><label class="form-label small mb-0">Order</label>' +
                    '<select class="form-select form-select-sm" style="width:100px" onchange="updateBasketConfig(\'' + entry.Id + '\',\'OrderType\',this.value)">' +
                        '<option ' + ((cfg.OrderType||'Market')==='Market'?'selected':'') + '>Market</option>' +
                        '<option ' + ((cfg.OrderType||'')==='Limit'?'selected':'') + '>Limit</option>' +
                    '</select></div>' +
                _bField(entry.Id, 'EntryTickOffset', 'number', cfg.EntryTickOffset || 0, 70, 'Tick Offset', 'int') +
                _bField(entry.Id, 'MaxEntrySlippage', 'number', cfg.MaxEntrySlippage || 0, 80, 'Max Slip %', 'float', '0.01') +
                _bField(entry.Id, 'MaxAdverseMinutes', 'number', cfg.MaxAdverseMinutes || 0, 70, 'Max Adv Min', 'int') +
                _bField(entry.Id, 'PartialCts', 'number', cfg.PartialCts || 0, 70, 'Partial Cts', 'int') +
                _bCheck(entry.Id, 'UsePartial', cfg.UsePartial !== false, 'Partial') +
                _bCheck(entry.Id, 'UseBe', cfg.UseBe !== false, 'BE') +
                _bCheck(entry.Id, 'UseVwap', cfg.UseVwap !== false, 'VWAP') +
                _bCheck(entry.Id, 'CloseAtRthClose', cfg.CloseAtRthClose !== false, 'Close EOD') +
                _bCheck(entry.Id, 'AllowRearmAfterBe', cfg.AllowRearmAfterBe !== false, 'Rearm BE') +
            '</div>' +
            '</div>' +  // close collapse
        '</div>';
    }).join('');

    syncBasketJson();
}

function updateBasketField(id, field, value) {
    var entry = _basket.find(function(b) { return b.Id === id; });
    if (entry) {
        entry[field] = value;
        // Re-render when strategy type changes (shows/hides PullbackPct/RetestPct)
        if (field === 'StrategyType') { renderBasket(); return; }
        syncBasketJson();
    }
}

function updateSessionSlot(entryId, sessionId, field, value) {
    var entry = _basket.find(function(b) { return b.Id === entryId; });
    if (!entry) return;
    if (!entry.Sessions) entry.Sessions = [
        { SessionId: 'Asia', Enabled: false, CutoffHour: 1, CutoffMinute: 30 },
        { SessionId: 'London', Enabled: false, CutoffHour: 8, CutoffMinute: 0 },
        { SessionId: 'NY', Enabled: true, CutoffHour: 14, CutoffMinute: 30 }
    ];
    var slot = entry.Sessions.find(function(s) { return s.SessionId === sessionId; });
    if (slot) {
        slot[field] = value;
        // Re-render to update disabled state of time input
        if (field === 'Enabled') { renderBasket(); return; }
        syncBasketJson();
    }
}

function updateBasketConfig(id, field, value) {
    var entry = _basket.find(function(b) { return b.Id === id; });
    if (entry) {
        if (!entry.Config) entry.Config = {};
        entry.Config[field] = value;
        syncBasketJson();
        // Update R:R label when stop, target, or minRr changes
        if (field === 'StopPct' || field === 'TargetPct' || field === 'MinRr')
            _updateRRLabel(id);
    }
}

function updateBasketInstrument(id, base) {
    var entry = _basket.find(function(b) { return b.Id === id; });
    if (!entry) return;
    var info = window.CRV_findInstrument ? window.CRV_findInstrument(base) : null;
    var front = window.CRV_activeContract ? window.CRV_activeContract(base) : '/' + base;
    entry.Ticker = front;
    entry.PointValue = info ? info.pointValue : 20;
    entry.TickSize = info ? info.tickSize : 0.25;
    var stratNames = ['Pullback','Retest','OrbFakeout','SessionFakeout'];
    var stratKey = (stratNames[entry.StrategyType] || 'setup').toLowerCase().replace(/[^a-z]/g,'');
    // Auto-generate clean Id and Label
    var count = _basket.filter(function(b) { return b.Ticker === front && b.StrategyType === entry.StrategyType; }).length;
    entry.Id = stratKey + '-' + base.toLowerCase() + (count > 1 ? '-' + count : '');
    entry.Label = (stratNames[entry.StrategyType] || 'Setup') + ' [' + base + ']';
    renderBasket();
}

function syncBasketJson() {
    document.getElementById('basket-json').value = JSON.stringify(_basket);
}
</script>
}

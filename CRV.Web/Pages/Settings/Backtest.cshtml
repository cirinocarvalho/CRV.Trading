@page "/settings/backtest"
@model CRV.Web.Pages.Settings.BacktestSettingsModel
@using CRV.Backtest.Engine
@using CRV.Backtest.Results
@using CRV.Core.Models
@{
    ViewData["Title"] = "Backtest";
    ViewData["Page"]  = "backtest-settings";
    Layout = "~/Pages/Shared/_Layout.cshtml";

    string PnlCls(decimal v) => v > 0 ? "pnl-pos" : v < 0 ? "pnl-neg" : "pnl-zero";
    string Pnl(decimal v)    => (v >= 0 ? "+$" : "-$") + Math.Abs(v).ToString("N0");

    // Eastern Time — handles EST/EDT automatically
    TimeZoneInfo etTz;
    try   { etTz = TimeZoneInfo.FindSystemTimeZoneById("America/New_York"); }
    catch { etTz = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time"); }
    string ToEt(DateTime utc)     => TimeZoneInfo.ConvertTimeFromUtc(utc, etTz).ToString("M/d HH:mm:ss");
    string ToEtTime(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, etTz).ToString("HH:mm:ss");
    string ToEtLabel(DateTime utc)
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(utc, etTz);
        return local.IsDaylightSavingTime() ? "EDT" : "EST";
    }
}

<div class="d-flex align-items-center mb-3 gap-3 flex-wrap">
    <h5 class="mb-0"><i class="bi bi-clock-history me-2 text-warning"></i>Backtest</h5>
    @if (Model.Result != null)
    {
        var distinctTickers = Model.Result.Trades
            .Select(t => string.IsNullOrEmpty(t.Ticker) ? Model.Result.Config.Ticker : t.Ticker)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var tickerLabel = distinctTickers.Count > 1 ? "Multi Inst" : (distinctTickers.FirstOrDefault() ?? Model.Result.Config.Ticker);
        <span class="badge bg-dark border border-secondary font-monospace ms-auto small">
            @tickerLabel
            &nbsp;&middot;&nbsp;@Model.Result.BtConfig.From.ToString("MMM d yyyy") &rarr; @Model.Result.BtConfig.To.ToString("MMM d yyyy")
            &nbsp;&middot;&nbsp;ran @ToEtTime(Model.Result.GeneratedAt) @ToEtLabel(Model.Result.GeneratedAt)
        </span>
    }
</div>

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger small py-2 mb-3">
        @foreach (var e in ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
    </div>
}

<div class="row g-3">

    <div class="col-12 col-xl-4">
        <form method="post">
            <div class="settings-section">
                <h6><i class="bi bi-database me-1"></i>Data Source</h6>
                <div class="mb-2">
                    <label class="form-label small">Source</label>
                    <select name="Config.DataSource" id="dataSource" class="form-select form-select-sm">
                        <option value="CSV"          selected="@(Model.Config.DataSource == "CSV")">CSV File</option>
                        <option value="Schwab"       selected="@(Model.Config.DataSource == "Schwab")">Schwab REST API</option>
                        <option value="TradeStation" selected="@(Model.Config.DataSource == "TradeStation")">TradeStation REST API</option>
                        <option value="Tradovate"    selected="@(Model.Config.DataSource == "Tradovate")">Tradovate WebSocket</option>
                    </select>
                </div>
                <div id="csv-upload" class="mb-2">
                    <label class="form-label small">CSV File Path</label>
                    <input name="Config.CsvPath" type="text" value="@Model.Config.CsvPath"
                           placeholder="Data/NQ_1min.csv"
                           class="form-control form-control-sm font-monospace" />
                    <div class="form-text text-muted small">Server file path &mdash; relative to app folder or absolute. Columns: datetime,open,high,low,close,volume</div>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small">From</label>
                        <input name="Config.From" type="date" value="@Model.Config.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">To</label>
                        <input name="Config.To" type="date" value="@Model.Config.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            <div class="settings-section">
                <h6><i class="bi bi-gear me-1"></i>Simulation</h6>
                <div class="mb-2">
                    <label class="form-label small">Execution TF</label>
                    <select name="Config.ExecutionTFMinutes" class="form-select form-select-sm">
                        <option value="1"  selected="@(Model.Config.ExecutionTFMinutes == 1  ? "selected" : null)">1 minute</option>
                        <option value="2"  selected="@(Model.Config.ExecutionTFMinutes == 2  ? "selected" : null)">2 minutes</option>
                        <option value="5"  selected="@(Model.Config.ExecutionTFMinutes == 5  ? "selected" : null)">5 minutes</option>
                        <option value="15" selected="@(Model.Config.ExecutionTFMinutes == 15 ? "selected" : null)">15 minutes</option>
                        <option value="30" selected="@(Model.Config.ExecutionTFMinutes == 30 ? "selected" : null)">30 minutes</option>
                        <option value="60" selected="@(Model.Config.ExecutionTFMinutes == 60 ? "selected" : null)">60 minutes</option>
                    </select>
                    <div class="form-text text-muted small">CSV bars are resampled to this TF automatically.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Fill Mode</label>
                    <select name="Config.FillMode" class="form-select form-select-sm">
                        <option value="AtClose"      selected="@(Model.Config.FillMode == FillMode.AtClose)">At Bar Close (conservative)</option>
                        <option value="AtTouch"      selected="@(Model.Config.FillMode == FillMode.AtTouch)">At Price Touch (default)</option>
                        <option value="WithSlippage" selected="@(Model.Config.FillMode == FillMode.WithSlippage)">With Slippage</option>
                    </select>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small">Slippage (ticks)</label>
                        <input name="Config.SlippageTicks" type="number" min="0" max="10" value="@Model.Config.SlippageTicks" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6" id="warmup-row">
                        <label class="form-label small">Warmup Bars <span class="text-muted small">(CSV only)</span></label>
                        <select name="Config.WarmupBars" class="form-select form-select-sm">
                            <option value="0"  selected="@(Model.Config.WarmupBars == 0  ? "selected" : null)">0 — none</option>
                            <option value="14" selected="@(Model.Config.WarmupBars == 14 ? "selected" : null)">14 — ATR warmup</option>
                        </select>
                        <div class="form-text text-muted small">Broker sources always use 0.</div>
                    </div>
                </div>
                <div class="mb-2 mt-2">
                    <label class="form-label small">Session</label>
                    <select name="Config.BacktestSession" class="form-select form-select-sm">
                        <option value="All"    selected="@(Model.Config.BacktestSession == "All"    ? "selected" : null)">All Sessions</option>
                        <option value="Asia"   selected="@(Model.Config.BacktestSession == "Asia"   ? "selected" : null)">Asia</option>
                        <option value="London" selected="@(Model.Config.BacktestSession == "London" ? "selected" : null)">London</option>
                        <option value="NY"     selected="@(Model.Config.BacktestSession == "NY"     ? "selected" : null)">NY (default)</option>
                    </select>
                    <div class="form-text text-muted small">Filter backtest to a specific session, or run all enabled sessions.</div>
                </div>
            </div>
            <button type="submit" class="btn btn-warning w-100 fw-bold">
                <i class="bi bi-play-fill me-2"></i>Run Backtest
            </button>
            <div class="text-muted small mt-2 text-center">
                Uses strategy config from <a href="/settings/live" class="text-warning">Live Settings</a>
            </div>
        </form>
    </div>

    <div class="col-12 col-xl-8">
        @if (Model.Result == null)
        {
            <div class="settings-section d-flex flex-column align-items-center justify-content-center py-5 text-center opacity-50">
                <i class="bi bi-bar-chart-line" style="font-size:3rem;color:#ffd700;"></i>
                <div class="mt-3 text-muted">Configure a run and click <strong>Run Backtest</strong></div>
                <div class="text-muted small mt-1">Equity curve, per-setup breakdown, and full trade log will appear here</div>
            </div>
        }
        else
        {
            var r = Model.Result;
            var setupCards = r.PerSetup
                .Where(kv => kv.Value.TotalTrades > 0)
                .Select(kv => (Title: kv.Key, Icon: "bi-circle-fill", M: kv.Value))
                .ToList();
            var allCards = new[] { (Title: "Total", Icon: "bi-bar-chart-fill", M: r.Total) }
                .Concat(setupCards)
                .ToList();
            <div class="row g-2">
                @foreach (var card in allCards)
                {
                    var m = card.M;
                    <div class="col-12 col-md-4">
                        <div class="settings-section h-100">
                            <h6><i class="bi @card.Icon me-1"></i>@card.Title</h6>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Trades</span><span class="font-monospace small">@m.TotalTrades</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Win Rate</span>
                                <span class="font-monospace small @(m.WinRate >= 50 ? "pnl-pos" : "pnl-neg")">@m.WinRate.ToString("F1")%</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Net P&amp;L</span>
                                <span class="font-monospace small @PnlCls(m.NetPnl)">@Pnl(m.NetPnl)</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Profit Factor</span>
                                <span class="font-monospace small @(m.ProfitFactor >= 1.5m ? "pnl-pos" : m.ProfitFactor < 1 && m.TotalTrades > 0 ? "pnl-neg" : "")">@(m.ProfitFactor == 0 && m.NetPnl > 0 ? "∞" : m.ProfitFactor.ToString("F2"))</span>
            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Avg R</span><span class="font-monospace small @PnlCls(m.AvgR)">@m.AvgR.ToString("F2")R</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Max DD</span><span class="font-monospace small pnl-neg">-@m.MaxDrawdown.ToString("C0")</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Avg Win</span><span class="font-monospace small pnl-pos">@m.AvgWin.ToString("C0")</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Avg Loss</span><span class="font-monospace small pnl-neg">@m.AvgLoss.ToString("C0")</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small" title="E = (Win% × AvgWin) + (Loss% × AvgLoss)">Expectancy</span>
                                <span class="font-monospace small @PnlCls(m.Expectancy)">@Pnl(m.Expectancy)</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Consec W / L</span><span class="font-monospace small">@m.MaxConsecWins / @m.MaxConsecLosses</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Long / Short</span><span class="font-monospace small">@m.LongTrades / @m.ShortTrades</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <span class="text-muted small">Tgt / Stp / EOD</span><span class="font-monospace small">@m.TargetExits / @m.StopExits / @m.SessionEndExits</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted small">Commission</span><span class="font-monospace small pnl-neg">-@m.TotalCommission.ToString("C0")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (Model.Result != null)
{
    var r = Model.Result;
    <div class="settings-section mt-3">
        <h6 class="mb-3">
            <i class="bi bi-graph-up me-1"></i>Equity Curve
            <span class="text-muted fw-normal small ms-2">@r.EquityCurve.Count points</span>
            <span class="badge ms-2 @(r.Total.NetPnl >= 0 ? "bg-success" : "bg-danger") font-monospace small">@Pnl(r.Total.NetPnl)</span>
        </h6>
        <canvas id="equity-chart" style="max-height:220px;"></canvas>
    </div>
    <div class="settings-section mt-3">
        <div class="d-flex align-items-center mb-2">
            <h6 class="mb-0"><i class="bi bi-list-columns me-1"></i>Trade Log</h6>
            <span class="badge bg-secondary font-monospace ms-2 trade-count">@r.Trades.Count trades</span>
            <span class="ms-2 small text-muted trade-wl">@r.Trades.Count(t => t.IsWin) W / @r.Trades.Count(t => !t.IsWin) L</span>
            <select id="setup-filter" class="form-select form-select-sm ms-2" style="width:auto;" onchange="filterBySetup(this.value)">
                <option value="">All Setups</option>
                @foreach (var sl in r.Trades
                    .Select(t => !string.IsNullOrEmpty(t.SetupLabel) ? t.SetupLabel : t.Setup.ToString())
                    .Distinct().OrderBy(x => x))
                {
                    <option value="@sl">@sl</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-outline-light ms-auto" onclick="exportTradesCsv()"><i class="bi bi-download me-1"></i>CSV</button>
        </div>
        <div class="table-responsive" style="max-height:460px;overflow-y:auto;">
            <table class="table table-sm table-hover trade-table font-monospace mb-0">
                <thead class="table-dark" style="position:sticky;top:0;z-index:1;">
                    <tr>
                        <th>#</th><th>In (@(Model.Result != null ? ToEtLabel(Model.Result.Trades.FirstOrDefault()?.EnteredAt ?? DateTime.UtcNow) : "ET"))</th><th>Out</th><th>Dur</th><th>Setup</th><th>Instr</th><th>Dir</th>
                        <th class="text-end">Entry</th><th class="text-end">Exit</th>
                        <th class="text-end">Stop</th><th class="text-end">Target</th>
                        <th class="text-end">Cts</th><th>Part</th><th>Reason</th>
                        <th class="text-end">Gross</th><th class="text-end">Comm</th>
                        <th class="text-end">Net</th><th class="text-end">R</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 0; }
                    @foreach (var t in r.Trades.OrderBy(t => t.EnteredAt))
                    {
                        rowNum++;
                        string rowCls = t.IsWin ? "table-success bg-opacity-10" : "table-danger bg-opacity-10";
                        string reasonBadge = t.ExitReason switch
                        {
                            ExitReason.Target     => "bg-success",
                            ExitReason.Stop       => "bg-danger",
                            _                     => "bg-secondary"
                        };
                        <tr class="@rowCls" data-setup="@(!string.IsNullOrEmpty(t.SetupLabel) ? t.SetupLabel : t.Setup.ToString())">
                            <td class="td-dim">@rowNum</td>
                            <td class="td-time">@ToEt(t.EnteredAt)</td>
                            <td class="td-time td-dim">@ToEtTime(t.ExitedAt)</td>
                            <td class="td-time td-dim">@t.Duration.ToString(@"h\:mm\:ss")</td>
                            <td><span class="badge bg-warning text-dark">@(!string.IsNullOrEmpty(t.SetupLabel) ? t.SetupLabel : t.Setup.ToString())</span></td>
                            <td class="small">@(string.IsNullOrEmpty(t.Ticker) ? "—" : t.Ticker.TrimStart('/'))</td>
                            <td class="@(t.EffectiveDirection == Direction.Long ? "pnl-pos" : "pnl-neg")">@t.EffectiveDirection</td>
                            <td class="text-end">@t.Entry.ToString("F2")</td>
                            <td class="text-end">@t.Exit.ToString("F2")</td>
                            <td class="text-end td-dim">@t.InitialStop.ToString("F2")</td>
                            <td class="text-end td-dim">@t.Target.ToString("F2")</td>
                            <td class="text-end">@t.Contracts</td>
                            <td class="text-center">@if (t.PartialFilled) { <i class="bi bi-check-lg text-dark"></i> } else { <span class="td-dim">&#x2014;</span> }</td>
                            <td><span class="badge @reasonBadge small">@t.ExitReason</span></td>
                            <td class="text-end @(t.GrossPnl >= 0 ? "pnl-pos" : "pnl-neg")">@Pnl(t.GrossPnl)</td>
                            <td class="text-end td-dim">-@t.Commission.ToString("C0")</td>
                            <td class="text-end fw-bold @PnlCls(t.NetPnl)">@Pnl(t.NetPnl)</td>
                            <td class="text-end @(t.RMultiple >= 0 ? "pnl-pos" : "pnl-neg")">@t.RMultiple.ToString("F1")R</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    const src      = document.getElementById('dataSource');
    const csvDiv   = document.getElementById('csv-upload');
    const warmupRow = document.getElementById('warmup-row');
    function toggle() {
        const isCsv = src.value === 'CSV';
        csvDiv.style.display    = isCsv ? '' : 'none';
        warmupRow.style.opacity = isCsv ? '1' : '0.4';
        warmupRow.title         = isCsv ? '' : 'Warmup bars are ignored for broker data sources';
    }
    src.addEventListener('change', toggle);
    toggle();
}());

@if (Model.Result?.EquityCurve?.Count > 0)
{
    var curve      = Model.Result.EquityCurve;
    var lastEquity = (double)curve[^1].Equity;
    <text>
(function () {
    const labels    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(curve.Select(p => p.Time.ToString("M/d"))));
    const values    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(curve.Select(p => (double)p.Equity)));
    const positive  = @(lastEquity >= 0 ? "true" : "false");
    const lineColor = positive ? '#00ff88' : '#ff4466';
    const fillColor = positive ? 'rgba(0,255,136,.07)' : 'rgba(255,68,102,.07)';
    new Chart(document.getElementById('equity-chart').getContext('2d'), {
        type: 'line',
        data: {
            labels,
            datasets: [
                { label: 'Equity', data: values, borderColor: lineColor, backgroundColor: fillColor,
                  borderWidth: 2, pointRadius: values.length <= 80 ? 3 : 0, pointHoverRadius: 5, fill: true, tension: 0.15 },
                { label: 'Zero',   data: new Array(values.length).fill(0),
                  borderColor: 'rgba(255,255,255,.18)', borderDash: [4,4], borderWidth: 1, pointRadius: 0, fill: false },
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: ctx => ctx.datasetIndex === 0
                    ? ' $' + ctx.parsed.y.toLocaleString('en-US', { maximumFractionDigits: 0 }) : null } }
            },
            scales: {
                x: { ticks: { maxTicksLimit: 14, color: '#666', font: { size: 11 } }, grid: { color: '#1a1d24' } },
                y: { ticks: { color: '#666', font: { size: 11 }, callback: v => '$' + v.toLocaleString() }, grid: { color: '#1a1d24' } },
            },
        },
    });
}());
    </text>
}

@if (Model.Result?.Trades?.Count > 0)
{
    <text>
    const _tradesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Result.Trades.OrderBy(t => t.EnteredAt).Select(t => new {
            setup = !string.IsNullOrEmpty(t.SetupLabel) ? t.SetupLabel : t.Setup.ToString(),
            isWin = t.IsWin,
            netPnl = t.NetPnl,
            commission = t.Commission,
            rMultiple = t.RMultiple,
            dir = t.EffectiveDirection.ToString(),
            exitReason = t.ExitReason.ToString()
        })
    ));
    const _origMetrics = document.querySelector('.row.g-2')?.innerHTML;

    function filterBySetup(selected) {
        const rows = document.querySelectorAll('.trade-table tbody tr');
        let n = 0, w = 0;
        rows.forEach(row => {
            const s = row.dataset.setup;
            if (!s) return;
            const show = !selected || s === selected;
            row.style.display = show ? '' : 'none';
            if (show) { n++; if (row.classList.contains('table-success')) w++; row.querySelector('td').textContent = n; }
        });
        document.querySelector('.trade-count').textContent = n + ' trades';
        document.querySelector('.trade-wl').textContent = w + ' W / ' + (n - w) + ' L';

        const grid = document.querySelector('.col-12.col-xl-8 .row.g-2');
        if (!grid) return;
        if (!selected) { grid.innerHTML = _origMetrics; return; }

        const f = _tradesData.filter(t => t.setup === selected);
        const wins = f.filter(t => t.isWin), losses = f.filter(t => !t.isWin);
        const net = f.reduce((s, t) => s + t.netPnl, 0);
        const wr = f.length ? (wins.length / f.length * 100) : 0;
        const avgW = wins.length ? wins.reduce((s, t) => s + t.netPnl, 0) / wins.length : 0;
        const avgL = losses.length ? losses.reduce((s, t) => s + t.netPnl, 0) / losses.length : 0;
        const avgR = f.length ? f.reduce((s, t) => s + t.rMultiple, 0) / f.length : 0;
        const grossW = wins.reduce((s, t) => s + t.netPnl, 0);
        const grossL = Math.abs(losses.reduce((s, t) => s + t.netPnl, 0));
        const pf = grossL > 0 ? (grossW / grossL).toFixed(2) : (net > 0 ? '∞' : '0.00');
        const comm = f.reduce((s, t) => s + t.commission, 0);
        const exp = f.length ? ((wins.length/f.length)*avgW + (losses.length/f.length)*avgL) : 0;
        const longs = f.filter(t => t.dir === 'Long').length, shorts = f.length - longs;
        const tgt = f.filter(t => t.exitReason === 'Target').length;
        const stp = f.filter(t => t.exitReason === 'Stop').length;
        const eod = f.filter(t => t.exitReason === 'SessionEnd').length;
        let peak = 0, eq = 0, maxDd = 0;
        f.forEach(t => { eq += t.netPnl; if (eq > peak) peak = eq; const dd = peak - eq; if (dd > maxDd) maxDd = dd; });
        let mW = 0, mL = 0, cW = 0, cL = 0;
        f.forEach(t => { if (t.isWin) { cW++; cL=0; mW=Math.max(mW,cW); } else { cL++; cW=0; mL=Math.max(mL,cL); } });
        const fmt = v => (v >= 0 ? '+$' : '-$') + Math.abs(Math.round(v)).toLocaleString();
        const cls = v => v > 0 ? 'pnl-pos' : v < 0 ? 'pnl-neg' : 'pnl-zero';
        const row = (l, v, c) => `<div class="d-flex justify-content-between border-bottom border-secondary py-1"><span class="text-muted small">${l}</span><span class="font-monospace small ${c||''}">${v}</span></div>`;
        grid.innerHTML = `<div class="col-12 col-md-4"><div class="settings-section h-100">
            <h6><i class="bi bi-bar-chart-fill me-1"></i>${selected}</h6>
            ${row('Trades', f.length, '')}
            ${row('Win Rate', wr.toFixed(1)+'%', wr>=50?'pnl-pos':'pnl-neg')}
            ${row('Net P&L', fmt(net), cls(net))}
            ${row('Profit Factor', pf, pf>=1.5?'pnl-pos':'')}
            ${row('Avg R', avgR.toFixed(2)+'R', cls(avgR))}
            ${row('Max DD', '-$'+Math.round(maxDd).toLocaleString(), 'pnl-neg')}
            ${row('Avg Win', '$'+Math.round(avgW).toLocaleString(), 'pnl-pos')}
            ${row('Avg Loss', '$'+Math.round(avgL).toLocaleString(), 'pnl-neg')}
            ${row('Expectancy', fmt(exp), cls(exp))}
            ${row('Consec W / L', mW+' / '+mL, '')}
            ${row('Long / Short', longs+' / '+shorts, '')}
            ${row('Tgt / Stp / EOD', tgt+' / '+stp+' / '+eod, '')}
            ${row('Commission', '-$'+Math.round(comm).toLocaleString(), 'pnl-neg')}
        </div></div>`;
    }
    </text>
}

function exportTradesCsv() {
    const table = document.querySelector('.trade-table');
    if (!table) return;
    const lines = [];
    table.querySelectorAll('tr').forEach(row => {
        const vals = Array.from(row.querySelectorAll('th, td')).map(c => {
            let t = c.innerText.replace(/"/g, '""').trim();
            return '"' + t + '"';
        });
        lines.push(vals.join(','));
    });
    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'backtest_trades.csv';
    a.click();
    URL.revokeObjectURL(url);
}
</script>
}

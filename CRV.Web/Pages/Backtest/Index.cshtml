@page
@model CRV.Web.Pages.Backtest.BacktestModel
@{
    ViewData["Title"] = "Backtest";
    ViewData["ActivePage"] = "Backtest";

    // Eastern Time — auto-detects EST vs EDT (handles DST)
    TimeZoneInfo etTz;
    try   { etTz = TimeZoneInfo.FindSystemTimeZoneById("America/New_York"); }
    catch { etTz = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time"); }
    string ToEt(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, etTz).ToString("M/d HH:mm");
    string EtLabel(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, etTz).IsDaylightSavingTime() ? "EDT" : "EST";
}

<div class="page-header">
    <h1 class="page-title">📊 Backtest</h1>
</div>

@if (TempData["bt_success"] is string successMsg)
{
    <div class="alert alert-success" role="alert">✅ @successMsg</div>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

@if (Model.Result != null)
{
    <!-- ── Results summary ──────────────────────────────────── -->
    var distinctTickers = Model.Result.Trades
        .Select(t => string.IsNullOrEmpty(t.Ticker) ? Model.Result.Config.Ticker : t.Ticker)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var tickerLabel = distinctTickers.Count > 1 ? "Multi Inst" : (distinctTickers.FirstOrDefault() ?? Model.Result.Config.Ticker);

    <div class="results-header">
        <div class="results-title">Results — @tickerLabel
            &nbsp;@Model.BtConfig.From.ToString("MMM d, yyyy") → @Model.BtConfig.To.ToString("MMM d, yyyy")
        </div>
    </div>

    <div class="metrics-grid">
        @{
            var perSetupEntries = Model.Result.PerSetup
                .Where(kv => kv.Value.TotalTrades > 0)
                .Select(kv => (kv.Key, kv.Value))
                .ToList();
        }
        @foreach (var (label, metrics) in new[] { ("Total", Model.Result.Total) }
            .Concat(perSetupEntries))
        {
            <div class="metrics-card @(label == "Total" ? "metrics-total" : "")">
                <div class="metrics-title">@label</div>
                <div class="m-row"><span>Trades</span><span>@metrics.TotalTrades</span></div>
                <div class="m-row"><span>Win %</span>
                    <span class="@(metrics.WinRate >= 50 ? "profit" : "loss")">@metrics.WinRate.ToString("F1")%</span></div>
                <div class="m-row"><span>Net P&L</span>
                    <span class="@(metrics.NetPnl >= 0 ? "profit" : "loss")">
                        @(metrics.NetPnl >= 0 ? "+" : "")@metrics.NetPnl.ToString("C0")</span></div>
        <div class="m-row"><span>Profit Factor</span>
            <span class="@(metrics.ProfitFactor >= 1.5m ? "profit" : "")">@(metrics.ProfitFactor == 0 && metrics.NetPnl > 0 ? "∞" : metrics.ProfitFactor.ToString("F2"))</span></div>
                <div class="m-row"><span>Avg R</span><span>@metrics.AvgR.ToString("F2")</span></div>
                <div class="m-row"><span>Max DD</span>
                    <span class="loss">-@metrics.MaxDrawdown.ToString("C0")</span></div>
                <div class="m-row"><span>Avg Win</span>
                    <span class="profit">@metrics.AvgWin.ToString("C0")</span></div>
                <div class="m-row"><span>Avg Loss</span>
                    <span class="loss">@metrics.AvgLoss.ToString("C0")</span></div>
                <div class="m-row"><span>Max Consec W</span><span>@metrics.MaxConsecWins</span></div>
                <div class="m-row"><span>Max Consec L</span><span class="loss">@metrics.MaxConsecLosses</span></div>
                <div class="m-row"><span>Commission</span><span>@metrics.TotalCommission.ToString("C0")</span></div>
                <div class="m-row"><span>Long / Short</span><span>@metrics.LongTrades / @metrics.ShortTrades</span></div>
                <div class="m-row"><span>Tgt / Stop / EOD</span>
                    <span>@metrics.TargetExits / @metrics.StopExits / @metrics.SessionEndExits</span></div>
            </div>
        }
    </div>

    <!-- ── Equity curve ────────────────────────────────────── -->
    <div class="chart-section">
        <div class="chart-title">Equity Curve</div>
        <canvas id="equity-chart" height="200"></canvas>
    </div>

    <!-- ── Trade table ─────────────────────────────────────── -->
    <div class="trade-table-section">
        <div class="trade-table-header" style="display:flex;align-items:center;gap:1rem;">
            <span>Trade Log</span>
            <span class="trade-count">@Model.Result.Trades.Count trades</span>
            <button type="button" class="btn btn-sm btn-outline-light ms-auto" onclick="exportTradesCsv()">⬇ Export CSV</button>
        </div>
        <div class="table-scroll">
            <table class="trade-table">
                <thead>
                    <tr>
                        <th>#</th><th>Date (@(Model.Result.Trades.Any() ? EtLabel(Model.Result.Trades[0].EnteredAt) : "ET"))</th><th>Setup</th><th>Instr</th><th>Dir</th>
                        <th>Entry</th><th>Exit</th><th>Stop</th><th>Target</th>
                        <th>Cts</th><th>Partial</th><th>Reason</th>
                        <th>Gross</th><th>Comm</th><th>Net</th><th>R</th>
                        <th>Duration</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 0; }
                    @foreach (var t in Model.Result.Trades.OrderBy(t => t.EnteredAt))
                    {
                        rowNum++;
                        <tr class="@(t.IsWin ? "win-row" : "loss-row")">
                            <td>@rowNum</td>
                            <td>@ToEt(t.EnteredAt)</td>
                            <td><span class="setup-badge">@(!string.IsNullOrEmpty(t.SetupLabel) ? t.SetupLabel : t.Setup.ToString())</span></td>
                            <td class="small">@(string.IsNullOrEmpty(t.Ticker) ? Model.Result.Config.Ticker : t.Ticker.TrimStart('/'))</td>
                            <td class="@(t.EffectiveDirection == CRV.Core.Models.Direction.Long ? "long-cell" : "short-cell")">
                                @t.EffectiveDirection</td>
                            <td>@t.Entry.ToString("F2")</td>
                            <td>@t.Exit.ToString("F2")</td>
                            <td>@t.InitialStop.ToString("F2")</td>
                            <td>@t.Target.ToString("F2")</td>
                            <td>@t.Contracts</td>
                            <td>@(t.PartialFilled ? "✓" : "—")</td>
                            <td><span class="reason-badge @t.ExitReason.ToString().ToLower()">@t.ExitReason</span></td>
                            <td class="@(t.GrossPnl >= 0 ? "profit" : "loss")">
                                @(t.GrossPnl >= 0 ? "+" : "")@t.GrossPnl.ToString("C0")</td>
                            <td class="loss">-@t.Commission.ToString("C0")</td>
                            <td class="@(t.NetPnl >= 0 ? "profit" : "loss") bold">
                                @(t.NetPnl >= 0 ? "+" : "")@t.NetPnl.ToString("C0")</td>
                            <td class="@(t.RMultiple >= 0 ? "profit" : "loss")">@t.RMultiple.ToString("F1")R</td>
                            <td>@t.Duration.ToString(@"hh\:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ── Settings form ────────────────────────────────────────── -->
<div class="settings-section @(Model.Result != null ? "collapsible" : "")">
    <div class="section-title @(Model.Result != null ? "collapsible-toggle" : "")"
         onclick="this.parentElement.classList.toggle('collapsed')">
        @(Model.Result != null ? "▶ Configure New Run" : "Configure Backtest")
    </div>
    <div class="section-body">
        <form method="post">
            <div class="settings-grid">

                <!-- Data source -->
                <div class="settings-section">
                    <div class="section-title">Data Source</div>
                    <div class="field-grid">
                        <div class="field">
                            <label asp-for="BtConfig.DataSource">Source</label>
                            <select asp-for="BtConfig.DataSource" class="input-select" onchange="toggleDataSource(this.value)">
                                <option value="CSV">CSV File</option>
                                <option value="Schwab">Schwab REST</option>
                                <option value="TradeStation">TradeStation REST</option>
                            </select>
                        </div>
                        <div class="field" id="csv-path-field">
                            <label asp-for="BtConfig.CsvPath">CSV File Path</label>
                            <input asp-for="BtConfig.CsvPath" class="input-text" placeholder="Data/NQ_1min.csv" />
                            <div class="field-hint">Server file path (not upload). Use `Data/NQ_1min.csv` or an absolute path. Columns: datetime,open,high,low,close,volume</div>
                        </div>
                        <div class="field">
                            <label asp-for="BtConfig.From">From</label>
                            <input asp-for="BtConfig.From" class="input-text" type="date" />
                        </div>
                        <div class="field">
                            <label asp-for="BtConfig.To">To</label>
                            <input asp-for="BtConfig.To" class="input-text" type="date" />
                        </div>
                    </div>
                </div>

                <!-- Simulation -->
                <div class="settings-section">
                    <div class="section-title">Simulation</div>
                    <div class="field-grid">
                        <div class="field">
                            <label asp-for="BtConfig.FillMode">Fill Mode</label>
                            <select asp-for="BtConfig.FillMode" class="input-select">
                                <option value="AtClose">At Close (conservative)</option>
                                <option value="AtTouch">At Touch (default)</option>
                                <option value="WithSlippage">With Slippage</option>
                            </select>
                        </div>
                        <div class="field">
                            <label asp-for="BtConfig.SlippageTicks">Slippage (ticks)</label>
                            <input asp-for="BtConfig.SlippageTicks" class="input-num" type="number" min="0" max="10" />
                        </div>
                        <div class="field">
                            <label asp-for="BtConfig.WarmupBars">Warmup Bars</label>
                            <select asp-for="BtConfig.WarmupBars" class="input-select">
                                <option value="0">0 — small dataset / large TF (15/30/60 min)</option>
                                <option value="14">14 — multi-day CSV (ATR warmup)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Strategy settings — same as Live (shared partial would be better but inline for clarity) -->
                <div class="settings-section">
                    <div class="section-title">Strategy (mirrors Live Settings)</div>
                    <div class="field-grid">
                        <div class="field">
                            <label asp-for="Config.Ticker">Default Ticker</label>
                            <input asp-for="Config.Ticker" class="input-text" />
                        </div>
                        <div class="field">
                            <label asp-for="Config.ExecutionTFMinutes">Execution TF (min)</label>
                            <select asp-for="Config.ExecutionTFMinutes" class="input-select">
                                <option value="1">1 min</option>
                                <option value="2">2 min</option>
                                <option value="5">5 min</option>
                                <option value="15">15 min</option>
                                <option value="30">30 min</option>
                                <option value="60">60 min</option>
                            </select>
                        </div>
                        <div class="field">
                            <label asp-for="Config.Contracts">Contracts</label>
                            <input asp-for="Config.Contracts" class="input-num" type="number" min="1" />
                        </div>
                        <div class="field">
                            <label asp-for="Config.CommissionPerSide">Commission / side ($)</label>
                            <input asp-for="Config.CommissionPerSide" class="input-num" type="number" step="0.01" />
                        </div>
                        <div class="field field-check">
                            <label><input asp-for="Config.EnableA" type="checkbox" /> Enable Setup A</label>
                            <label><input asp-for="Config.EnableB" type="checkbox" /> Enable Setup B</label>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" asp-for="Config.BasketJson" />
            <div class="settings-actions">
                <button type="submit" class="btn-primary btn-large">▶ Run Backtest</button>
                <a href="/Settings/Live" class="btn-outline">⚙ Full Settings</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
function toggleDataSource(val) {
    document.getElementById('csv-path-field').style.display =
        val === 'CSV' ? 'block' : 'none';
}

function exportTradesCsv() {
    const table = document.querySelector('.trade-table');
    if (!table) return;
    const rows = table.querySelectorAll('tr');
    const lines = [];
    rows.forEach(row => {
        const cells = row.querySelectorAll('th, td');
        const vals = Array.from(cells).map(c => {
            let t = c.innerText.replace(/"/g, '""').trim();
            return '"' + t + '"';
        });
        lines.push(vals.join(','));
    });
    const csv = lines.join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'backtest_trades.csv';
    a.click();
    URL.revokeObjectURL(url);
}

@if (Model.Result?.EquityCurve?.Count > 0)
{
    <text>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Result.EquityCurve.Select(p => p.Time.ToString("M/d"))));
    const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Result.EquityCurve.Select(p => (double)p.Equity)));

    const ctx = document.getElementById('equity-chart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Equity',
                data: values,
                borderColor: values[values.length-1] >= 0 ? '#22c55e' : '#ef4444',
                backgroundColor: 'transparent',
                borderWidth: 2,
                pointRadius: 0,
                tension: 0.2
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { maxTicksLimit: 12, color: '#9ca3af' }, grid: { color: '#1f2937' } },
                y: { ticks: { color: '#9ca3af',
                              callback: v => '$' + v.toLocaleString() },
                     grid: { color: '#1f2937' } }
            }
        }
    });
    </text>
}
</script>
}

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>crv-trading-web</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CRV.Core\CRV.Core.csproj" />
    <ProjectReference Include="..\CRV.Live\CRV.Live.csproj" />
    <ProjectReference Include="..\CRV.Backtest\CRV.Backtest.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Data\" />
  </ItemGroup>
  <!-- The Web SDK globs content out of the project directory. Anything the app writes
       beside its own output (token files, appsettings copies) was being picked up and
       copied back into bin, producing bin/Debug/net10.0/bin/Debug/net10.0/... nesting
       that eventually exceeded the OS path limit and broke the build. -->
  <ItemGroup>
    <Content Remove="bin/**" />
    <None    Remove="bin/**" />
    <Content Remove="obj/**" />
    <None    Remove="obj/**" />
  </ItemGroup>
</Project>
